<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
	Simulator builds only (CODE_SIGN_ENTITLEMENTS[sdk=iphonesimulator*]): Entitlements-Main plus the
	CarPlay audio entitlement, so the app shows up on the Simulator's CarPlay screen. Device builds keep
	using Entitlements-Main, because no provisioning profile can carry carplay-audio until Apple grants
	it to the App ID (developer.apple.com/contact/carplay). Once granted, move the key into
	Entitlements-Main and delete this file and the [sdk=iphonesimulator*] setting.
	Keep the other keys identical to Entitlements-Main.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.carplay-audio</key>
	<true/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.Elmallah.IslamicPillars</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.siri</key>
	<true/>
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.IslamicPillars.AppGroup</string>
	</array>
</dict>
</plist>
