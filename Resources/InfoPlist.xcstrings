    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Watch"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy: Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم تطبيق الإسلام موقعك لحساب مواقيت الصلاة واتجاه القبلة. لا يراه إلا تطبيق الإسلام وApple، ولا يُشارَك مع أي أحد آخر."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Al-Islam uses your location to calculate your prayer times and Qibla direction. Only Al-Islam and Apple ever see it, and it is never shared with anyone else."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al-Islam menggunakan lokasi Anda untuk menghitung waktu salat dan arah kiblat. Hanya Al-Islam dan Apple yang dapat melihatnya, dan lokasi Anda tidak pernah dibagikan kepada siapa pun."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al-Islam menggunakan lokasi anda untuk mengira waktu solat dan arah kiblat. Hanya Al-Islam dan Apple yang dapat melihatnya, dan lokasi anda tidak akan dikongsi dengan sesiapa pun."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al-Islam, namaz vakitlerinizi ve kıble yönünü hesaplamak için konumunuzu kullanır. Konumunuzu yalnızca Al-Islam ve Apple görür; başka hiç kimseyle paylaşılmaz."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاسلام ایپ نماز کے اوقات اور قبلہ کی سمت معلوم کرنے کے لیے آپ کا مقام استعمال کرتی ہے۔ اسے صرف الاسلام ایپ اور Apple دیکھتے ہیں، اور یہ کبھی کسی اور کے ساتھ شیئر نہیں کیا جاتا۔"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al-Islam utilise votre position pour calculer vos heures de prière et la direction de la qibla. Seuls Al-Islam et Apple y ont accès, et elle n’est jamais partagée avec qui que ce soit d’autre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al-Islam использует вашу геопозицию, чтобы рассчитать время намаза и направление киблы. Ее видят только Al-Islam и Apple, и она никогда не передается никому другому."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নামাজের সময় ও কিবলার দিক নির্ণয় করতে Al-Islam আপনার লোকেশন ব্যবহার করে। এটি শুধু Al-Islam ও Apple দেখতে পায়, এবং অন্য কারও সাথে কখনো শেয়ার করা হয় না।"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al-Islam आपकी लोकेशन का इस्तेमाल आपकी नमाज़ के समय और क़िबला की दिशा पता करने के लिए करता है। इसे सिर्फ़ Al-Islam और Apple देखते हैं, और यह कभी किसी और के साथ शेयर नहीं की जाती।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al-Islam verwendet deinen Standort, um deine Gebetszeiten und die Qibla-Richtung zu berechnen. Nur Al-Islam und Apple sehen ihn, und er wird niemals mit anderen geteilt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al-Islam usa tu ubicación para calcular tus horas de oración y la dirección de la qibla. Solo Al-Islam y Apple la ven, y nunca se comparte con nadie más."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ നിസ്കാര സമയങ്ങളും ഖിബ്ലയുടെ ദിശയും കണക്കാക്കാൻ Al-Islam നിങ്ങളുടെ ലൊക്കേഷൻ ഉപയോഗിക്കുന്നു. Al-Islam, Apple എന്നിവയ്ക്ക് മാത്രമേ ഇത് കാണാനാകൂ; ഇത് മറ്റാരുമായും ഒരിക്കലും പങ്കിടില്ല."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் தொழுகை நேரங்களையும் கிப்லா திசையையும் கணக்கிட Al-Islam உங்கள் இருப்பிடத்தைப் பயன்படுத்துகிறது. Al-Islam, Apple ஆகியவை மட்டுமே அதைப் பார்க்கும்; அது வேறு யாருடனும் ஒருபோதும் பகிரப்படாது."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al-Islam gebruikt je locatie om je gebedstijden en de qibla-richting te berekenen. Alleen Al-Islam en Apple krijgen je locatie te zien, en die wordt nooit met anderen gedeeld."
          }
        }
      }
    },
