{
  "sourceLanguage" : "en",
  "strings" : {
    "CFBundleDisplayName" : {
      "comment" : "Bundle display name: the name under the icon",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإسلام"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Al-Islam"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاسلام"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy: Location Always and When In Use Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم تطبيق الإسلام موقعك لحساب مواقيت الصلاة واتجاه القبلة. لا يراه إلا تطبيق الإسلام وApple، ولا يُشارَك مع أي أحد آخر."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Al-Islam uses your location to calculate your prayer times and Qibla direction. Only Al-Islam and Apple ever see it, and it is never shared with anyone else."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاسلام ایپ نماز کے اوقات اور قبلہ کی سمت معلوم کرنے کے لیے آپ کا مقام استعمال کرتی ہے۔ اسے صرف الاسلام ایپ اور Apple دیکھتے ہیں، اور یہ کبھی کسی اور کے ساتھ شیئر نہیں کیا جاتا۔"
          }
        }
      }
    },
