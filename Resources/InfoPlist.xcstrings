    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "Privacy: Photo Library Additions Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لحفظ الخلفيات التي تختارها في مكتبة الصور."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Used to save wallpapers you choose to your Photo Library."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan untuk menyimpan wallpaper pilihan Anda ke Perpustakaan Foto."
