          "stringUnit" : {
            "state" : "translated",
            "value" : "أطبق جسم اللسان على الحنك الأعلى ثم افصل بطرفه."
          }
        }
      }
    },
    "Press the side of the tongue against the upper molars and let the sound run along that side before releasing it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألصِق حافة اللسان بالأضراس العليا، ودع الصوت يجري في تلك الحافة قبل أن تطلقه."
          }
        }
      }
    },
    "Press the tongue tip to the gum ridge and let it strike once." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط طرف اللسان على اللثة ودعه يضرب ضربة واحدة."
          }
        }
      }
    },
    "Pressed to the gum ridge, as for a clear noon" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملتصقًا باللثة كما في النون الظاهرة"
          }
        }
      }
    },
    "Pressure" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الضغط"
          }
        }
      }
    },
    "Preventing Misunderstandings: By applying Tajweed rules, you avoid mistakes that may alter the meaning of verses. In some cases, even changing a single sound or stretching a vowel can result in an entirely different meaning." : {},
