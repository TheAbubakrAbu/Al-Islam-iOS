    },
    "Make dhikr a daily rhythm: morning, evening, after salah, before sleep, and during ordinary moments. A heart that remembers Allah does not stay empty." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجعل الذكر وِردًا يوميًا: في الصباح والمساء، وبعد الصلاة، وقبل النوم، وفي لحظاتك العادية. فالقلب الذي يذكر الله لا يبقى فارغًا."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ذکر کو اپنا روزانہ کا معمول بنائیں: صبح، شام، نماز کے بعد، سونے سے پہلے، اور عام لمحات میں بھی۔ جو دل اللہ کو یاد کرتا ہے وہ خالی نہیں رہتا۔"
          }
        }
      }
    },
    "Make the ك lighter" : {
      "extractionState" : "manual",
