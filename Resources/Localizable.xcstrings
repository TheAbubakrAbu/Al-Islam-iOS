    "Ruways is a nickname; his given name was Muhammad ibn al-Mutawakkil." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رويس لقب، واسمه محمد بن المتوكل."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رویس لقب ہے؛ ان کا اصل نام محمد بن المتوکل تھا۔"
          }
        }
      }
    },
    "Ruways read directly on Ya'qub al-Hadrami and was regarded as the most accomplished of his students. He taught in Basra and his narration travelled from there." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قرأ رويس على يعقوب الحضرمي مباشرة، وكان يُعدّ أحذق تلاميذه. وأقرأ في البصرة، ومنها انتشرت روايته."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رویس نے یعقوب حضرمی سے براہِ راست قراءت پڑھی اور انہیں ان کے شاگردوں میں سب سے ماہر سمجھا جاتا تھا۔ انہوں نے بصرہ میں قراءت سکھائی اور وہیں سے ان کی روایت پھیلی۔"
          }
        }
      }
    },
    "Ruways; Rawh counts 6206" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رويس؛ وعددها عند روح ٦٢٠٦"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رویس؛ روح کے شمار میں 6206"
          }
        }
      }
    },
