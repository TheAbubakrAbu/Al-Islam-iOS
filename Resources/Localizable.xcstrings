          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب نون کی آواز (ن یا تنوین) پُر حروف سے پہلے آئے: ص، ض، ط، ظ، ق"
          }
        }
      }
    },
    "When a noon sound (ن or tanween) comes before lighter letters: ت، ث، ج، د، ذ، ز، س، ش، ف، ك" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
