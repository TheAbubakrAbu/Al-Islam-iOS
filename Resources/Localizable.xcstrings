      }
    },
    "Waiting until your tajweed is good before reciting to anyone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أن تنتظر حتى يحسن تجويدك قبل أن تقرأ على أحد."
