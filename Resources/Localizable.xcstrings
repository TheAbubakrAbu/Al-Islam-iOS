        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اوپر کے متن کا کوئی بھی حصہ منتخب کرنے کے لیے اسے دبا کر گھسیٹیں، پھر کاپی کریں۔ ہر حصے کا بٹن وہ پورا حصہ کاپی کرتا ہے۔"
          }
        }
      }
    },
