        }
      }
    },
    "Whenever you see مّ, it must be pronounced with a strong ghunnah for two counts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فحيثما رأيت مّ فانطقها بغنّة قويّة بمقدار حركتين."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جہاں بھی مّ آئے، اسے دو حرکات کی قوی غنّہ کے ساتھ پڑھیں۔"
          }
        }
      }
    },
    "Where" : {
      "extractionState" : "manual",
      "localizations" : {
