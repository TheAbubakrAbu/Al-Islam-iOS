        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ درجہ ہمیشہ مصحف کی اپنی علامات دکھاتا ہے: اس کا سکون خا کا چھوٹا سر ہے، تاکہ دائرے کا مطلب «پڑھا نہیں جاتا» ہو سکے۔"
