    },
    "%@ is %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ اسمه %@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ کا نام %@ ہے۔"
          }
        }
      }
    },
    "%@ is always pronounced as a heavy letter, in every position. It is one of the letters of isti'la (elevation)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنطق حرف %@ مفخّمًا دائمًا، في كل موضع. وهو من حروف الاستعلاء."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ہر جگہ ہمیشہ پُر ادا ہوتا ہے۔ یہ حروفِ استعلاء (بلندی) میں سے ہے۔"
          }
        }
      }
    },
    "%@ is always pronounced as a light letter, in every position." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُنطق حرف %@ مرقّقًا دائمًا، في كل موضع."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ہر جگہ ہمیشہ باریک ادا ہوتا ہے۔"
          }
        }
      }
    },
    "%@ is at %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ الساعة %@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ کا وقت %@ ہے۔"
          }
        }
      }
    },
    "%@ is one of the five qalqalah letters (قُطۡبُ جَدٍّ: ق ط ب ج د). When it carries a sukoon, or you stop on it, it is pronounced with a short, crisp bounce: a quick echo of the letter, never a flat stop. The Quran reader colors it this way when tajweed colors are on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرف %@ أحد حروف القلقلة الخمسة (قُطۡبُ جَدٍّ: ق ط ب ج د). فإذا سكن أو وقفت عليه نُطق بقلقلة قصيرة واضحة: نبرة سريعة للحرف، لا وقفة جامدة. وتلوّنه شاشة قراءة القرآن بهذا اللون حين تكون ألوان التجويد مفعّلة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ قلقلہ کے پانچ حروف (قُطۡبُ جَدٍّ: ق ط ب ج د) میں سے ایک ہے۔ جب یہ ساکن ہو، یا آپ اس پر وقف کریں، تو اسے مختصر اور واضح قلقلہ کے ساتھ ادا کیا جاتا ہے: حرف کی ایک تیز گونج، بے جان ٹھہراؤ نہیں۔ تجوید کے رنگ آن ہوں تو قرآن پڑھنے کی اسکرین اسے اسی رنگ میں دکھاتی ہے۔"
          }
        }
      }
    },
    "%@ is today: %@." : {
      "localizations" : {
