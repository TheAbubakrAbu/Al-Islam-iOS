    "• Counts: '286 ayahs' or '48 pages'" : {},
    "• From the end with '-': '-1' is the last surah, page, and juz 30" : {},
    "• Go to: page 5, juz 30, hizb 5, ruku 12, or -1 for the last" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• الانتقال: إلى صفحة أو جزء أو حزب أو ركوع برقمه، و-١ للأخير"
          }
        }
      }
    },
    "• Must be at least 48 miles (≈ 77 km) from home to be considered traveling" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• يجب أن تبعد ٤٨ ميلًا على الأقل (≈ ٧٧ كم) عن المنزل ليُعدّ ذلك سفرًا"
          }
        }
      }
    },
