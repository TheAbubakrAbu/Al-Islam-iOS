    "Lam meeting alif fuses into one shape. Noorania gives it its own line in the table." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللام إذا لقيت الألف اندمجتا في صورة واحدة. وقد أفردت لها النورانية سطرًا في الجدول."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
