            "value" : "مدِ عارض 2، 4 یا 6 حرکات ہے۔ ایک چن لیں اور اسی پر قائم رہیں۔"
          }
        }
      }
    },
    "Madd at word end before next hamzah." : {
      "localizations" : {
        "ar" : {
