    "Shapes only the Arabic text below; the reading view keeps its own settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يغيّر هذا شكل النص العربي أدناه فقط؛ ويحتفظ عرض القراءة بإعداداته."
