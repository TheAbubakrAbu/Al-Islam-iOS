    },
    "This backup was made by a newer version of %@. Update the app, then restore." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُنشئت هذه النسخة الاحتياطية بإصدار أحدث من تطبيق %@. حدّث التطبيق ثم استعِدها."
