          "stringUnit" : {
            "state" : "translated",
            "value" : "سب بجھائیں"
          }
        }
      }
    },
    "Put it in sukoon after a vowelled hamza and hear where the sound stops" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسكّنه بعد همزة محركة وتسمع أين ينقطع الصوت"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متحرک ہمزہ کے بعد اسے ساکن کریں اور سنیں کہ آواز کہاں رکتی ہے"
          }
        }
      }
    },
    "Put out %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إطفاء %@"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ بجھائیں"
          }
        }
      }
    },
    "Put the edge of the tongue against the upper molars and let the sound run forward along it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع حافة اللسان على الأضراس العليا ودع الصوت يجري عليها إلى الأمام."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حافّۂ لسان کو اوپر کی داڑھوں سے لگائیں اور آواز کو اس پر آگے کی طرف چلنے دیں۔"
          }
        }
      }
    },
    "Put the side of the tongue against the upper molars and let the sound run along it before releasing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع حافة اللسان على ما يحاذيها من الأضراس العليا وأجرِ الصوت عليها قبل أن تطلقه."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زبان کے کنارے کو اوپر کی داڑھوں پر رکھیں اور چھوڑنے سے پہلے آواز کو اسی کنارے پر چلنے دیں۔"
          }
        }
      }
    },
    "Put the tongue in the right place, lightly. Accuracy matters more than force." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع اللسان في موضعه برفق. فالدقة أهمّ من القوة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زبان کو نرمی سے صحیح جگہ پر رکھیں۔ زور سے زیادہ درستی اہم ہے۔"
          }
        }
      }
    },
    "Put the weather on the sky" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف الطقس إلى السماء"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آسمان پر موسم دکھائیں"
          }
        }
      }
    },
    "Puts a space between each Arabic letter to make it easier for beginners to read the Quran." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضع مسافة بين كل حرف عربي وآخر ليسهّل على المبتدئين قراءة القرآن."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر عربی حرف کے درمیان فاصلہ ڈالتا ہے تاکہ مبتدیوں کے لیے قرآن پڑھنا آسان ہو۔"
          }
        }
      }
    },
    "Puts a space between every Arabic letter." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضع مسافة بين الحروف العربية."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر عربی حرف کے درمیان فاصلہ ڈالتا ہے۔"
          }
        }
      }
    },
    "Pyramids" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأهرامات"
          }
        },
        "ur" : {
