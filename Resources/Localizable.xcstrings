    "Jarr (majruur): kasra, after a preposition or in idafah. \"In the house.\"" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجر (مجرور): الكسرة، بعد حرف الجر أو في الإضافة. «في البيتِ»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جر (مجرور): زیر، حرفِ جر کے بعد یا اضافت میں۔ «گھر میں»۔"
          }
        }
      }
    },
    "Jaw drops, mouth opens" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
