        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ف سے پہلے والا نون چھپا ہوا ہے: آپ کو نون نہیں، غنّہ سنائی دیتی ہے۔"
          }
        }
      }
    },
    "The noon before ي is fully audible. No shadda on the ي." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
