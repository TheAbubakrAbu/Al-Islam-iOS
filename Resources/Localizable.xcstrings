    "Running out of breath mid-phrase and resuming on the very next word." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أن ينقطع نفَسك في وسط العبارة فتستأنف بالكلمة التي تليها مباشرةً."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عبارت کے بیچ میں سانس ختم ہو جائے اور بالکل اگلے کلمے سے دوبارہ پڑھنا شروع کر دینا۔"
          }
        }
      }
    },
    "Runs across both halves, two counts" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجري على الشطرين، مقدارها حركتان"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دونوں شطروں پر جاری رہتی ہے، 2 حرکات"
          }
        }
      }
    },
    "Rushing the kasra until it flattens into a neutral 'uh'." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإسراع بالكسرة حتى تنبسط فتصير صوتًا مبهمًا."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کسرہ کو اتنی جلدی پڑھنا کہ وہ بیٹھ کر ایک مبہم آواز بن جائے۔"
          }
        }
      }
    },
