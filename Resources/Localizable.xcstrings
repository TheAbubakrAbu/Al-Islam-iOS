          "stringUnit" : {
            "state" : "translated",
            "value" : "تعيد «أسماء مخصّصة للصلوات» تسمية أي صلاة في كل مكان دفعة واحدة: التطبيق، وإشعاراته، والأدوات، وApple Watch."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«نمازوں کے حسبِ منشا نام» کسی بھی نماز کا نام ہر جگہ ایک ساتھ بدل دیتا ہے: ایپ، اس کی اطلاعات، ویجیٹس اور Apple Watch۔"
          }
        }
      }
    },
    "Custom Range" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نطاق مخصّص"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حسبِ منشا حصہ"
          }
        }
