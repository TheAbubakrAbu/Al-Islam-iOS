    },
    "A note, a khutbah, a class, an ayah you sat with" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملاحظة، أو خطبة، أو درس، أو آية تأمّلتها"
