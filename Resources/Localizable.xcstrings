    },
    "Enter a price" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل السعر"
          }
        }
      }
    },
    "Enter it" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إدخال يدوي"
          }
        }
      }
    },
    "Enter the threshold directly if you already know it in your currency. Leave it empty to skip the check and just see the fortieth." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل النصاب مباشرة إن كنت تعرفه بعملتك. واتركه فارغًا لتتخطى المقارنة وترى ربع العشر فقط."
          }
        }
      }
    },
    "Enter the threshold directly, or leave it empty to skip the check." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل النصاب مباشرة، أو اتركه فارغًا لتتخطى المقارنة."
          }
        }
      }
    },
    "Enter what you own and what you owe. The calculator weighs it against the nisab and works out what is due, with zakat al-fitr beside it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل ما تملكه وما عليك من ديون. تقارن الحاسبة ذلك بالنصاب وتحسب الواجب، وإلى جانبه زكاة الفطر."
          }
        }
      }
    },
    "Enter what you own below and this updates as you type." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل ما تملكه أدناه، وتتحدّث النتيجة أثناء الكتابة."
          }
        }
      }
    },
    "Entering, leaving, and honoring the masjid." : {
      "extractionState" : "manual",
