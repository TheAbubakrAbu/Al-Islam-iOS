    "%lld things that are easy to miss, each with where to find it. Every settings page opens with its own list, and this short tour shows what only %@ does." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld من الأمور التي قد تفوتك، ولكلٍّ منها مكان العثور عليه. تبدأ كل صفحة إعدادات بقائمتها الخاصة، وتعرض هذه الجولة القصيرة ما يتفرّد به %@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld ایسی چیزیں جو آسانی سے نظر سے رہ جاتی ہیں، ہر ایک کے ساتھ یہ کہ وہ کہاں ملے گی۔ ترتیبات کا ہر صفحہ اپنی فہرست سے شروع ہوتا ہے، اور یہ مختصر تعارف دکھاتا ہے کہ صرف %@ ایپ کیا کرتی ہے۔"
          }
        }
      }
    },
