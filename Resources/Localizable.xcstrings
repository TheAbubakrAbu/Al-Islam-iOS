    "Madd Munfasil" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المد المنفصل"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدِ منفصل"
          }
        }
      }
    },
    "Madd Munfasil (مَدّ مُنفَصِل) means \"separated Madd.\" Munfasil means separated because the Madd letter comes at the end of one word and the next word begins with hamzah, so it may be read 2, 4, or 5 counts depending on the recitation style." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المد المنفصل (مَدّ مُنفَصِل): سُمّي منفصلًا لأن حرف المد يقع في آخر كلمة وتبدأ الكلمة التي بعدها بهمزة، فيجوز أن يُقرأ بمقدار حركتين أو أربع أو خمس بحسب طريقة القراءة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدِ منفصل (مَدّ مُنفَصِل) کا مطلب ہے «جدا مد»۔ اسے منفصل یعنی جدا اس لیے کہتے ہیں کہ حرفِ مد ایک لفظ کے آخر میں آتا ہے اور اگلا لفظ ہمزہ سے شروع ہوتا ہے، اس لیے تلاوت کے انداز کے مطابق اسے 2، 4 یا 5 حرکات تک پڑھا جا سکتا ہے۔"
          }
        }
      }
    },
    "Madd Munfasil Hukmi" : {
      "localizations" : {
