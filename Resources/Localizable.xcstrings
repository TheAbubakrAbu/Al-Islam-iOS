          "stringUnit" : {
            "state" : "translated",
            "value" : "«هل تحتاج إلى مساعدة؟» في تبويب الإسلام"
          }
        }
      }
    },
    "Need a Hand? on the Quran Tab" : {
      "localizations" : {
