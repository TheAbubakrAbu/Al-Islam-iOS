    "Edge at the molars, tip at the teeth edges, tip at the gum. Three exits that beginners collapse into one." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحافة عند الأضراس، والطرف عند أطراف الثنايا، والطرف عند اللثة. ثلاثة مخارج يجمعها المبتدئون في مخرج واحد."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کنارہ ڈاڑھوں پر، نوک دانتوں کے کناروں پر، نوک مسوڑھے پر۔ تین مخارج جنہیں ابتدائی طالبِ علم ایک ہی بنا دیتے ہیں۔"
