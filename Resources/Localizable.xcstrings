        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زبر کے بعد ا، پیش کے بعد و، زیر کے بعد ي، اس طرح کہ حرفِ مد خود ساکن ہو، اس پر کوئی حرکت نہ ہو، اور اس کے بعد کوئی سبب نہ آئے"
          }
        }
