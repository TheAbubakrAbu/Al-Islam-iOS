    "Disturbing the articulation point at the moment a qalqalah letter carrying sukoon is released, so that a sharp echo is heard after it, without any vowel." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضطراب المخرج عند إطلاق حرف من حروف القلقلة وهو ساكن، حتى تُسمع له نبرة قوية بعده من غير أن تصحبها حركة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرفِ قلقلہ ساکن ہو تو اسے چھوڑتے وقت مخرج میں اضطراب پیدا کرنا، یہاں تک کہ اس کے بعد ایک زوردار جھٹکا سنائی دے، اور اس کے ساتھ کوئی حرکت نہ ہو۔"
          }
        }
      }
    },
