    "This form: %lld times" : {
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "هذه الصيغة: مرة واحدة"
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "هذه الصيغة: مرتان"
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "هذه الصيغة: %lld مرات"
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "هذه الصيغة: %lld مرةً"
                }
              },
