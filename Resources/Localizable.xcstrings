    "Midnight is not a prayer, but marks the end of Isha" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منتصف الليل ليس صلاة، لكنه يحدد نهاية وقت العشاء"
          }
        },
        "ur" : {
