          }
        }
      }
    },
    "Which ف is correct?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أي هذه الأوجه هو الفاء الصحيحة؟"
          }
        },
        "ur" : {
          "stringUnit" : {
