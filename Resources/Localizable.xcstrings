    "Humility" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التواضع"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عاجزی"
          }
        }
      }
    },
    "Humming everything is the flattening habit the ranks lesson exists to break, and it usually starts here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعميم الغنّة هو العادة التي تُسوّي الأداء وتذهب بتفاوته، وهي التي وُضع لها درس المراتب، وغالبًا ما تبدأ من هنا."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر جگہ غنّہ لگانا وہی عادت ہے جو ادا کو ہموار کر کے اس کا فرق مٹا دیتی ہے، اور مراتبِ غنّہ کا سبق اسی کو توڑنے کے لیے ہے۔ عام طور پر یہ عادت یہیں سے شروع ہوتی ہے۔"
          }
        }
      }
    },
    "Humming identically before every one of the fifteen letters." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إجراء غنة واحدة قبل كل حرف من الأحرف الخمسة عشر."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پندرہ حروف میں سے ہر ایک سے پہلے ایک ہی جیسی غنّہ کرنا۔"
          }
        }
      }
    },
    "Humming on every doubled letter, so رَبِّ comes out nasal." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التغنين في كل حرف مشدد، فتخرج رَبِّ بغنة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر مشدّد حرف پر غنّہ کرنا، جس سے رَبِّ ناک سے نکلنے لگتا ہے۔"
          }
        }
      }
    },
    "Humming the familiar words like إِنَّ and ثُمَّ but missing the shaddah inside a long one such as لَتُسۡـَٔلُنَّ." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أن تُغِنَّ الكلمات المألوفة مثل إِنَّ وثُمَّ وتغفل عن الشدّة داخل كلمة طويلة مثل لَتُسۡـَٔلُنَّ."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إِنَّ اور ثُمَّ جیسے مانوس کلمات میں تو غنّہ کرنا، مگر لَتُسۡـَٔلُنَّ جیسے لمبے کلمے کے اندر تشدید سے غافل رہ جانا۔"
          }
        }
      }
    },
