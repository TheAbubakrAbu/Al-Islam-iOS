    "Amiri font (frame labels of the Hafs printed mushaf)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خط أميري (عناوين إطار مصحف حفص المطبوع)"
          }
        },
        "ur" : {
          "stringUnit" : {
