          }
        }
      }
    },
    "Producing heaviness by lowering the voice into the chest." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحصيل الثقل بخفض الصوت إلى الصدر."
          }
        }
      }
    },
    "Producing tafkheem by pushing the voice down into the chest." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحصيل التفخيم بخفض الصوت إلى الصدر."
          }
        }
      }
    },
    "Producing the ghunnah in the mouth: a nasal-sounding vowel rather than a nasal hum." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إخراج الغنة من الفم: حركة ذات رنين أنفي لا رنينا أنفيا."
          }
        }
      }
    },
    "Producing the hum in the throat, so it comes out as a growl instead of a nasal ring." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إخراج الغنّة من الحلق، فتخرج زمجرةً بدل الرنين الأنفيّ."
          }
        }
      }
    },
    "Profile" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملف الشخصي"
          }
        }
