        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسقطها. فالحرف الأخير يسكَّن في الوقف."
          }
        }
      }
    },
    "Drop the n-sound entirely and read the tanween's alif as an ordinary alif." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احذف صوت النون بالكلّية، واقرأ ألف التنوين ألفًا عادية."
          }
        }
      }
    },
    "Drop the noon entirely and double the ل or ر." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسقط النون بالكلية وشدد اللام أو الراء."
          }
        }
      }
    },
    "Drop the noon into the next letter" : {
      "extractionState" : "manual",
