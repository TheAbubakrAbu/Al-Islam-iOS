    "Pronounce the word as if it begins with the doubled letter" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انطق الكلمة كأنها تبدأ بالحرف المشدّد"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلمے کو یوں پڑھیں گویا اس کا آغاز مشدّد حرف سے ہو رہا ہے"
          }
        }
      }
    },
    "Pronouncing a faint noon before the doubled letter." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نطق نون خفيفة قبل الحرف المشدد."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشدّد حرف سے پہلے ہلکا سا نون پڑھ دینا۔"
          }
        }
      }
    },
    "Pronouncing a letter that carries the round zero, like the alif closing قَالُواْ." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النطق بحرف عليه الصفر المستدير، كالألف في آخر قَالُواْ."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گول صفر والے حرف کو پڑھنا، جیسے قَالُواْ کے آخر کا الف۔"
          }
        }
      }
    },
    "Pronouncing al-" : {
      "localizations" : {
