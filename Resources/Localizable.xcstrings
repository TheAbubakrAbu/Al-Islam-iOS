          }
        }
      }
    },
    "Unquestionably, by the remembrance of Allah hearts are assured." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "﴿أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ﴾"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سن لو! اللہ کے ذکر ہی سے دلوں کو اطمینان ملتا ہے۔"
          }
        }
      }
    },
    "Unquestionably, by the remembrance of Allah hearts are assured. (Quran 13:28)" : {
