    },
    "Lips" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشفتان"
          }
        }
      }
    },
    "Lips close once. The hum belongs to the doubled م." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنطبق الشفتان مرة واحدة. والغنّة للميم المشدّدة."
          }
        }
      }
    },
    "Lips from the front" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشفتان من الأمام"
          }
        }
      }
    },
    "Lips meet, no pressure, 2-count hum" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلتقي الشفتان من غير ضغط، وغنّة مقدار حركتين"
          }
        }
      }
    },
    "Lips move up and down only" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حركة الشفتين إلى أعلى وإلى أسفل فقط"
          }
        }
      }
    },
    "Lips move up and down, never stretched sideways. The tongue and throat do most of the work." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتحرّك الشفتان صعودًا ونزولًا، ولا تُمطّان إلى الجانبين أبدًا. وأكثر العمل على اللسان والحلق."
          }
        }
      }
    },
    "Lips rounded and pushed forward" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستدير الشفتان وتُدفعان إلى الأمام"
          }
        }
      }
    },
    "Lips sealed on the ب, then popped apart, with the ل following immediately." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُطبق الشفتان على الباء ثم تنفرجان، واللام تتبعها من غير فاصل."
          }
        }
      }
    },
    "Lisan, the tongue" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللسان"
          }
        }
      }
    },
    "List" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قائمة"
          }
        }
      }
    },
    "List opens a chapter as a scrolling list of hadiths. Pages opens it as a right-to-left paged reader, fitting as many hadiths per page as your font sizes allow." : {},
    "List or pages, dividers, the Quran tab" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قائمة أو صفحات، الفواصل، تبويب القرآن"
          }
        }
      }
    },
    "List reader" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القراءة بوضع القائمة"
          }
        }
      }
    },
    "List shows a surah as a scrolling list of ayahs. Pages shows it as a mushaf, one page at a time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«القائمة» تعرض السورة قائمةً متتابعة من الآيات. و«الصفحات» تعرضها مصحفًا، صفحةً صفحة."
          }
        }
      }
    },
    "List style, Liquid Glass, haptics" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نمط القائمة، الزجاج السائل، الاستجابة اللمسية"
          }
        }
      }
    },
    "Listen" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استماع"
          }
        }
      }
    },
    "Listen -> imitate -> repeat aloud. Silent learning does not work for makharij." : {},
    "Listen All" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاستماع إلى الكل"
          }
        }
      }
    },
    "Listen actively: follow in the mushaf, recite along, and imitate what you hear." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع استماعًا فاعلًا: تابع في المصحف، واقرأ مع القارئ، وحاكِ ما تسمع."
          }
        }
      }
    },
    "Listen and Pick" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع واختر"
          }
        }
      }
    },
    "Listen at" : {},
    "Listen first, then follow. The Quran itself was taught by being recited and then followed." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع أولًا ثم اتّبع. فالقرآن نفسه عُلِّم بأن يُقرأ ثم يُتَّبع."
          }
        }
      }
    },
    "Listen for" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتبه إلى"
          }
        }
      }
    },
    "Listen to a pair back to back, then say it yourself. Alternating the two is what trains the difference: drilling one letter alone only repeats what you already do." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع إلى الحرفين متتاليين، ثم انطقهما بنفسك. فالتناوب بينهما هو ما يدرّبك على الفرق، أما تكرار حرف واحد وحده فلا يزيد على إعادة ما تفعله أصلًا."
          }
        }
      }
    },
    "Listen to every item in order" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاستماع إلى كل العناصر بالترتيب"
          }
        }
      }
    },
    "Listen to the vowel before it. بِسۡمِ ٱللَّهِ and لِلَّهِ are light." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنصت إلى الحركة التي قبلها. فبِسۡمِ ٱللَّهِ ولِلَّهِ مرققتان."
          }
        }
      }
    },
    "Listen → imitate → repeat aloud. Silent learning does not work for makharij." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع ← حاكِ ← كرّر بصوت مسموع. فالتعلّم الصامت لا يُجدي في المخارج."
          }
        }
      }
    },
    "Listen, imitate, repeat aloud: silent study does not train a makhraj." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع، وحاكِ، وكرّر بصوت مسموع: الدراسة الصامتة لا تدرّب مخرجًا."
          }
        }
      }
    },
    "Listener" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مستمع"
          }
        }
      }
    },
    "Listening" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاستماع"
          }
        }
      }
    },
    "Listening to skilled reciters" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاستماع إلى القرّاء المتقنين"
          }
        }
      }
    },
    "Listening to skilled reciters is one of the most powerful ways to improve pronunciation and rhythm. Many students benefit from listening to classical Egyptian reciters such as Sheikh Muhammad Siddiq Al-Minshawi and Sheikh Mahmoud Khalil Al-Hussary." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاستماع إلى القرّاء المتقنين من أقوى ما يحسّن به النطق والإيقاع. وينتفع كثير من الطلبة بالاستماع إلى قرّاء مصر الأوائل، كالشيخ محمد صدّيق المنشاوي والشيخ محمود خليل الحصري."
          }
        }
      }
    },
