    "The Converging Case" : {},
    "The Damascene reading, and the earliest-born of the ten." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القراءة الدمشقية، وصاحبها أقدم العشرة مولدًا."
