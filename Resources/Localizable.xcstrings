    "Reciting it as it deserves to be recited. This حق is the same one in حق الحرف, the next lesson's subject." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلاوته كما يستحق أن يُتلى. وهذا الحق هو الحق نفسه في حق الحرف، وهو موضوع الدرس التالي."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
