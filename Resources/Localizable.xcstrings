    },
    "Any kasrah before the name lightens the lam, incidental or not." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل كسرة قبل الاسم ترقق اللام، عارضة كانت أو أصلية."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسم سے پہلے ہر زیر لام کو باریک کر دیتا ہے، عارضی ہو یا اصلی۔"
          }
        }
      }
    },
    "Any length you like; the two rules are unrelated" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أيّ مقدار شئت، فالحكمان لا علاقة لأحدهما بالآخر"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جو مقدار چاہیں، دونوں حکموں کا آپس میں کوئی تعلق نہیں"
          }
        }
      }
    },
    "Any letter except hamzah" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أيّ حرف غير الهمزة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہمزہ کے سوا کوئی بھی حرف"
          }
        }
      }
    },
    "Any letter with no sukoon that is not a madd letter: slow down, a rule is at work." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل حرف لا سكون عليه وليس حرف مدّ: تمهّل، فثمّ حكم يعمل."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر وہ حرف جس پر سکون نہ ہو اور جو حرفِ مد بھی نہ ہو: آہستہ ہو جائیں، یہاں کوئی حکم لاگو ہے۔"
          }
        }
      }
    },
    "Any of the three" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أيّ واحد من الثلاثة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تینوں میں سے کوئی بھی"
