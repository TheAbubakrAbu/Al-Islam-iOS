    },
    "This ayah is not separate in this riwayah; its words are part of a neighboring ayah, so the Hafs text is shown." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الآية ليست مستقلة في هذه الرواية؛ كلماتها جزء من آية مجاورة، لذا يُعرض نص حفص."
          }
        },
        "ur" : {
          "stringUnit" : {
