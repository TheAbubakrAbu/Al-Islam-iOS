          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نون کو چھپا کر غنّہ کے ساتھ پڑھا جاتا ہے، نہ پورا اظہار ہوتا ہے نہ پورا ادغام۔"
          }
        }
      }
    },
    "The noon is hidden: between clear and merged, with a two-count hum." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُخفى النون: فتكون بين الإظهار والإدغام، مع غنة بمقدار حركتين."
