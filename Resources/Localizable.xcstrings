    },
    "Renames this profile" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد تسمية هذا الملف الشخصي"
          }
        }
      }
    },
    "Renaming a prayer only changes how it is displayed: in the app, its notifications, the widgets and on your Apple Watch. Leave a field blank to use the default spelling." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيير اسم الصلاة لا يغيّر إلا طريقة عرضه: في التطبيق وفي إشعاراتها والأدوات وعلى Apple Watch. اترك الحقل فارغًا لاستخدام التهجئة الافتراضية."
          }
        }
      }
    },
    "Repair in ruling order: the clear error first, the hidden one after it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصلِح على ترتيب الحكم: الخطأ الجلي أولًا، ثم الخفي بعده."
          }
        }
      }
    },
