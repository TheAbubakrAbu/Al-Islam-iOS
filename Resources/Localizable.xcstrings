            "value" : "كم تُمدّ؟"
          }
        }
      }
    },
    "How Many Counts?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كم حركة؟"
          }
        }
      }
    },
    "How Nagging Works" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيف يعمل التذكير المتكرر"
          }
        }
      }
    },
    "How They Work" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيف تخرج"
          }
        }
      }
    },
    "How To Spot It" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيف تعرفه"
          }
        }
      }
    },
    "How a word's ending changes when you stop on it" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيف يتغيّر آخر الكلمة عند الوقف عليها"
          }
        }
      }
    },
    "How are these opening letters read?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كيف تُقرأ هذه الحروف المقطّعة؟"
          }
        }
      }
    },
    "How deep each sits on the gum" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقدار عمق كل منها في اللثة"
          }
        }
      }
    },
    "How deep in the throat each one sits" : {
      "extractionState" : "manual",
