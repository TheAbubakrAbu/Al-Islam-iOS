    "A bare Arabic root (رحم) lists every word built on it" : {
      "extractionState" : "stale"
    },
    "A bare noon skipped, or swallowed into the next letter" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نون عارية تُسقَط أو تُدغَم في الحرف الذي بعدها"
