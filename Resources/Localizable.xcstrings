    },
    "Sound on its own, still attached in grammar" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمّ في نفسه وبقي التعلّق في اللفظ"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنے آپ میں درست، ترکیب میں اب بھی جڑا ہوا"
          }
        }
      }
    },
    "Sound plurals add an ending and leave the word alone. Broken plurals reshape the inside of the word and follow no single rule; each one is memorized with its noun." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجمع السالم يزيد لاحقة في آخر الكلمة ويُبقي بناءها سليمًا. أما جمع التكسير فيغيّر بناء الكلمة من داخلها ولا يجري على قاعدة واحدة؛ فيُحفظ كل جمع مع اسمه."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جمع سالم ایک لاحقہ لگاتی ہے اور لفظ کو ویسا ہی رہنے دیتی ہے۔ جمع مکسر لفظ کی اندرونی ساخت بدل دیتی ہے اور کسی ایک قاعدے پر نہیں چلتی؛ ہر جمع اپنے اسم کے ساتھ یاد کی جاتی ہے۔"
          }
        }
      }
    },
    "Sound-Alike Letters" : {
