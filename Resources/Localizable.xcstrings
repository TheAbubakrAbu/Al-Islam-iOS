          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ غير مُنزَّل ولا يمكن بثّه دون اتصال بالإنترنت. لديك %@: %@."
          }
        }
      }
    },
    "%@ joined to %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ موصولة بـ%@"
