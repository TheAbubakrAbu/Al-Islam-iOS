    },
    "Which surah would you like to open? You can say a name or a number." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أي سورة تريد فتحها؟ يمكنك قول اسمها أو رقمها."
