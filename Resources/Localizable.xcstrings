          "stringUnit" : {
            "state" : "translated",
            "value" : "التجميد المتبقي"
          }
        }
      }
    },
    "Freeze the position and let the sound run out flat." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أثبت الهيئة ودع الصوت يجري مستويًا."
          }
        }
      }
    },
    "Frequent Reader" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قارئ مواظب"
          }
        }
      }
    },
    "Frequent imalah (tilting the fatha towards a kasra)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كثرة الإمالة (تقريب الفتحة من الكسرة)."
          }
        }
      }
    },
    "Frequent imalah." : {
      "localizations" : {
