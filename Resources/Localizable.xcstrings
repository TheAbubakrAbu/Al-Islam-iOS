                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تمام نمازیں ادا ہوئیں، ایک تاخیر سے۔"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تمام نمازیں ادا ہوئیں، %lld تاخیر سے۔"
                }
