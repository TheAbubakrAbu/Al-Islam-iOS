          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طرفِ لسان کو اپنی جگہ رہنے دیں اور اقصائے لسان کو تالو کی طرف بلند کریں۔"
          }
        }
      }
    },
    "Leaving a faint lam audible in قُل رَّبِّ." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أن تُبقي لامًا خفيّة مسموعة في قُل رَّبِّ."
