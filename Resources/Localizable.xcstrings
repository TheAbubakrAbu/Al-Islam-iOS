    "Rakhawah" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرخاوة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رخاوت"
          }
        }
      }
    },
    "Rakhawah leaves the makhraj slightly open so the sound runs through the gap. A shiddah letter shuts the makhraj and stops dead; the five tawassut letters لن عمر can be held briefly but not indefinitely." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرخاوة تترك المخرج منفتحًا انفتاحًا يسيرًا فيجري الصوت في الفرجة. والحرف الشديد يغلق المخرج فينقطع الصوت انقطاعًا تامًا، والأحرف المتوسطة الخمسة لن عمر تمتد قليلًا ولا تمتد إلى غير نهاية."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رخاوت میں مخرج ہلکا سا کھلا رہ جاتا ہے، اس لیے آواز جھری سے بہتی رہتی ہے۔ شدید حرف مخرج کو بند کر دیتا ہے اور آواز یک دم رک جاتی ہے؛ توسط کے پانچ حروف لن عمر تھوڑی دیر کھینچے جا سکتے ہیں، بےانتہا نہیں۔"
          }
        }
      }
    },
    "Rakhawah: 15, with 5 between" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرخاوة: خمسة عشر، وبينهما خمسة متوسّطة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رخاوت: 15، اور بیچ میں 5"
          }
        }
      }
    },
