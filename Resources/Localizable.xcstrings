    "Close" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إغلاق"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بند کریں"
          }
        }
      }
    },
    "Close it into a ه with sukoon: rahmah, al-qari'ah." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بل أغلقها هاءً ساكنة: رَحۡمَهْ، ٱلۡقَارِعَهْ."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسے ساکن ه بنا کر بند کریں: رَحۡمَهْ، ٱلۡقَارِعَهْ۔"
          }
        }
      }
    },
    "Close lightly and stay closed" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنطبقان انطباقًا خفيفًا وتبقيان مطبقتين"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہلکے سے بند، اور بند ہی رہتے ہیں"
          }
        }
      }
    },
    "Close lightly, then hold while the nose does the work." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أطبق برفق ثم أمسك حتى يتم عمل الأنف."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہلکے سے بند کریں، پھر روکے رکھیں اور کام ناک کو کرنے دیں۔"
          }
        }
      }
    },
    "Close search" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إغلاق البحث"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلاش بند کریں"
          }
        }
      }
    },
    "Close the articulators fully as the letter requires, then part them sharply. The trapped air escapes as a click." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أطبق المخرج إطباقًا تامًّا كما يقتضيه الحرف، ثم افتحه فتحة سريعة. فينفلت الهواء المحبوس نبرةً تسمعها."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرف کے تقاضے کے مطابق مخرج کو پوری طرح بند کریں، پھر اسے جھٹکے سے کھول دیں۔ رکی ہوئی ہوا ایک کھٹکے کی صورت میں نکلتی ہے۔"
          }
        }
      }
    },
    "Close the letter and let the sound end there, then breathe separately." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أغلق الحرف ودع الصوت ينتهي عنده، ثم تنفس بعد ذلك على حدة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرف بند کریں اور آواز وہیں ختم ہونے دیں، پھر الگ سے سانس لیں۔"
          }
        }
      }
    },
    "Close the lips completely on the mim, then open them for the و." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أطبق الشفتين على الميم إطباقًا تامًّا، ثم افتحهما للواو."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "میم پر ہونٹ پوری طرح بند کریں، پھر و کے لیے کھولیں۔"
          }
        }
      }
    },
    "Close the mouth, let the soft palate drop, and keep the throat relaxed. The sound should ring in the face, not the neck." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أغلق الفم، وأنزل الحنك اللّيّن، وأرخِ الحلق. وينبغي أن يتردّد الصوت في الوجه لا في العنق."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منہ بند کریں، نرم تالو کو نیچے آنے دیں، اور حلق کو ڈھیلا رکھیں۔ آواز چہرے میں گونجنی چاہیے، گردن میں نہیں۔"
          }
        }
      }
    },
    "Close the session" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إغلاق الجلسة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نشست بند کریں"
          }
        }
      }
    },
    "Close the sound and keep the air in your chest. Do not breathe and do not let the two words run together, then carry on." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أغلق الصوت واحبس الهواء في صدرك. لا تتنفّس ولا تدع الكلمتين تختلطان، ثم صِلْ."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آواز بند کریں اور ہوا سینے میں روکے رکھیں۔ سانس نہ لیں اور دونوں کلموں کو آپس میں گڈمڈ نہ ہونے دیں، پھر آگے ملا دیں۔"
          }
        }
      }
    },
    "Close the sound off at the letter itself." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أغلق الصوت عند الحرف نفسه."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آواز کو حرف ہی پر بند کر دیں۔"
          }
        }
      }
    },
    "Close the throat on the hamzah first, then open into the madd." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أغلق الحلق على الهمزة أوّلًا، ثمّ انفتح على المدّ."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پہلے ہمزے پر حلق بند کریں، پھر مد کی طرف کھولیں۔"
          }
        }
      }
    },
    "Close the throat properly on the hamzah. The madd exists to make room for that closure, not to replace it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أغلق الحلق على الهمزة إغلاقًا تامًّا. فالمدّ إنّما وُجد ليُفسح لهذا الانغلاق مكانًا لا ليحلّ محلّه."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہمزہ پر حلق کو پوری طرح بند کریں۔ مد اسی بندش کے لیے جگہ بنانے کو ہے، اس کی جگہ لینے کو نہیں۔"
          }
        }
      }
    },
    "Close to Hamzah in many places, but with its own settled choices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوافق حمزة في مواضع كثيرة، وله مع ذلك اختيارات مستقرة خاصة به."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بہت سے مقامات پر حمزہ کے قریب، مگر اپنے طے شدہ اختیارات کے ساتھ۔"
          }
        }
      },
      "extractionState" : "stale"
    },
    "Close to Ibn Wardan throughout." : {
      "localizations" : {
