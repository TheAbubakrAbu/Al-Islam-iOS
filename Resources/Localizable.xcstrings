    },
    "Stop backing up?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاف النسخ الاحتياطي؟"
          }
        }
      }
    },
    "Stop here" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوقف هنا"
          }
        }
      }
    },
    "Stop here and you say dabhaa with a clean two-count alif and no n-sound." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قِف هنا فتقول ضَبْحَا بألف نقيّة بحركتين من غير صوت نون."
          }
        }
      }
    },
    "Stop here on its own and you have said do not come near the prayer. That is what قبيح means." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا وقفت هنا وحده فقد قلت لا تقربوا الصلاة. وهذا هو معنى الوقف القبيح."
          }
        }
      }
    },
    "Stop here: the ya glides, then holds for your chosen 2, 4 or 6 counts." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قِف هنا: تنزلق الياء ثمّ تُمدّ بما اخترته من حركتين أو أربع أو ستّ."
          }
        }
      }
    },
    "Stop it as رَحۡمَهۡ, with a silent ه." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف عليها رَحۡمَهۡ بهاء ساكنة."
          }
        }
      }
    },
    "Stop listening" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاف الاستماع"
          }
        }
      }
    },
    "Stop on a word ending in fatha-tanween and the n-sound is replaced by a two-count alif. Only fatha-tanween, only at a stop, and never on a ta marbutah." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا وقفت على كلمة منتهية بتنوين فتح أُبدل صوت النون ألفًا بحركتين. وذلك في تنوين الفتح وحده، وعند الوقف وحده، ولا يكون على تاء مربوطة."
          }
        }
      }
    },
    "Stop on a word ending in ة and it closes into a soft \"h\", exactly like a haa." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا وقفت على كلمة آخرها ة نُطقت هاءً ساكنة خفيفة، كالهاء تمامًا."
          }
        }
      }
    },
    "Stop on each: an alif, a bare sukoon, a sakin ha. Three different endings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قِف على كلّ واحدة: ألف، ثمّ سكون مجرّد، ثمّ هاء ساكنة. ثلاث نهايات مختلفة."
          }
        }
      }
    },
    "Stop on it as كُفُوَا, with a clear two-count alif." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف عليها كُفُوَا بألف بينة مقدارها حركتان."
          }
        }
      }
    },
    "Stop on the first word and the madd reverts to a plain two counts." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فإذا وقفت على الكلمة الأولى رجع المدّ إلى حركتين مجرّدتين."
          }
        }
      }
    },
    "Stop on the last consonant with a plain sukoon." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قِف على الحرف الأخير بسكون مجرّد."
          }
        }
      }
    },
    "Stop on the word" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أن تقف على الكلمة"
          }
        }
      }
    },
    "Stop on ٱلۡعَٰلَمِينَ at two counts, then four, then six. All three are permitted; the sitting gets one of them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف على ٱلۡعَٰلَمِينَ بحركتين، ثم بأربع، ثم بست. الثلاثة جائزة، والجلسة تأخذ واحدًا منها."
          }
        }
      }
    },
    "Stop or Flow" : {
      "localizations" : {
