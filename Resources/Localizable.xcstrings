    "Madd Lazim" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المد اللازم"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدِ لازم"
          }
        }
      }
    },
    "Madd Lazim (مَدّ لَازِم) means \"necessary Madd.\" Lazim means necessary or required because the Madd letter is followed by a permanent sukoon or shaddah, so it is lengthened 6 counts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المد اللازم (مَدّ لَازِم) معناه المد الواجب، وسمي لازما لأن حرف المد يليه سكون لازم أو شدة، فيمد ٦ حركات."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدِ لازم (مَدّ لَازِم) کا مطلب ہے «ضروری مد»۔ اسے لازم یعنی ضروری اس لیے کہتے ہیں کہ حرفِ مد کے بعد مستقل سکون یا تشدید آتی ہے، اس لیے اسے 6 حرکات تک کھینچا جاتا ہے۔"
          }
        }
      }
    },
    "Madd Lazim: Six Counts, No Choice" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المدّ اللازم"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدِ لازم: چھ حرکات، کوئی اختیار نہیں"
          }
        }
      }
    },
