        }
      }
    },
    "No current prayer determined yet. Open %@ to refresh prayer times." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تُحدَّد الصلاة الحالية بعد. افتح تطبيق %@ لتحديث مواقيت الصلاة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابھی تک موجودہ نماز طے نہیں ہوئی۔ نماز کے اوقات تازہ کرنے کے لیے %@ ایپ کھولیں۔"
