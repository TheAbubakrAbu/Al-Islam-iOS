        }
      }
    },
    "A noon sakin before a throat letter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نون ساكنة قبل حرف حلقيّ"
