          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الف، لفظِ جلالہ کی لام، اور راء"
          }
        }
      }
    },
    "Alif, yaa and waaw stretching the vowel before them" : {
      "localizations" : {
