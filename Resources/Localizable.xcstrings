    "No accounts and no tracking, and it works offline. What you save is yours alone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلا حسابات ولا تتبّع، ويعمل دون اتصال بالإنترنت. ما تحفظه لك وحدك."
          }
        }
      }
    },
    "No added time. Tafkheem changes the shape of the sound, never its length." : {
      "extractionState" : "manual",
