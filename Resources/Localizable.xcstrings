    "Breath after the last letter adds an audible ه that nobody wrote. It comes from breathing at the stop rather than after it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النفَس بعد الحرف الأخير يزيد هاءً مسموعة لم يكتبها أحد. وسببه أن القارئ يتنفس مع الوقف لا بعده."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخری حرف کے بعد کا سانس ایک سنائی دینے والی ه بڑھا دیتا ہے جو کسی نے لکھی ہی نہیں۔ اس کا سبب یہ ہے کہ سانس وقف کے بعد نہیں بلکہ وقف کے ساتھ ہی لے لیا جاتا ہے۔"
          }
        }
      }
    },
    "Breath or Voice" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جريان النفَس أو انحباسه"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سانس یا آواز"
          }
        }
      }
    },
    "Breath, voice, and whether the tongue clamps" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الهمس والجهر، وهل ينطبق اللسان"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سانس، جہر، اور زبان کا چپکنا یا نہ چپکنا"
          }
        }
      }
    },
    "Breathe. Then go back a few words and take the phrase again from a place the meaning can start from." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنفّس، ثم ارجع كلمات يسيرة وابتدئ العبارة من موضع يصحّ ابتداء المعنى منه."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سانس لیں۔ پھر چند کلمے پیچھے جا کر عبارت ایسی جگہ سے شروع کریں جہاں سے معنیٰ کا آغاز درست ہو۔"
          }
        }
      }
    },
    "Brief breathless pause." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سكتة لطيفة دون تنفّس."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سانس لیے بغیر مختصر سکتہ۔"
          }
        }
      }
    },
    "Bring the lips into a mim shape without pressing them shut, hum through the nose, then release into the ب." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قرّب الشفتين على هيئة الميم من غير إطباق، وأجرِ الغنة في الأنف، ثم أطلقها إلى الباء."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہونٹوں کو میم کی شکل میں لے آئیں، دبا کر بند نہ کریں، غنّہ ناک سے جاری کریں، پھر ب میں چھوڑ دیں۔"
          }
        }
      }
    },
