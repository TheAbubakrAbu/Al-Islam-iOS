    "No accounts and no tracking, and it works offline. What you save is yours alone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلا حسابات ولا تتبّع، ويعمل دون اتصال بالإنترنت. ما تحفظه لك وحدك."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نہ کوئی اکاؤنٹ، نہ کوئی ٹریکنگ، اور یہ آف لائن بھی کام کرتی ہے۔ آپ جو محفوظ کریں وہ صرف آپ کا ہے۔"
          }
        }
      }
    },
    "No added time. Tafkheem changes the shape of the sound, never its length." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا زيادة في الزمن. التفخيم يغير هيئة الصوت ولا يغير مقداره."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کوئی زائد وقت نہیں۔ تفخیم آواز کی ہیئت بدلتی ہے، اس کی مقدار کبھی نہیں۔"
          }
        }
      }
    },
    "No ads, fees or subscriptions. Offered as sadaqah jariyah." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلا إعلانات ولا رسوم ولا اشتراكات. مقدَّم صدقةً جارية."
