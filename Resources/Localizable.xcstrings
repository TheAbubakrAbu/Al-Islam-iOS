          }
        }
      }
    },
    "Which surah would you like to play? You can say a name or a number." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أي سورة تريد تشغيلها؟ يمكنك قول اسمها أو رقمها."
