        }
      }
    },
    "Alif, yaa and waaw stretching the vowel before them" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الألف والياء والواو تمدّ الحركة التي قبلها"
