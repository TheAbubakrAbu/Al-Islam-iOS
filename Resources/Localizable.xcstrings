          "stringUnit" : {
            "state" : "translated",
            "value" : "الحروف الحلقية في الكلمات"
          }
        }
      }
    },
    "Throat pairs" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أزواج الحلق"
          }
        }
      }
    },
    "Throne of Allah" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرش الله"
          }
        }
      }
    },
    "Through Silent Mode" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عبر الوضع الصامت"
          }
        }
      }
    },
    "Through Warsh his reading became the recitation of North and West Africa, where it remains dominant; through Qalun it is the reading of Libya and parts of Tunisia." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وبرواية ورش صارت قراءته قراءة شمال أفريقيا وغربها، وما زالت هي الغالبة هناك؛ وبرواية قالون هي قراءة ليبيا وأجزاء من تونس."
          }
        }
      }
    },
