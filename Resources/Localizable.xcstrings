        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پورے قرآن میں کسی موضوع کو روشن کریں"
          }
        }
      }
    },
    "Light against heavy, three times. The tip of the tongue stays put and only the back of it moves." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرقق في مقابل مفخم، ثلاث مرات. طرف اللسان ثابت في موضعه، ولا يتحرك إلا أقصاه."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مرقق کے مقابل مفخم، تین بار۔ طرفِ لسان اپنی جگہ قائم رہتی ہے اور صرف اقصائے لسان حرکت کرتا ہے۔"
          }
        }
      }
    },
    "Light and Darkness" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
