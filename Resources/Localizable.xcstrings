    "Waaw and yaa are also the leen letters when they carry a sukoon after a fatha." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "والواو والياء هما أيضًا حرفا اللين إذا سكنتا بعد فتحة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واؤ اور یا جب زبر کے بعد ساکن ہوں تو حروفِ لین بھی ہیں۔"
          }
        }
      }
    },
    "Waaw and yaa with a sukoon after a fatha: they glide out with no effort." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الواو والياء الساكنتان بعد فتحة: تخرجان في لين بلا كلفة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زبر کے بعد ساکن واؤ اور یا: یہ بغیر کسی مشقت کے نرمی سے ادا ہوتے ہیں۔"
          }
        }
      }
    },
    "Wahy" : {
      "extractionState" : "manual",
      "localizations" : {
