        }
      }
    },
    "It appears in the Quran more than 2,600 times, beginning with the very first ayah:" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقد ورد في القرآن أكثر من ٢٬٦٠٠ مرة، أولها في الآية الأولى:"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ نام قرآن مجید میں 2,600 سے زیادہ مرتبہ آیا ہے، اور اس کی ابتدا بالکل پہلی آیت سے ہوتی ہے:"
          }
        }
      }
    },
    "It applies to Hafs only and differs in the other riwayat" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خاصّة برواية حفص وتختلف في سائر الروايات"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ صرف روایتِ حفص کے ساتھ خاص ہے اور باقی روایات میں مختلف ہے"
          }
        }
      }
    },
    "It asks before removing" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسأل قبل الإزالة"
          }
        },
