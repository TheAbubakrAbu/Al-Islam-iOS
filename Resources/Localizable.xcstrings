          "stringUnit" : {
            "state" : "translated",
            "value" : "العنوان غير متوفر"
          }
        }
      }
    },
    "Adds extra details (revelation type, ayah count, page count, and more) beneath each surah in the main Quran list, the screen where all the surahs are shown." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف تفاصيل إضافية (نوع النزول، وعدد الآيات، وعدد الصفحات، وغيرها) أسفل كل سورة في قائمة القرآن الرئيسية، وهي الشاشة التي تُعرض فيها السور كلها."
          }
        }
      }
    },
