    "Judge the ra again the moment it becomes sakin. وَٱلۡفَجۡرِ is light joined and heavy stopped." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعد الحكم على الراء ساعة تسكن. فوَٱلۡفَجۡرِ مرققة في الوصل مفخمة في الوقف."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جیسے ہی راء ساکن ہو، اس پر نئے سرے سے حکم لگائیں۔ وَٱلۡفَجۡرِ وصل میں مرقق اور وقف میں مفخم ہے۔"
          }
        }
      }
    },
