        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ تک مکمل کرنے کے لیے روزانہ تقریباً %1$lld آیات (تقریباً %2$lld صفحات)۔"
          }
        }
      }
    },
    "About %lld ayahs a day to go through it every %lld day." : {
      "localizations" : {
