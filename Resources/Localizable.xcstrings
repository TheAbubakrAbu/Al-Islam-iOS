    "۞ marks a quarter of a hizb, ۩ marks a prostration. Read on unless a stop mark says otherwise." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "۞ علامة ربع الحزب، و۩ علامة السجدة. فامضِ في القراءة إلا أن تدلّك علامة وقف على غير ذلك."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "۞ ربعِ حزب کی علامت ہے، ۩ سجدے کی۔ آگے پڑھتے رہیں، الا یہ کہ کوئی علامتِ وقف اس کے خلاف کہے۔"
          }
        }
      }
    },
