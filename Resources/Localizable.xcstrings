    "Conversions use the Umm al-Qura Hijri method, with the Hijri offset set in app settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعتمد التحويل تقويم أم القرى الهجري، مع تعديل التاريخ الهجري المضبوط في إعدادات التطبيق."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدیلی میں ام القریٰ کا ہجری طریقہ استعمال ہوتا ہے، ساتھ وہ ہجری فرق جو ایپ کی ترتیبات میں مقرر ہے۔"
          }
        }
      }
    },
    "Convert Hijri and Gregorian dates" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التحويل بين التاريخين الهجري والميلادي"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہجری اور عیسوی تاریخیں تبدیل کریں"
          }
        }
      }
    },
    "Convert Qiraah to Hafs an Asim?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحويل القراءة إلى حفص عن عاصم؟"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قراءت کو حفص عن عاصم میں بدلیں؟"
          }
        }
      }
    },
    "Converting a noon sakin or tanween into a mim that is concealed rather than fully closed, accompanied by ghunnah, when ب follows." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قلب النون الساكنة أو التنوين ميمًا مخفاة لا مطبقة، مع الغنة، إذا وقعت بعدها الباء."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نون ساکن یا تنوین کے بعد ب آئے تو اسے غنّہ کے ساتھ ایسی میم میں بدل دینا جو مخفی ہو، پوری بند نہ ہو۔"
