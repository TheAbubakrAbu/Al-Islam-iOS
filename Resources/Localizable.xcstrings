    "%lld tiers, in the order a qaa'idah teaches reading before the Quran. Each one tests reading, spelling and listening, never meaning. Eight right out of ten passes a tier, and any tier can be opened at any time." : {
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "مستوى واحد، على الترتيب الذي تعلّم به القاعدةُ القراءةَ قبل القرآن. ويختبر كلٌّ منها القراءة والتهجئة والاستماع، لا المعنى. ويُجتاز المستوى بثماني إجابات صحيحة من عشر، ويمكن فتح أي مستوى في أي وقت."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "مستويان، على الترتيب الذي تعلّم به القاعدةُ القراءةَ قبل القرآن. ويختبر كلٌّ منها القراءة والتهجئة والاستماع، لا المعنى. ويُجتاز المستوى بثماني إجابات صحيحة من عشر، ويمكن فتح أي مستوى في أي وقت."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld مستويات، على الترتيب الذي تعلّم به القاعدةُ القراءةَ قبل القرآن. ويختبر كلٌّ منها القراءة والتهجئة والاستماع، لا المعنى. ويُجتاز المستوى بثماني إجابات صحيحة من عشر، ويمكن فتح أي مستوى في أي وقت."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld مستوًى، على الترتيب الذي تعلّم به القاعدةُ القراءةَ قبل القرآن. ويختبر كلٌّ منها القراءة والتهجئة والاستماع، لا المعنى. ويُجتاز المستوى بثماني إجابات صحيحة من عشر، ويمكن فتح أي مستوى في أي وقت."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld مستوى، على الترتيب الذي تعلّم به القاعدةُ القراءةَ قبل القرآن. ويختبر كلٌّ منها القراءة والتهجئة والاستماع، لا المعنى. ويُجتاز المستوى بثماني إجابات صحيحة من عشر، ويمكن فتح أي مستوى في أي وقت."
                }
              }
            }
          }
        },
        "ur" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "ایک درجہ، اسی ترتیب سے جس سے قاعدہ قرآن مجید سے پہلے پڑھنا سکھاتا ہے۔ یہ پڑھنے، ہجے اور سننے کو جانچتا ہے، معنی کو کبھی نہیں۔ دس میں سے آٹھ درست جواب درجہ پاس کر دیتے ہیں، اور کوئی بھی درجہ کسی بھی وقت کھولا جا سکتا ہے۔"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld درجے، اسی ترتیب سے جس سے قاعدہ قرآن مجید سے پہلے پڑھنا سکھاتا ہے۔ ہر درجہ پڑھنے، ہجے اور سننے کو جانچتا ہے، معنی کو کبھی نہیں۔ دس میں سے آٹھ درست جواب درجہ پاس کر دیتے ہیں، اور کوئی بھی درجہ کسی بھی وقت کھولا جا سکتا ہے۔"
                }
