            "value" : "لا شيء بعد."
          }
        }
      }
    },
    "Nothing yet. Open a hadith, leave a book part-read or run a search, and it collects here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
