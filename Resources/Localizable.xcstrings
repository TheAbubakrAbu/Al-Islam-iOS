          }
        }
      }
    },
    "Transmitted from Umar ibn al-Khattab, Zayd ibn Thabit, Ubayy ibn Ka'b, Abdullah ibn Abbas, and Abdullah ibn as-Sa'ib (may Allah be pleased with them)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
