    "About %lld minutes" : {},
    "About Arabic & the Quran" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عن العربية والقرآن"
          }
        }
      }
    },
    "About Dhikr" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حول الذكر"
          }
        }
      }
    },
    "About Dhikr & Remembrance" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
