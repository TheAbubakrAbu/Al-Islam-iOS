    },
    "See where the riwayat differ, ayah by ayah: what changes, what it means, and every reading side by side" : {
      "extractionState" : "stale"
    },
    "Seek Laylatul Qadr" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحرَّ ليلة القدر"
