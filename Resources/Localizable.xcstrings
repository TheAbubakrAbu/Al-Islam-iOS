            "value" : "استعمال شدہ اسٹوریج: %@"
          }
        }
      }
    },
    "Stories of messengers and prophets, their biographies, miracles, and the histories of earlier nations." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قصص الرسل والأنبياء وسِيَرهم ومعجزاتهم، وأخبار الأمم السابقة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رسولوں اور انبیاء علیہم السلام کے قصے، ان کی سیرت، معجزات، اور پچھلی قوموں کی تاریخ۔"
          }
        }
      }
    },
    "Stories of the Prophets" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قصص الأنبياء"
          }
        },
