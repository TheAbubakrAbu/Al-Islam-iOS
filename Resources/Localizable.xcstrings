    "Trigger letters: ل and ر only." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرفاه: اللام والراء لا غير."
          }
        }
      }
    },
    "Trigger letters: ي ن م و, remembered as يَنْمُو." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحرفه: ي ن م و، وتُجمع في يَنْمُو."
          }
        }
      }
    },
    "Trigger: a shaddah on نّ or مّ. Nothing else is required or checked." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السبب: شدّة على نون أو ميم. ولا يُشترط سواه ولا يُنظر في غيره."
          }
        }
      }
    },
    "Trigger: madd letter ending a word, hamzat qat' beginning the next." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السبب: حرف مدٍّ في نهاية الكلمة، وهمزة قطع في أوّل التي بعدها."
          }
        }
      }
    },
    "Trigger: madd letter then hamzah, inside a single word." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السبب: حرف مدٍّ ثمّ همزة في كلمة واحدة."
          }
        }
      }
    },
    "Trigger: the six throat letters ء ه ع ح غ خ." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سببه: أحرف الحلق الستة ء ه ع ح غ خ."
          }
        }
      }
    },
