    "Lips" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشفتان"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شفتین"
          }
        }
      }
    },
    "Lips close once. The hum belongs to the doubled م." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنطبق الشفتان مرة واحدة. والغنّة للميم المشدّدة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہونٹ ایک ہی بار ملتے ہیں۔ غنّہ مشدّد م کی ہے۔"
          }
        }
      }
    },
    "Lips from the front" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشفتان من الأمام"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہونٹ سامنے سے"
          }
        }
      }
    },
    "Lips meet, no pressure, 2-count hum" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلتقي الشفتان من غير ضغط، وغنّة مقدار حركتين"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہونٹ ملیں، دباؤ نہیں، 2 حرکات کی غنّہ"
          }
        }
      }
    },
    "Lips move up and down only" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حركة الشفتين إلى أعلى وإلى أسفل فقط"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہونٹوں کی حرکت صرف اوپر اور نیچے"
          }
        }
      }
    },
    "Lips move up and down, never stretched sideways. The tongue and throat do most of the work." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتحرّك الشفتان صعودًا ونزولًا، ولا تُمطّان إلى الجانبين أبدًا. وأكثر العمل على اللسان والحلق."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہونٹ اوپر نیچے حرکت کرتے ہیں، کبھی دائیں بائیں نہیں کھنچتے۔ زیادہ تر کام زبان اور حلق کرتے ہیں۔"
          }
        }
      }
    },
    "Lips rounded and pushed forward" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستدير الشفتان وتُدفعان إلى الأمام"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہونٹ گول اور ذرا آگے کو نکلے ہوئے"
          }
        }
      }
    },
    "Lips sealed on the ب, then popped apart, with the ل following immediately." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُطبق الشفتان على الباء ثم تنفرجان، واللام تتبعها من غير فاصل."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ب پر ہونٹ بند، پھر یکایک کھلتے ہیں، اور ل فوراً اس کے پیچھے آتی ہے۔"
          }
        }
      }
    },
    "Lisan, the tongue" : {
