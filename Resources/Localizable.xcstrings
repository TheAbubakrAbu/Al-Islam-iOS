          }
        }
      }
    },
    "Any length you like; the two rules are unrelated" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أيّ مقدار شئت، فالحكمان لا علاقة لأحدهما بالآخر"
          }
        }
      }
    },
    "Any letter except hamzah" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أيّ حرف غير الهمزة"
          }
        }
      }
    },
    "Any letter with no sukoon that is not a madd letter: slow down, a rule is at work." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل حرف لا سكون عليه وليس حرف مدّ: تمهّل، فثمّ حكم يعمل."
          }
        }
      }
    },
    "Any of the three" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
