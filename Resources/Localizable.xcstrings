    "Ayah audio timings: Quran.com (Quran Foundation)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقيتات صوت الآيات: Quran.com (مؤسسة القرآن)"
