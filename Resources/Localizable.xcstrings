    "Isti'la (خص ضغط قظ) raises the tongue; itbaq (ص ض ط ظ) also clamps it flat." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاستعلاء (خص ضغط قظ) يرفع اللسان، والإطباق (ص ض ط ظ) يضيف إلى الرفع انطباق اللسان."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استعلا (خص ضغط قظ) زبان کو اٹھاتا ہے؛ اطباق (ص ض ط ظ) اسے چپٹا کر کے تالو سے لگا بھی دیتا ہے۔"
          }
        }
      }
    },
    "Isti'la and istifal" : {
