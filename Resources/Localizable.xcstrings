    "Meaning matches and the Ask AI row" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النتائج المطابقة في المعنى وصف «اسأل الذكاء الاصطناعي»"
          }
        },
        "ur" : {
