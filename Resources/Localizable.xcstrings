    },
    "Ask AI answers from %@, on your device. Every citation opens its source, and wording it could not verify is marked as such." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجيب «اسأل الذكاء الاصطناعي» من %@، على جهازك. وكل استشهاد يفتح مصدره، وما لم يتمكن من التحقق من صياغته يُعلَّم بذلك."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«اے آئی سے پوچھیں» آپ کی ڈیوائس پر ہی %@ سے جواب دیتا ہے۔ ہر حوالہ اپنا ماخذ کھولتا ہے، اور جس عبارت کی تصدیق نہ ہو سکی اس پر یہ بات واضح کر دی جاتی ہے۔"
          }
        }
      }
    },
