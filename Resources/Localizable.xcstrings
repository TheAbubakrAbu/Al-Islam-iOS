          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ان کی صفات: سانس، جہر، اور زبان کا چپکنا یا نہ چپکنا"
          }
        }
      }
    },
    "Thematic topics from The Clear Quran (Dr. Mustafa Khattab), via the Quranic Universal Library." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موضوعات من «القرآن الواضح» (د. مصطفى خطّاب)، عبر المكتبة القرآنية الشاملة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«دی کلیئر قرآن» (ڈاکٹر مصطفیٰ خطاب) سے موضوعاتی عنوانات، قرآنی یونیورسل لائبریری کے ذریعے۔"
          }
