      }
    },
    "Releasing a breath after the final letter at a stop, so ٱلۡفَلَقِ ends with an audible 'huh'." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إرسال نفَس بعد الحرف الأخير عند الوقف، فتنتهي ٱلۡفَلَقِ بهاء مسموعة."
          }
        }
      }
    },
    "Reliance, protection, and calm before night." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التوكّل والتحصين والسكينة قبل الليل."
          }
        }
      }
    },
    "Remember" : {
      "localizations" : {
