    "One below, two above, three above, one above, two below" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "واحدة من تحت واثنتان من فوق وثلاث من فوق وواحدة من فوق واثنتان من تحت"
