    },
    "Jumuah (Dhuhr)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجمعة (الظهر)"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جمعہ (ظہر)"
          }
        }
      }
    },
    "Jumuah (Friday prayer) counts as Dhuhr; marking either one covers that day's noon prayer." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحتسب صلاة الجمعة بدل الظهر؛ وتسجيل أيٍّ منهما يغطي صلاة الظهر في ذلك اليوم."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جمعہ (جمعے کی نماز) ظہر شمار ہوتی ہے؛ دونوں میں سے کسی ایک پر نشان لگانے سے اس دن کی دوپہر کی نماز شمار ہو جاتی ہے۔"
          }
        }
      }
    },
    "Jumuah counts as Dhuhr" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الجمعة تُحتسب ظهرًا"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جمعہ کو ظہر شمار کیا جاتا ہے"
          }
        }
      }
    },
    "Jumuah replaces Dhuhr on Fridays; pray its 2 sunnah after as 4 (2 then 2) at the masjid, or 2 at home." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحلّ الجمعة محلّ الظهر يوم الجمعة؛ وصلِّ سنتها البعدية أربعًا في المسجد (ركعتين ثم ركعتين)، أو ركعتين في البيت."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جمعے کے دن نمازِ جمعہ ظہر کی جگہ لیتی ہے؛ اس کے بعد کی 2 سنتیں مسجد میں 4 (2 پھر 2) کر کے پڑھیں، یا گھر میں 2۔"
          }
        }
      }
    },
    "Just getting started" : {
