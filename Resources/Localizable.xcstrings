    "List opens a chapter as a scrolling list of hadiths. Pages opens it as a right-to-left paged reader, fitting as many hadiths per page as your font sizes allow." : {
      "extractionState" : "stale"
    },
    "List or pages, dividers, the Quran tab" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قائمة أو صفحات، الفواصل، تبويب القرآن"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فہرست یا صفحات، تقسیم کار لکیریں، القرآن ٹیب"
          }
        }
      }
    },
    "List reader" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القراءة بوضع القائمة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فہرست موڈ میں مطالعہ"
          }
        }
      }
    },
    "List shows a surah as a scrolling list of ayahs. Pages shows it as a mushaf, one page at a time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«القائمة» تعرض السورة قائمةً متتابعة من الآيات. و«الصفحات» تعرضها مصحفًا، صفحةً صفحة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«فہرست» سورت کو آیات کی اسکرول ہونے والی فہرست کی صورت میں دکھاتی ہے۔ «صفحات» اسے مصحف کی طرح، ایک وقت میں ایک صفحہ، دکھاتا ہے۔"
          }
        }
      }
    },
    "List style, Liquid Glass, haptics" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نمط القائمة، الزجاج السائل، الاستجابة اللمسية"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فہرست کا انداز، لیکوئڈ گلاس، لمسی ردِعمل"
          }
        }
      }
    },
    "Listen" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
