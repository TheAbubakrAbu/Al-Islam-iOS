          "stringUnit" : {
            "state" : "translated",
            "value" : "أين تُسمع الحركة في بِ؟"
          }
        }
      }
    },
    "Where it is made" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المخرج"
          }
        }
