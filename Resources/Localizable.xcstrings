    },
    "A nasal hum" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غنة في الخيشوم"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خیشوم کی غنّہ"
          }
        }
      }
    },
    "A natural trill, to be controlled down to one strike" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارتعاد في طرف اللسان، والمطلوب ضبطه على طرقة واحدة"
