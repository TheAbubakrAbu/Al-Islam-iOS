          }
        }
      }
    },
    "Stop after the surah, then carry the basmalah into the next" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقف على آخر السورة، ثم تصل البسملة بأول التالية"
          }
        }
      }
    },
    "Stop after the surah, then join the basmalah to the next one" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوقف على آخر السورة، ثم وصل البسملة بالسورة التالية"
          }
        }
      }
    },
    "Stop an adhan, or play the one waiting" : {
      "localizations" : {
