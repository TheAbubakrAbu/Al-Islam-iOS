    "Sounded only when you begin on the word. In connection it is gone completely." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُنطق إلا إذا ابتدأت بالكلمة. وفي الوصل تذهب بالكلية."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صرف اسی وقت پڑھا جاتا ہے جب کلمے سے ابتدا کریں۔ وصل میں بالکل ختم ہو جاتا ہے۔"
          }
        }
      }
    },
    "Sounded out: %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
