    "Tip out on the teeth, then tip back behind them. If the second of each pair whistles and the first does not, both are right." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الطرف خارجا على الأسنان، ثم الطرف راجعا خلفها. فإن صفر الثاني من كل زوج ولم يصفر الأول فكلاهما صواب."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پہلے نوک باہر دانتوں پر، پھر نوک واپس ان کے پیچھے۔ ہر جوڑے کا دوسرا حرف صفیر کے ساتھ آئے اور پہلا بغیر صفیر کے، تو دونوں درست ہیں۔"
          }
        }
      }
    },
