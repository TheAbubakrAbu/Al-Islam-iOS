    "O you who have believed, remember Allah with much remembrance." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "﴿يَا أَيُّهَا الَّذِينَ آمَنُوا اذْكُرُوا اللَّهَ ذِكْرًا كَثِيرًا﴾"
          }
        }
      }
    },
    "O you who have believed, remember Allah with much remembrance. (Quran 33:41)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
