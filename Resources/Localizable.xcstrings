    },
    "Theme highlights keep the Legend button in the reader, so you can turn this back on from here" : {
      "extractionState" : "stale"
    },
    "Theme wash and share backdrops: Tilawa" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلوين الموضوعات وخلفيات المشاركة: Tilawa"
          }
        },
        "ur" : {
          "stringUnit" : {
