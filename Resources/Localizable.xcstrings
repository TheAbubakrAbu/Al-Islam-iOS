    },
    "Double the noon" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشديد النون"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نون پر تشدید کریں"
          }
        }
      }
    },
    "Doubled letters that never hum. Hold each one dry." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حروف مشددة لا غنة فيها البتة. أمسك كل واحد منها بغير غنة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ مشدّد حروف جن میں غنّہ کبھی نہیں۔ ہر ایک کو بغیر غنّہ کے روکیں۔"
          }
        }
      }
    },
    "Doubled mim then doubled noon, back to back. The second is the one learners miss." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ميم مشدّدة ثم نون مشدّدة متتاليتان. والثانية هي التي يغفل عنها المتعلّمون."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پہلے میمِ مشدّد، پھر نونِ مشدّد، ایک کے بعد ایک۔ سیکھنے والے دوسرے ہی سے غافل ہوتے ہیں۔"
          }
        }
      }
    },
    "Doubled mim, mid-word" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ميم مشدّدة في وسط الكلمة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلمے کے وسط میں میمِ مشدّد"
          }
        }
      }
    },
    "Doubled mim. Lips shut for the full two counts before the fatha releases them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ميم مشدّدة. الشفتان منطبقتان الحركتين تامّتين قبل أن تُطلقهما الفتحة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "میمِ مشدّد۔ فتحہ (زبر) کے چھوڑنے سے پہلے پوری دو حرکات تک ہونٹ بند رہیں۔"
          }
        }
      }
    },
    "Doubled noon and doubled mim. Two counts of hum on each, no exceptions." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نون مشددة وميم مشددة. غنة حركتين في كل واحدة، بلا استثناء."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نونِ مشدّد اور میمِ مشدّد۔ ہر ایک پر دو حرکات کی غنّہ، بلا استثنا۔"
          }
        }
      }
    },
    "Doubled nun, first syllable" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نون مشدّدة في أوّل الكلمة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کلمے کے شروع میں نونِ مشدّد"
          }
        }
      }
    },
    "Doubled tāʾ joined to the word before" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشديد التاء وصلًا بما قبلها"
