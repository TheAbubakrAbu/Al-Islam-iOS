    "Heavy Concealment" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إخفاء مفخّم"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پُر اخفاء"
          }
        }
      }
    },
    "Heavy Ikhfaa partially hides noon or tanween before heavy letters with a stronger, fuller nasal ghunnah." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإخفاء المفخّم يُخفي النون الساكنة أو التنوين جزئيًا قبل حروف الاستعلاء بغنة أقوى وأفخم."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پُر اخفاء میں پُر حروف سے پہلے نون ساکن یا تنوین کو زیادہ مضبوط اور بھرپور غنہ کے ساتھ جزوی طور پر چھپایا جاتا ہے۔"
          }
        }
      }
    },
    "Heavy Laam (Only in \"Allah\")" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللام المفخّمة (في لفظ الجلالة وحده)"
