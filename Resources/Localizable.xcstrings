    "%@" : {},
    "%@\n\nAyahs: %lld\nPages: %lld\nWords: %lld\nLetters: %lld\n\nStarts: Surah %lld:%lld\nEnds: Surah %lld:%lld" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nالآيات: %lld\nالصفحات: %lld\nالكلمات: %lld\nالحروف: %lld\n\nيبدأ من: %lld:%lld\nينتهي عند: %lld:%lld"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nآیات: %lld\nصفحات: %lld\nالفاظ: %lld\nحروف: %lld\n\nآغاز: %lld:%lld\nاختتام: %lld:%lld"
          }
        }
      }
    },
    "%@\n\nGray means the page and juz do not change here. It is mainly showing a surah start or end." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nاللون الرمادي يعني أن الصفحة والجزء لا يتغيران هنا. وهو يشير غالبًا إلى بداية سورة أو نهايتها."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nسرمئی رنگ کا مطلب ہے کہ یہاں صفحہ اور پارہ نہیں بدلتے۔ یہ زیادہ تر کسی سورت کا آغاز یا اختتام دکھاتا ہے۔"
          }
        }
      }
    },
    "%@\n\nThe color change means both the page and the juz change here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nتغيّر اللون يعني أن الصفحة والجزء كليهما يتغيران هنا."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nرنگ کی تبدیلی کا مطلب ہے کہ یہاں صفحہ اور پارہ دونوں بدلتے ہیں۔"
          }
        }
      }
    },
    "%@\n\nThe color change means the page changes here. The juz stays the same." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nتغيّر اللون يعني أن الصفحة تتغير هنا. ويبقى الجزء نفسه."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nرنگ کی تبدیلی کا مطلب ہے کہ یہاں صفحہ بدلتا ہے۔ پارہ وہی رہتا ہے۔"
          }
        }
      }
    },
    "%@\n\nThis divider is highlighted because it marks a surah start or end. It is mostly a visual marker, not a page or juz change." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nهذا الفاصل مميَّز لأنه يحدد بداية سورة أو نهايتها. وهو علامة مرئية في الغالب، وليس تغيّرًا في الصفحة أو الجزء."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@\n\nیہ فاصل لکیر اس لیے نمایاں ہے کہ یہ کسی سورت کے آغاز یا اختتام کی نشاندہی کرتی ہے۔ یہ زیادہ تر ایک بصری نشان ہے، صفحے یا پارے کی تبدیلی نہیں۔"
          }
        }
      }
    },
