    "Skip it, whether you read on or stop. The round zero means written and never sounded." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تنطقه، وصلت أو وقفت. فالصفر المستدير معناه: يُكتب ولا يُنطق أبدًا."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسے چھوڑ دیں، چاہے وصل کریں یا وقف۔ گول صفر کا مطلب ہے: لکھا جاتا ہے مگر کبھی پڑھا نہیں جاتا۔"
          }
        }
      }
    },
    "Skip the lam, double the letter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تترك اللام وتشدّد الحرف"
