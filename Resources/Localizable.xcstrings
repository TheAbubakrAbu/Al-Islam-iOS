    },
    "Ask AI runs with Apple Intelligence, which needs iOS 26 on a supported iPhone with Apple Intelligence turned on in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعمل ميزة «اسأل الذكاء الاصطناعي» بواسطة Apple Intelligence، التي تتطلب iOS ٢٦ على iPhone مدعوم مع تشغيل Apple Intelligence في الإعدادات."
