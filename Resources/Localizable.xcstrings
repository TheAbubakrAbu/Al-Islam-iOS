          }
        }
      }
    },
    "Merging there would make the word look like it has a doubled root letter, and the meaning would be lost." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإدغام هناك يوهم أن في الكلمة حرفًا مضعفًا من أصلها، فيضيع المعنى."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہاں ادغام کرنے سے گمان ہو گا کہ کلمے میں اصل ہی سے کوئی مشدّد حرف ہے، اور معنی جاتا رہے گا۔"
          }
        }
      }
    },
    "Merging with nasal" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إدغام مع غنة"
          }
        },
