            "state" : "translated",
            "value" : "روایت کا بقیہ حصہ ایپ میں ہے۔"
          }
        }
      }
    },
    "The narration whose printed mushaf uses the Maghribi script, with the dot for hamzat al-wasl." : {},
    "The narration whose printed mushaf uses the Maghribi script." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
