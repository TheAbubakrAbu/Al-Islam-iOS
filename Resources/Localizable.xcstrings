    "Read full and heavy in every position, whatever vowel they carry." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُقرأ مفخّمة في كل موضع، أيًّا كانت حركتها."
