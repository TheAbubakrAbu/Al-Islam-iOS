    "Computed for both cities from their own sunrise, Maghrib and next Fajr. These switches only affect this screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محسوبة لكلتا المدينتين من شروقها ومغربها وفجرها التالي. ولا تؤثر هذه المفاتيح إلا في هذه الشاشة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دونوں شہروں کے لیے ان کے اپنے طلوعِ آفتاب، مغرب اور اگلی فجر سے شمار کیا گیا۔ یہ سوئچ صرف اسی اسکرین پر اثر ڈالتے ہیں۔"
          }
        }
      }
    },
    "Computed from this city’s own sunrise, Maghrib and next Fajr. These switches only affect this screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محسوبة من شروق هذه المدينة ومغربها وفجرها التالي. ولا تؤثر هذه المفاتيح إلا في هذه الشاشة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس شہر کے اپنے طلوعِ آفتاب، مغرب اور اگلی فجر سے شمار کیا گیا۔ یہ سوئچ صرف اسی اسکرین پر اثر ڈالتے ہیں۔"
          }
        }
      }
    },
    "Concepts" : {
