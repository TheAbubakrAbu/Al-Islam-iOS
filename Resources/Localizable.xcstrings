    "Where Could He Have Learned It?" : {},
    "Where You May Stop" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنواع الوقف"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کہاں ٹھہرنا جائز ہے"
          }
        }
      }
    },
    "Where a narration has been graded, the grade shows under it with the scholar's name, and stays visible whichever language you hide." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حيثما حُكم على الرواية، تظهر درجتها تحتها مع اسم العالِم، وتبقى ظاهرة أيًّا كانت اللغة التي تخفيها."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جہاں کسی روایت کا درجہ بیان کیا گیا ہو، وہاں درجہ عالم کے نام کے ساتھ اس کے نیچے نظر آتا ہے، اور آپ کوئی بھی زبان چھپائیں، نظر آتا رہتا ہے۔"
          }
        }
      }
    },
    "Where a shaddah comes from" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من أين تأتي الشدة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشدید کہاں سے آتی ہے"
          }
        }
      }
    },
    "Where does the name badal come from?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من أين جاء اسم البدل؟"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بدل کا نام کہاں سے آیا؟"
          }
        }
      }
    },
    "Where each is made" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مخرج كل منهما"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر ایک کا مخرج"
          }
        }
      }
    },
    "Where each letter comes from and what it does once it leaves." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من أين يخرج كل حرف، وما الذي يعرض له بعد خروجه."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر حرف کہاں سے نکلتا ہے اور نکلنے کے بعد کیا کرتا ہے۔"
          }
        }
      }
    },
    "Where each letter is made" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مخرج كل حرف"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر حرف کہاں سے ادا ہوتا ہے"
          }
        }
      }
    },
    "Where each letter is made: the throat, the tongue, the lips" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مخرج كل حرف: الحلق، واللسان، والشفتان"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر حرف کہاں سے ادا ہوتا ہے: حلق، زبان، ہونٹ"
          }
        }
      }
    },
    "Where in the mouth or throat is the letter made?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من أين يخرج الحرف في الفم أو الحلق؟"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرف منہ یا حلق میں کہاں سے ادا ہوتا ہے؟"
          }
        }
      }
    },
    "Where is ghunnah produced?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من أين تخرج الغنّة؟"
          }
        },
        "ur" : {
          "stringUnit" : {
