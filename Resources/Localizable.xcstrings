          }
        }
      }
    },
    "Word-by-word meanings from the Quranic Arabic Corpus, via Quran.com. They render each word literally and in place, so they read differently from the flowing translation above." : {},
    "Word-by-word meanings from the Quranic Arabic Corpus, via Quran.com. They render each word literally and in place, so they read differently from the flowing translation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معاني الكلمات كلمةً كلمة من مدوّنة القرآن العربية، عبر Quran.com. تؤدي كل كلمة حرفيًا وفي موضعها، لذا تختلف قراءتها عن الترجمة المتصلة."
          }
        }
      }
    },
    "Word-by-word meanings: Quran.com and the Quranic Arabic Corpus" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المعاني كلمةً بكلمة: Quran.com ومدوّنة القرآن العربية"
          }
        }
      }
    },
    "Word-by-word reader: Tilawa, by Jamil Hammoudeh" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القراءة كلمةً بكلمة: Tilawa، من جميل حمّودة"
