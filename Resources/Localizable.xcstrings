    "Letter written in the script but dropped in recitation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرف مكتوب في الرسم ساقط في التلاوة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رسم میں لکھا گیا حرف جو تلاوت میں ساقط ہو جاتا ہے۔"
          }
        }
      }
    },
    "Letters" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحروف"
          }
        },
        "ur" : {
          "stringUnit" : {
