    "Do not assume every long madd in these words is hukmi. The word هَٰٓؤُلَآءِ contains BOTH:" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تظنّ أن كل مدّ طويل في هذه الكلمات حكمي. ففي كلمة هَٰٓؤُلَآءِ النوعان معًا:"
          }
        }
      }
    },
    "Do not confuse Alif with Hamza on Alif (أ or إ). The hamzah is the consonant there; the alif is only its seat." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تخلط بين الألف والهمزة التي على الألف (أ أو إ). فالهمزة هناك هي الحرف المنطوق، والألف ليست إلا كرسيًّا لها."
          }
        }
      }
    },
    "Do not force pressure" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تتكلّف الضغط"
          }
        }
      }
    },
    "Do not move. The vowel has already put your tongue and lips in position; simply keep the sound running on the same shape while the air continues." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُحرّك شيئًا. فالحركة قد وضعت لسانك وشفتيك في موضعهما، فأبقِ الصوت جاريًا على الهيئة نفسها ما دام النفَس مستمرًّا."
          }
        }
      }
    },
    "Do not pronounce the first letter at all. Go straight to the second and double it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تنطق الحرف الأول ألبتة. وامضِ إلى الثاني فشدّده."
          }
        }
      }
    },
    "Do not read the laam. The next letter is doubled instead" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تقرأ اللام. والحرف بعدها مضعَّف مكانها"
          }
        }
      }
    },
    "Do not say it at all" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تنطقها ألبتة"
          }
        }
      }
    },
    "Do not say the noon at all. Go straight to the following letter and double it, keeping the nasal passage open." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تنطق النون البتة. انتقل مباشرة إلى الحرف الذي بعدها وشدده، مع إبقاء مجرى الأنف مفتوحًا."
          }
        }
      }
    },
    "Do not squeeze the throat" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تضغط الحلق"
          }
        }
      }
    },
    "Do not stop. The Indopak layouts and the Egyptian printings use it; the Madinah text does not." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تقف. تستعملها المصاحف الهندية والمطابع المصرية دون نص المدينة."
          }
        }
      }
    },
    "Do this" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصواب"
          }
        }
      }
    },
    "Do: %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العمل: %@"
          }
        }
      }
    },
    "Does God Exist?" : {},
    "Does the back of the tongue rise toward the roof of the mouth?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل يرتفع أقصى اللسان نحو الحنك الأعلى؟"
          }
        }
      }
    },
    "Does the breath keep flowing while the letter is said?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل يجري النفَس عند النطق بالحرف؟"
          }
        }
      }
    },
    "Does the breath keep running?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أيجري النفَس؟"
          }
        }
      }
    },
    "Does the letter bounce when it carries a sukoon or is stopped on?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل يتقلقل الحرف إذا سكن أو وُقف عليه؟"
          }
        }
      }
    },
    "Does the letter carry a quality all of its own?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل للحرف صفة ينفرد بها؟"
          }
        }
      }
    },
    "Does the sound stop dead, or can you hold it?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل ينحبس الصوت تمامًا، أم يمكنك أن تمدّه؟"
          }
        }
      }
    },
    "Does the sound stop dead?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أينقطع الصوت؟"
          }
        }
      }
    },
    "Does the tongue clamp against the roof of the mouth?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل ينطبق اللسان على الحنك الأعلى؟"
          }
