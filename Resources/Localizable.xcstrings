      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: أدعية من حصن المسلم عددها %lld، مع المرجع الذي رُوي منه كلٌّ منها. اضغط زر التشغيل تحت الدعاء لتستمع إليه."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: حصن المسلم سے %lld دعائیں، ہر ایک اس حوالے کے ساتھ جس سے وہ مروی ہے۔ کسی دعا کی تلاوت سننے کے لیے اس کے نیچے چلانے کا بٹن تھپتھپائیں۔"
          }
        }
