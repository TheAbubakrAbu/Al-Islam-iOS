    "Tunisia, Ministry of Religious Affairs" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تونس، وزارة الشؤون الدينية"
          }
        }
      }
    },
    "Turkey" : {
      "localizations" : {
