    },
    "Slowing down so far that words come apart and vowels appear between letters." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإبطاء إلى حدٍّ تتقطع فيه الكلمات وتتولد الحركات بين الحروف."
