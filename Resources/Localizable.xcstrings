          "stringUnit" : {
            "state" : "translated",
            "value" : "لام چھوڑ دیں، حرف مشدّد کریں"
          }
        }
      }
    },
    "Skip the noon completely. Start on the doubled letter." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أسقط النون بالكلية وابدأ بالحرف المشدد."
