        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہمزہ کے لیے جگہ بنانے کی خاطر دونوں کلموں کو الگ الگ کر دینا۔"
          }
        }
      }
    },
    "Breath" : {
      "extractionState" : "manual",
      "localizations" : {
