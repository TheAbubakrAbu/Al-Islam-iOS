    },
    "About You" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عنك"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے بارے میں"
          }
        }
      }
    },
    "About You remembers whether you grew up Muslim, embraced Islam, are just getting started, or are learning about Islam, and tailors the Start Here guide on the Islam tab. It never leaves your iPhone. Replay the Welcome Tutorial, on the same page, walks the welcome again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتذكّر «عنك» إن كنت نشأت مسلمًا، أو اعتنقت الإسلام، أو بدأت للتو، أو تتعرّف على الإسلام، ويهيّئ دليل «ابدأ من هنا» في تبويب الإسلام بحسب ذلك. ولا تغادر هذه المعلومات جهاز iPhone أبدًا. ويعيد «إعادة عرض الجولة التعريفية»، في الصفحة نفسها، جولة الترحيب من جديد."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«آپ کے بارے میں» یاد رکھتا ہے کہ آپ مسلمان گھرانے میں پلے بڑھے، اسلام قبول کیا، ابھی شروعات کر رہے ہیں، یا اسلام کے بارے میں جان رہے ہیں، اور اسی کے مطابق اسلام ٹیب پر «یہاں سے شروع کریں» کی رہنمائی ترتیب دیتا ہے۔ یہ معلومات کبھی آپ کے iPhone سے باہر نہیں جاتیں۔ اسی صفحے پر «تعارفی دورہ دوبارہ دیکھیں» خوش آمدید کا دورہ پھر سے دکھاتا ہے۔"
          }
        }
      }
    },
    "About Zakah" : {
