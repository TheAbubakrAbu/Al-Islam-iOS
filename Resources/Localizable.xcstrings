            "value" : "اس تاریخ کی نمازیں"
          }
        }
      }
    },
    "Showing results for %@ instead of %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض نتائج %@ بدلًا من %@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ کی بجائے %1$@ کے نتائج دکھائے جا رہے ہیں۔"
          }
        }
      }
    },
    "Shows a different ayah each day at the top of the Quran tab." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض آية مختلفة كل يوم أعلى تبويب القرآن."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قرآن ٹیب کے اوپر ہر روز ایک نئی آیت دکھاتا ہے۔"
          }
        }
      }
    },
    "Shows a different safe ayah from the Quran each day" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض كل يوم آية مختلفة من القرآن تصلح للقراءة بمفردها"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر روز قرآن مجید کی ایک مختلف آیت دکھاتا ہے جو اکیلے پڑھنے کے لیے موزوں ہو"
          }
        }
      }
    },
    "Shows a divider inside a surah wherever a new mushaf page or juz begins, plus a small floating label with the current page and juz while you read." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض فاصلًا داخل السورة حيثما تبدأ صفحة جديدة من المصحف أو جزء جديد، مع ملصق عائم صغير يبيّن الصفحة والجزء الحاليين أثناء القراءة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سورت کے اندر جہاں بھی مصحف کا نیا صفحہ یا نیا پارہ شروع ہو وہاں حد بندی کی لکیر دکھاتا ہے، اور پڑھنے کے دوران موجودہ صفحہ اور پارہ بتانے والا ایک چھوٹا تیرتا لیبل بھی۔"
          }
        }
      }
    },
    "Shows a piece of Quranic vocabulary each day at the top of the Quran tab, with every ayah it appears in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض كلمة من مفردات القرآن كل يوم أعلى تبويب القرآن، مع كل آية وردت فيها."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
