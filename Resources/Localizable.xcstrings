          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر روز %@"
          }
        }
      }
    },
    "Every difference" : {
      "extractionState" : "stale"
    },
    "Every doubled letter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
