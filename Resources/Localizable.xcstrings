    "Rolling the ر like a Spanish rr." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تكرير الراء كالراء الإسبانية."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ر کو ہسپانوی راء کی طرح گھمانا۔"
          }
        }
      }
    },
    "Rolling the ر, so رَبِّ arrives with a Spanish rr." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترديد الراء، فتخرج رَبِّ براء مكررة كالإسبانية."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ر کو تھرتھرا دینا، کہ رَبِّ ہسپانوی مکرّر راء کے ساتھ نکلے۔"
          }
        }
      }
    },
    "Romanized Arabic finds its ayahs however you spell it: sabr, tawbah, alhamdulillah" : {
      "extractionState" : "stale"
    },
