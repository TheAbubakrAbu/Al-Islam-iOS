    "Short adhan" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أذان قصير"
          }
        }
      }
    },
    "Short ayat, read straight through. Inside an ayah a joining hamza is dropped, so the word before runs into the laam or the letter after it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آيات قصيرة تُقرأ متصلة. وفي داخل الآية تسقط همزة الوصل، فتتصل الكلمة السابقة باللام أو بالحرف الذي بعدها."
          }
        }
      }
    },
    "Short remembrances to keep your heart connected to Allah throughout the day." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أذكار قصيرة تُبقي قلبك موصولًا بالله طوال اليوم."
          }
        }
      }
    },
    "Short then long, so the ear hears one count against two." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قصير ثم طويل، لتسمع الأذن حركة في مقابل حركتين."
          }
        }
      }
    },
    "Short vowels" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحركات القصيرة"
          }
        }
      }
    },
    "Short, daily supplications that keep your heart connected to Allah in every situation, each with its source, and the whole of Hisn al-Muslim beside them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدعية يومية قصيرة تُبقي قلبك موصولًا بالله في كل موقف، كلٌّ منها مع مصدره، وإلى جانبها حصن المسلم كاملًا."
          }
        }
      }
    },
    "Short, daily supplications that keep your heart connected to Allah in every situation, each with its source." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدعية يومية قصيرة تُبقي قلبك موصولًا بالله في كل موقف، كلٌّ منها مع مصدره."
          }
        }
      }
    },
    "Short, daily supplications that keep your heart connected to Allah in every situation. \"Call upon Me; I will respond to you.\" (Quran 40:60)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدعية يومية قصيرة تُبقي قلبك موصولًا بالله في كل موقف. ﴿ادْعُونِي أَسْتَجِبْ لَكُمْ﴾ (القرآن ٤٠:٦٠)"
          }
        }
      }
    },
    "Short-Vowel Words" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كلمات بالحركات القصيرة"
          }
        }
      }
    },
    "Shorten and combine while away" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القصر والجمع في السفر"
          }
        }
      }
    },
    "Shorten it to two as you pick up speed" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقصره إلى حركتين كلما أسرعت"
          }
        }
      }
    },
    "Shortening a lazim that falls at the end of an ayah, where a stop is expected." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قصر مدٍّ لازم يقع في رأس الآية حيث يُتوقّع الوقف."
          }
        }
      }
    },
    "Shortening the hum on نّ or مّ when the line is moving quickly." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقص الغنة في نّ أو مّ عند الإسراع في السطر."
          }
        }
      }
    },
    "Shortening the madd when the line is long or the pace picks up." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقص المد إذا طال السطر أو أسرعت الوتيرة."
          }
        }
      }
    },
    "Shortens and combines the prayers while you are away from home." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقصر الصلوات ويجمعها ما دمت بعيدًا عن بلدك."
          }
        }
      }
    },
    "Shortens and combines the prayers while you are away from home. Turns on and off by itself; you can also set it here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقصر الصلوات ويجمعها ما دمت بعيدًا عن بلدك. يعمل ويتوقف من تلقاء نفسه، ويمكنك أيضًا ضبطه هنا."
          }
        }
      }
    },
    "Shorter madd than Warsh, and a lighter touch overall." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدّ أقصر من مدّ ورش، وأداء أخفّ عمومًا."
          }
        }
      }
    },
    "Shorter, combined prayers away from home." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قصر الصلاة وجمعها بعيدًا عن بلدك."
          }
        }
      }
    },
    "Show" : {
      "localizations" : {
