    },
    "How much larger the Arabic reads on the alphabet screens. A floor: the letters never render smaller than your device's own text size." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقدار تكبير النص العربي في شاشات الحروف الهجائية. وهو حدّ أدنى: لا تظهر الحروف أصغر من حجم النص في جهازك."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حروفِ تہجی کی اسکرینوں پر عربی کتنی بڑی دکھائی دے۔ یہ کم از کم حد ہے: حروف کبھی آپ کی ڈیوائس کے اپنے متن کے سائز سے چھوٹے نہیں دکھتے۔"
          }
        }
      }
    },
    "How much of the sound is nasal rather than articulated in the mouth" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
