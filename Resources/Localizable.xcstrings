        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. اگر فعل ہو ← تیسرا حرف دیکھیں (پیش ہو تو اُ، ورنہ اِ)۔"
          }
        }
      }
    },
