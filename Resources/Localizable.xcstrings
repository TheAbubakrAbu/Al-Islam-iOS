    "Duha, Islamic midnight, last third" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الضحى، منتصف الليل الشرعي، الثلث الأخير"
          }
        },
        "ur" : {
          "stringUnit" : {
