        }
      }
    },
    "Is the laam of ٱلۡ read before this letter, or merged into it?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تُنطق لام ٱلۡ قبل هذا الحرف، أم تُدغم فيه؟"
          }
        }
      }
    },
    "Is the letter made at the quick tip of the tongue or the lips?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل يخرج الحرف من طرف اللسان أو من الشفتين فيخفّ نطقه؟"
          }
        }
      }
    },
    "Is the letter read full and heavy, or thin and light?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل يُقرأ الحرف مفخّمًا ممتلئًا، أم مرقّقًا نحيفًا؟"
          }
        }
      }
    },
    "Is the tinted letter alif maqSoorah or yaa?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل الحرف الملوّن ألف مقصورة أم ياء؟"
          }
        }
      }
    },
    "Is the و in خَوۡف a jawf letter?" : {
