        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ختمِ قرآن میں آپ کی پیش رفت محفوظ رہتی ہے؛ صرف ہدف اور روزانہ کی مقداریں ہٹائی جاتی ہیں۔"
