    },
    "Remembers and shows the last ayah you were reading at the top of the Quran tab." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتذكّر آخر آية كنت تقرؤها ويعرضها أعلى تبويب القرآن."
