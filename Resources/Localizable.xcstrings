    "All prayers prayed on time, a perfect day." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صُلّيت الصلوات كلها في وقتها، يوم مثالي."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمام نمازیں وقت پر ادا ہوئیں، ایک مثالی دن۔"
          }
        }
      }
    },
    "All prayers prayed, %lld late." : {
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
