        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل «معاينة الصوت» الأذان المختار من بدايته إلى نهايته، لا الثواني الثلاثين التي يحملها الإشعار."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«آواز کا نمونہ سنیں» منتخب اذان شروع سے آخر تک چلاتا ہے، نہ کہ صرف وہ 30 سیکنڈ جو اطلاع میں ہوتے ہیں۔"
          }
        }
      }
    },
