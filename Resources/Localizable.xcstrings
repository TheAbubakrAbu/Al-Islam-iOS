    "Sound" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصوت"
          }
        }
      }
    },
    "Sound before ٱللَّه" : {
      "extractionState" : "manual",
      "localizations" : {
