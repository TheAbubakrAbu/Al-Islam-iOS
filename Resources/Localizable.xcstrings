                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "نحو كيلوغرامين من القوت الذي يأكله أهل بيتك: الأرز أو التمر أو الدقيق."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "نحو %lld كيلوغرامات من القوت الذي يأكله أهل بيتك: الأرز أو التمر أو الدقيق."
                }
              },
              "many" : {
