    "Isolate with the sukoon test, find the row, drill the neighbour against it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعزل باختبار السكون، ثم اطلب الصف، ثم درّب الجار في مقابلته."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سکون کی آزمائش سے حرف الگ کریں، اس کی سطر تلاش کریں، پھر پڑوسی حرف کے ساتھ باری باری مشق کریں۔"
          }
