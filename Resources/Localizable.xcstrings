    "Traveling mode automatically turned off at %@, near %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُوقف وضع السفر تلقائيًا في %@، قرب %@"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سفر موڈ %@ میں خودکار طور پر آف ہو گیا، %@ کے قریب"
          }
