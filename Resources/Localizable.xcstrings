    "Istighfar, repentance, mercy, and a clean return." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاستغفار والتوبة والرحمة، ورجوع بقلب نقيّ."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استغفار، توبہ، رحمت اور پاکیزہ دل کے ساتھ لوٹنا۔"
          }
        }
      }
    },
    "Istitalah" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاستطالة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استطالت"
          }
        }
      }
    },
    "Istitalah extends ض in distance along the tongue, not in time." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاستطالة تمد الضاد في المسافة على اللسان لا في الزمن."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استطالت ض کو زبان پر مسافت میں بڑھاتی ہے، وقت میں نہیں۔"
          }
        }
      }
    },
    "Istitalah on the doubled ض: the sound runs along the tongue's edge toward the place of the ل that follows it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استطالة في الضاد المشددة: يجري الصوت على حافة اللسان نحو مخرج اللام التي بعدها."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشدّد ض پر استطالت: آواز حافّۂ لسان پر چلتی ہوئی اس ل کے مخرج کی طرف بڑھتی ہے جو اس کے بعد آتا ہے۔"
          }
        }
      }
    },
    "It Is" : {
