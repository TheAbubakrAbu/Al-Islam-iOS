    "%lld narrations from Bukhari, Muslim, Abu Dawud and at-Tirmidhi, each with a title, filed under %lld subjects. Open one to read how each collection words it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld حديثًا من البخاري ومسلم وأبي داود والترمذي، لكلٍّ منها عنوان، مصنّفة في %lld موضوعًا. افتح أيًّا منها لتقرأ كيف ترويه كل مجموعة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بخاری، مسلم، ابو داؤد اور ترمذی سے %lld روایات، ہر ایک اپنے عنوان کے ساتھ، %lld موضوعات کے تحت درج ہیں۔ کوئی ایک کھولیں اور دیکھیں کہ ہر مجموعہ اسے کن الفاظ میں بیان کرتا ہے۔"
          }
        }
      }
    },
    "%lld narrations from the Hadith Encyclopedia, each with its meaning laid out by scholars, the lessons drawn from it, its grading and its sources, in Arabic and English. Browse by topic or search the texts." : {
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld حديث من موسوعة الأحاديث النبوية، لكلٍّ منها معناه كما بيّنه العلماء، والفوائد المستنبطة منه، ودرجته ومصادره، بالعربية والإنجليزية. تصفّح حسب الموضوع أو ابحث في النصوص."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "حديث واحد من موسوعة الأحاديث النبوية، لكلٍّ منها معناه كما بيّنه العلماء، والفوائد المستنبطة منه، ودرجته ومصادره، بالعربية والإنجليزية. تصفّح حسب الموضوع أو ابحث في النصوص."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "حديثان من موسوعة الأحاديث النبوية، لكلٍّ منها معناه كما بيّنه العلماء، والفوائد المستنبطة منه، ودرجته ومصادره، بالعربية والإنجليزية. تصفّح حسب الموضوع أو ابحث في النصوص."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld أحاديث من موسوعة الأحاديث النبوية، لكلٍّ منها معناه كما بيّنه العلماء، والفوائد المستنبطة منه، ودرجته ومصادره، بالعربية والإنجليزية. تصفّح حسب الموضوع أو ابحث في النصوص."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld حديثًا من موسوعة الأحاديث النبوية، لكلٍّ منها معناه كما بيّنه العلماء، والفوائد المستنبطة منه، ودرجته ومصادره، بالعربية والإنجليزية. تصفّح حسب الموضوع أو ابحث في النصوص."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld حديث من موسوعة الأحاديث النبوية، لكلٍّ منها معناه كما بيّنه العلماء، والفوائد المستنبطة منه، ودرجته ومصادره، بالعربية والإنجليزية. تصفّح حسب الموضوع أو ابحث في النصوص."
                }
              }
            }
          }
        },
        "ur" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "حدیث انسائیکلوپیڈیا سے ایک روایت، علماء کے بیان کردہ مفہوم، اس سے حاصل ہونے والے فوائد، اس کے درجے اور مآخذ کے ساتھ، عربی اور انگریزی میں۔ موضوع کے لحاظ سے دیکھیں یا متن میں تلاش کریں۔"
                }
              },
              "other" : {
