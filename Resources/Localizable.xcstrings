          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقام اور اطلاعات کی اجازت دیں"
          }
        }
      }
    },
    "Allow Notifications" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
