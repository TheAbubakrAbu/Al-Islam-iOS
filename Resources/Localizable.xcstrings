    "‎ي and و" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الياء والواو"
          }
        }
      }
    },
    "‎يَا is two counts, سِينْ is six. Two different lengths inside one two-letter opening." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يَا بحركتين، وسِينْ بستّ. مقداران مختلفان في فاتحة من حرفين."
          }
        }
      }
    },
    "‎ٱدۡخُلِي  ->  udkhulee" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
