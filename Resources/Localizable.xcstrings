    "Studying the diagrams silently and expecting the letters to follow." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أن تتأمّل الرسوم صامتًا وتنتظر أن تستقيم لك الحروف."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خاکوں کو خاموشی سے دیکھتے رہنا اور یہ توقع رکھنا کہ حروف خود ٹھیک ہو جائیں گے۔"
          }
        }
