    "Home Screen and Lock Screen, Edit Widget" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشاشة الرئيسية وشاشة القفل، تعديل الأداة"
          }
