      }
    },
    "Nagging Start Time & Repeat Interval" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقت بدء التذكير المتكرر وفاصل التكرار"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بار بار یاد دہانی کے آغاز کا وقت اور تکرار کا وقفہ"
