    "Sorry, I couldn’t choose a surah right now." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عذرًا، تعذّر عليّ اختيار سورة الآن."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "معذرت، ابھی کوئی سورت منتخب نہیں ہو سکی۔"
          }
        }
      }
    },
    "Sorry, I don’t have a last listened surah yet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عذرًا، لا توجد سورة استمعت إليها بعد."
          }
        },
        "ur" : {
