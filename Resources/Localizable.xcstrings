    },
    "Where a narration has been graded, the grade shows under it with the scholar's name, and stays visible whichever language you hide." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حيثما حُكم على الرواية، تظهر درجتها تحتها مع اسم العالِم، وتبقى ظاهرة أيًّا كانت اللغة التي تخفيها."
          }
        }
      }
    },
    "Where a shaddah comes from" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من أين تأتي الشدة"
          }
        }
      }
    },
