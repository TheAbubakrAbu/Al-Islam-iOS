    },
    "The three madd letters on one consonant. Two counts each, identical in length." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حروف المدّ الثلاثة على حرف واحد. حركتان لكلّ واحد، متساوية في المقدار."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک ہی حرف پر تینوں حروفِ مد۔ ہر ایک دو حرکات، اور لمبائی میں بالکل برابر۔"
          }
        }
      }
    },
    "The three madds on one letter. Two counts each, and all three the same length." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المدود الثلاثة على حرف واحد. حركتان لكل واحد منها، والثلاثة على مقدار واحد."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک ہی حرف پر تینوں مدود۔ ہر ایک دو حرکات، اور تینوں کی لمبائی ایک۔"
          }
        }
