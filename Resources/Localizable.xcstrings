    "Pull down for a fresh location" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب للأسفل لتحديث الموقع"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نیا مقام لینے کے لیے نیچے کھینچیں"
          }
        }
      }
    },
    "Pull the corners of the mouth back and keep the tongue high and forward." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب طرفي الشفتين إلى الخلف وأبقِ اللسان مرتفعًا إلى الأمام."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہونٹوں کے کنارے پیچھے کھینچیں اور زبان کو اوپر اور آگے رکھیں۔"
          }
        }
      }
    },
    "Pulling down on the Adhan tab takes a new GPS fix, which is what corrects the city after a flight." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السحب للأسفل في تبويب الأذان يحدّد موقعك من جديد عبر GPS، وهذا ما يصحّح المدينة بعد رحلة جوية."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اذان ٹیب پر نیچے کھینچنے سے GPS سے نیا مقام لیا جاتا ہے، اور یہی پرواز کے بعد شہر کو درست کرتا ہے۔"
          }
        }
      }
    },
