    "Modern print" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الطباعة الحديثة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جدید طباعت"
          }
        }
      }
    },
    "Modern print keeps them apart with the two dots under the yaa. The mushaf writes a final yaa without its dots as well, so the shape alone cannot tell you which letter it is. The marks around it can, every time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفرّق الطباعة الحديثة بينهما بالنقطتين تحت الياء. أما المصحف فيكتب الياء الأخيرة بلا نقاط أيضًا، فلا يدلّك الشكل وحده على الحرف. لكن العلامات حوله تدلّك، في كل مرة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جدید طباعت یاء کے نیچے دو نقطوں سے انہیں الگ رکھتی ہے۔ مصحف آخری یاء کو بھی بغیر نقطوں کے لکھتا ہے، اس لیے صرف شکل سے پتہ نہیں چلتا کہ یہ کون سا حرف ہے۔ اس کے آس پاس کی علامات ہر بار بتا دیتی ہیں۔"
          }
        }
      }
    },
