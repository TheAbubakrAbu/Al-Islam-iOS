    },
    "Stop here" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوقف هنا"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہاں وقف کریں"
          }
        }
      }
    },
    "Stop here and you say dabhaa with a clean two-count alif and no n-sound." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قِف هنا فتقول ضَبْحَا بألف نقيّة بحركتين من غير صوت نون."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہاں وقف کریں تو ضَبْحَا کہیں گے: صاف دو حرکات کی الف، اور نون کی کوئی آواز نہیں۔"
          }
        }
      }
    },
    "Stop here on its own and you have said do not come near the prayer. That is what قبيح means." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا وقفت هنا وحده فقد قلت لا تقربوا الصلاة. وهذا هو معنى الوقف القبيح."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہاں تنہا ٹھہریں گے تو آپ نے یہ کہہ دیا: نماز کے قریب نہ جاؤ۔ وقفِ قبیح کا مطلب یہی ہے۔"
          }
        }
      }
    },
    "Stop here: the ya glides, then holds for your chosen 2, 4 or 6 counts." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قِف هنا: تنزلق الياء ثمّ تُمدّ بما اخترته من حركتين أو أربع أو ستّ."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہاں وقف کریں: یاء پھسلتی ہے، پھر آپ کی چنی ہوئی 2، 4 یا 6 حرکات تک کھنچتی ہے۔"
          }
        }
      }
    },
    "Stop it as رَحۡمَهۡ, with a silent ه." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف عليها رَحۡمَهۡ بهاء ساكنة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس پر رَحۡمَهۡ کہہ کر وقف کریں، ساکن ه کے ساتھ۔"
          }
        }
      }
    },
    "Stop listening" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاف الاستماع"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سننا بند کریں"
          }
        }
      }
    },
    "Stop on a word ending in fatha-tanween and the n-sound is replaced by a two-count alif. Only fatha-tanween, only at a stop, and never on a ta marbutah." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا وقفت على كلمة منتهية بتنوين فتح أُبدل صوت النون ألفًا بحركتين. وذلك في تنوين الفتح وحده، وعند الوقف وحده، ولا يكون على تاء مربوطة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنوینِ فتح پر ختم ہونے والے کلمے پر وقف کریں تو نون کی آواز کی جگہ دو حرکات کی الف آ جاتی ہے۔ یہ صرف تنوینِ فتح میں ہے، صرف وقف کی حالت میں، اور تاء مربوطہ پر کبھی نہیں۔"
          }
        }
      }
    },
    "Stop on a word ending in ة and it closes into a soft \"h\", exactly like a haa." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا وقفت على كلمة آخرها ة نُطقت هاءً ساكنة خفيفة، كالهاء تمامًا."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ة پر ختم ہونے والے لفظ پر وقف کریں تو یہ بند ہو کر نرم “h” بن جاتی ہے، بالکل ہا کی طرح۔"
          }
        }
      }
    },
    "Stop on each: an alif, a bare sukoon, a sakin ha. Three different endings." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قِف على كلّ واحدة: ألف، ثمّ سكون مجرّد، ثمّ هاء ساكنة. ثلاث نهايات مختلفة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر ایک پر وقف کریں: پہلے الف، پھر سادہ سکون، پھر ہائے ساکن۔ تین مختلف اختتام۔"
          }
        }
      }
    },
    "Stop on it as كُفُوَا, with a clear two-count alif." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف عليها كُفُوَا بألف بينة مقدارها حركتان."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس پر كُفُوَا کہہ کر وقف کریں، دو حرکات کی واضح الف کے ساتھ۔"
          }
        }
      }
    },
    "Stop on the first word and the madd reverts to a plain two counts." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فإذا وقفت على الكلمة الأولى رجع المدّ إلى حركتين مجرّدتين."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پہلے کلمے پر وقف کریں تو مد لوٹ کر سادہ 2 حرکات رہ جاتی ہے۔"
          }
        }
      }
    },
    "Stop on the last consonant with a plain sukoon." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قِف على الحرف الأخير بسكون مجرّد."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخری حرف پر سادہ سکون کے ساتھ وقف کریں۔"
          }
        }
      }
    },
    "Stop on the word" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أن تقف على الكلمة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس کلمے پر وقف کریں"
          }
        }
      }
    },
    "Stop on ٱلۡعَٰلَمِينَ at two counts, then four, then six. All three are permitted; the sitting gets one of them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قف على ٱلۡعَٰلَمِينَ بحركتين، ثم بأربع، ثم بست. الثلاثة جائزة، والجلسة تأخذ واحدًا منها."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ٱلۡعَٰلَمِينَ پر دو حرکات کے ساتھ وقف کریں، پھر چار کے ساتھ، پھر چھ کے ساتھ۔ تینوں جائز ہیں؛ نشست ان میں سے ایک لیتی ہے۔"
          }
        }
      }
    },
    "Stop or Flow" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انحباس الصوت أو جريانه"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رکنا یا بہنا"
          }
        }
      }
    },
    "Stop playing" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاف التشغيل"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "چلانا روکیں"
          }
