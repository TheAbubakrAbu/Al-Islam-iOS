          "stringUnit" : {
            "state" : "translated",
            "value" : "حركة رفيقة منضبطة: انطباق تامّ لكلٍّ منهما، محكم في الباء ورفيق في الميم."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نرم، قابو میں حرکت: دونوں کے لیے ہونٹ پوری طرح بند ہوں، ب کے لیے مضبوطی سے اور م کے لیے ہلکے سے۔"
          }
        }
      }
    },
    "Genuine Muttasil Written With A Dagger Alif" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدّ متّصل حقيقي مكتوب بألف خنجرية"
          }
        },
        "ur" : {
          "stringUnit" : {
