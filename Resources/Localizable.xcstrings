      }
    },
    "%@ has begun" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دخل وقت %@"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ کا وقت شروع ہو گیا"
          }
        }
      }
    },
    "%@ has no separate ayah-by-ayah recording in this style, so individual ayahs and custom ranges will play in %@. Full-surah playback is unaffected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس لـ%@ تسجيل منفصل آيةً آيةً بهذا الأسلوب، لذا ستُشغَّل الآيات المفردة والنطاقات المخصّصة بتلاوة %@. ولا يتأثر تشغيل السورة كاملة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ کی اس انداز میں آیت بہ آیت الگ ریکارڈنگ نہیں ہے، اس لیے الگ الگ آیات اور حسبِ منشا حصے %@ کی آواز میں چلیں گے۔ پوری سورت چلانے پر اس کا کوئی اثر نہیں پڑتا۔"
          }
        }
      }
    },
    "%@ has no verse-by-verse recordings. Individual ayahs and custom ranges will play in %@. This won't be asked again for this reciter." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس لدى %@ تسجيلات آية بآية. ستُشغَّل الآيات المفردة والنطاقات المخصّصة بصوت %@. لن يُطرح هذا السؤال مجددًا لهذا القارئ."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ کی آیت بہ آیت ریکارڈنگ موجود نہیں۔ الگ الگ آیات اور حسبِ منشا حصے %@ کی آواز میں چلیں گے۔ اس قاری کے لیے یہ دوبارہ نہیں پوچھا جائے گا۔"
          }
        }
      }
    },
    "%@ has not recorded this surah. Please choose another reciter for it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يسجّل %@ هذه السورة. يُرجى اختيار قارئ آخر لها."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ نے یہ سورت ریکارڈ نہیں کی۔ براہِ کرم اس کے لیے کوئی دوسرا قاری منتخب کریں۔"
          }
        }
      }
    },
    "%@ highlights" : {
