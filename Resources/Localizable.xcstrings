          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دھند"
          }
        }
      }
    },
    "Fold the controls away" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطوِ عناصر التحكم"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کنٹرولز سمیٹ دیں"
          }
        }
      }
    },
    "Follow along in the mushaf while listening" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تابع في المصحف وأنت تسمع"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنتے ہوئے مصحف میں ساتھ ساتھ دیکھیں"
          }
        }
      }
    },
    "Follow in the mushaf, recite along, and imitate what you hear." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تابع في المصحف، واقرأ مع القارئ، وحاكِ ما تسمع."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مصحف میں ساتھ دیکھیں، ساتھ ساتھ پڑھیں، اور جو سنیں اس کی نقل کریں۔"
          }
        }
      }
    },
    "Follow your mosque's clock" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتبع توقيت مسجدك"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنی مسجد کی گھڑی کے مطابق چلیں"
          }
        }
      }
    },
    "Followed by a hamzah" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعده همزة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس کے بعد ہمزہ ہو"
          }
        }
      }
    },
    "Followed by a permanent sukun" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعده سكون لازم"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس کے بعد لازمی سکون ہو"
          }
        }
      }
    },
    "Following the Prophet" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتباع النبي ﷺ"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نبی کریم ﷺ کی پیروی"
          }
        }
      }
    },
    "Following the Quran" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتباع القرآن"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قرآن کی پیروی"
          }
        }
      }
    },
    "Following the Sunnah" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتّباع السنة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنت کی پیروی"
          }
        }
      }
    },
    "Following the Sunnah: The Prophet Muhammad ﷺ encouraged reciting the Quran beautifully, saying: \"He is not one of us who does not recite the Quran melodiously\" (Sahih al-Bukhari 7527). By learning Tajweed, you honor his teachings and example." : {
      "extractionState" : "stale"
    },
    "Follows previous letter" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتبع الحرف السابق"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پچھلے حرف کے تابع"
          }
        }
      }
    },
    "Follows the Letter Before" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تابع لما قبله"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پچھلے حرف کے تابع"
          }
        }
      }
    },
    "Fonts, tajweed, reciters, themes" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخطوط، التجويد، القرّاء، الموضوعات"
          }
        },
        "ur" : {
