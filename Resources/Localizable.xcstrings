    "Sealing the lips during ikhfa shafawi, so مْ + ب comes out as a complete mim followed by a ب." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إطباق الشفتين في الإخفاء الشفوي، فتخرج الميم الساكنة قبل الباء ميمًا كاملة يتبعها باء."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اخفائے شفوی میں ہونٹ پورے بند کر دینا، جس سے مْ + ب پوری میم اور اس کے بعد ب بن کر نکلتا ہے۔"
          }
        }
      }
    },
    "Sealing the lips hard for م, or opening them before the ghunnah has finished." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إحكام إطباق الشفتين للميم، أو فتحهما قبل تمام الغنة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "م کے لیے ہونٹوں کو زور سے بھینچنا، یا غنّہ پوری ہونے سے پہلے ہونٹ کھول دینا۔"
          }
        }
      }
    },
