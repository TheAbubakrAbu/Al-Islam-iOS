    "Confirm: Use %@" : {
      "extractionState" : "stale"
    },
    "Confusing arid with lazim erases the distinction between a borrowed cause and a permanent one, which is the whole architecture of the chapter." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخلط بين العارض واللازم يمحو الفرق بين السبب المستعار والسبب اللازم، وهو بناء هذا الباب كلّه."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عارض اور لازم کو خلط ملط کرنا مستعار سبب اور دائمی سبب کا فرق مٹا دیتا ہے، اور اسی فرق پر اس پورے باب کی بنیاد ہے۔"
          }
        }
      }
    },
    "Confusions are almost always with an adjacent row, not a distant one." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخلط يقع مع الصف المجاور في الغالب، لا مع صف بعيد."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خلط تقریباً ہمیشہ ساتھ والی سطر سے ہوتا ہے، دور کی سطر سے نہیں۔"
          }
        }
      }
    },
    "Conjunction" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
