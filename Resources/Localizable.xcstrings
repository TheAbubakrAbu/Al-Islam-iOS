    },
    "%@ in this chapter" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحديث %@ في هذا الباب"
          }
        }
      }
    },
    "%@ in three words from the Quran: at the start, in the middle and at the end of a word, tinted where it sits. Tap a word to select it, then press play to hear it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ في ثلاث كلمات من القرآن: في أول الكلمة ووسطها وآخرها، ملوّنًا في موضعه. اضغط كلمة لتحديدها، ثم اضغط زر التشغيل لسماعها."
          }
        }
      }
    },
    "%@ in words from the Quran, tinted where it sits. Tap a word to select it, then press play to hear it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ في كلمات من القرآن، ملوّنًا في موضعه. اضغط كلمة لتحديدها، ثم اضغط زر التشغيل لسماعها."
          }
        }
      }
    },
    "%@ is %@ (%@) at the end of a word." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ شكلُ %@ (%@) في آخر الكلمة."
          }
        }
      }
    },
    "%@ is %@ (%@) at the start of a word." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ شكلُ %@ (%@) في أول الكلمة."
          }
        }
