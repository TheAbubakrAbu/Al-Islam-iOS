    },
    "Starts the full adhan when the app is open at prayer time, or opened within five minutes of it. Off, a Play button appears instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ الأذان كاملًا إذا كان التطبيق مفتوحًا وقت الصلاة، أو فُتح خلال خمس دقائق منه. وعند الإيقاف، يظهر زر تشغيل بدلًا من ذلك."
          }
        }
      }
    },
    "State" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
