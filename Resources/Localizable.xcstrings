    "Mecca" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مكة المكرمة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مکہ مکرمہ"
          }
        }
      }
    },
    "Mechanically this is the same act as muttasil: a held vowel, then a hamzah. The only difference is bookkeeping, and it is the bookkeeping that changes the ruling. Here the madd letter finishes one word and the hamzah opens the next, so the two are separable: stop between them and the cause is simply gone." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا من حيث العمل هو نفسه عمل المتّصل: صوت ممدود ثمّ همزة. والفرق الوحيد فرق في الحساب، وهذا الحساب هو الذي يغيّر الحكم. فحرف المدّ هنا يُنهي كلمةً والهمزة تفتتح التي بعدها، فهما قابلان للانفصال: قِف بينهما يزُلِ السبب من أصله."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عمل کے اعتبار سے یہ بالکل وہی کام ہے جو مدِ متصل میں ہے: ایک کھینچی ہوئی آواز، پھر ہمزہ۔ فرق صرف حساب کا ہے، اور یہی حساب حکم بدل دیتا ہے۔ یہاں حرفِ مد ایک کلمے کو ختم کرتا ہے اور ہمزہ اگلے کلمے کو کھولتا ہے، اس لیے دونوں الگ ہو سکتے ہیں: ان کے درمیان وقف کر لیں تو سبب ہی باقی نہیں رہتا۔"
          }
        }
      }
    },
    "Medium" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متوسط"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "درمیانہ"
          }
        }
      }
    },
    "Meem Sakinah" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الميم الساكنة"
