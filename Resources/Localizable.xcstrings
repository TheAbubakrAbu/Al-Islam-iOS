    },
    "%@ reads every ayah as Hafs" : {
      "extractionState" : "stale"
    },
    "%@ reads no word differently from Hafs at the places checked; the differences are in the marks, which the Qiraat Explorer shows in full." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يخالف %@ حفصًا في أي كلمة في المواضع التي فُحصت؛ فالاختلاف في العلامات، ويعرضها مستكشف القراءات كاملة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جن مقامات کی جانچ کی گئی وہاں %@ کی قراءت میں کوئی لفظ حفص سے مختلف نہیں؛ فرق علامات میں ہے، جنہیں قراءات ایکسپلورر مکمل طور پر دکھاتا ہے۔"
          }
        }
      }
    },
    "%@ reads this surah exactly as Hafs does" : {
      "extractionState" : "stale"
    },
    "%@ shows you where to begin based on your answer. It stays on this %@, and you can change it in Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرشدك تطبيق %@ إلى نقطة البداية بحسب إجابتك. تبقى إجابتك على هذا الـ %@، ويمكنك تغييرها في الإعدادات."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ایپ آپ کے جواب کی بنیاد پر بتاتی ہے کہ کہاں سے شروع کریں۔ آپ کا جواب اسی %@ پر رہتا ہے، اور آپ اسے ترتیبات میں بدل سکتے ہیں۔"
          }
        }
      }
    },
    "%@ sky colors, top and bottom" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألوان سماء %@، الأعلى والأسفل"
