    },
    "Your note will appear next to the Quran, the Words of Allah ﷻ. Please keep it dignified and beneficial." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستظهر ملاحظتك بجوار القرآن، كلام الله ﷻ. فاحرص على أن تكون لائقة ونافعة."
          }
        },
        "ur" : {
          "stringUnit" : {
