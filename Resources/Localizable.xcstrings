    "%lld words across %lld ayahs. The tinted word carries the root; roots come from the Quranic Arabic Corpus via the Quranic Universal Library." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld من الكلمات في %lld من الآيات. الكلمة الملوّنة تحمل الجذر؛ والجذور من مدوّنة القرآن العربية عبر المكتبة القرآنية الشاملة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld آیات میں %1$lld الفاظ۔ رنگین لفظ میں یہ مادہ ہے؛ مادے «قرآنی عربی کارپس» سے، قرآنی یونیورسل لائبریری کے ذریعے لیے گئے ہیں۔"
