    "Assuming that an error which does not change the meaning must be lahn khafi." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الظن بأن الخطأ الذي لا يغيّر المعنى لحن خفي بالضرورة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ سمجھ لینا کہ جو غلطی معنیٰ نہیں بدلتی وہ لازماً لحنِ خفی ہے۔"
