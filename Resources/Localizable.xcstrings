    "Read on and the madd goes straight back to two counts." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فإذا وصلت رجع المدّ إلى حركتين مباشرة."
          }
