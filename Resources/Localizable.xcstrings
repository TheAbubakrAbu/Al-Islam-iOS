            "value" : "سنیں"
          }
        }
      }
    },
    "Hear it again" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع مرة أخرى"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دوبارہ سنیں"
          }
        }
      }
    },
    "Hear it, choose what was said" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع، واختر ما قيل"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنیں، اور جو کہا گیا وہ منتخب کریں"
          }
        }
      }
    },
    "Hear the Arabic read aloud" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع إلى النص العربي مقروءًا"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عربی متن بلند آواز سے سنیں"
          }
        }
      }
    },
    "Hear the pair back to back" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع إلى الحرفين متتاليين"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دونوں حروف ایک کے بعد ایک سنیں"
          }
        }
      }
    },
    "Hear the verse as %@ reads it" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع إلى الآية كما يقرؤها %@"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آیت اس طرح سنیں جیسے %@ پڑھتے ہیں"
          }
        }
      }
    },
    "Heaviest of the seven" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أثقل السبعة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سات میں سب سے بھاری"
          }
        }
      }
    },
    "Heavily hide noon or tanween with nasal." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إخفاء النون الساكنة أو التنوين مع غنة مفخّمة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نون ساکن یا تنوین کا پُر غنہ کے ساتھ اخفاء۔"
          }
        }
      }
    },
    "Heaviness" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التفخيم"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفخیم"
          }
        }
      }
    },
    "Heaviness comes from two qualities: the tongue rising (isti’la), and for the heaviest four, clamping as well (itbaq)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينشأ التفخيم من صفتين: الاستعلاء، وهو ارتفاع اللسان، ويزيد عليه في الأحرف الأربعة الأشدّ تفخيمًا الإطباقُ."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پُر ہونا دو صفات سے آتا ہے: زبان کا اوپر اٹھنا (استعلاء)، اور سب سے زیادہ پُر چار حروف میں اس کے ساتھ زبان کا تالو سے چپک جانا بھی (اطباق)۔"
          }
        }
      }
    },
    "Heaviness in Arabic is produced at the back of the tongue. Extra pressure at the front only produces a forceful ت, which is still a ت." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التفخيم في العربية إنما يُصنع بأقصى اللسان. وزيادة الضغط بالمقدم لا تنتج إلا تاء قوية، وهي تاء على كل حال."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عربی میں تفخیم اقصائے لسان سے پیدا ہوتی ہے۔ زبان کے اگلے حصے سے زیادہ دباؤ صرف ایک زوردار ت نکالتا ہے، اور وہ ہے تو ت ہی۔"
          }
        }
      }
    },
    "Heaviness never spreads to the letters around it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ولا يسري التفخيم البتة إلى الحروف التي حوله."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفخیم اپنے ارد گرد کے حروف میں کبھی سرایت نہیں کرتی۔"
          }
        }
      }
    },
    "Heavy" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفخّمة"
          }
