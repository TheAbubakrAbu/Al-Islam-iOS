      }
    },
    "The Legend button stays in the reader with the colors off, so you can turn this back on from there" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى زر مفتاح الألوان في شاشة القراءة والألوان متوقفة، لتتمكن من إعادة تشغيلها من هناك"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رنگ آف ہونے پر بھی رنگوں کی کلید کا بٹن پڑھنے کی اسکرین میں رہتا ہے، اس لیے آپ اسے وہیں سے دوبارہ آن کر سکتے ہیں"
          }
        }
      }
    },
    "The Legend pill does two things" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زر «مفتاح الألوان» له وظيفتان"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«رنگوں کی کلید» کا بٹن دو کام کرتا ہے"
          }
        }
      }
    },
    "The Legend pill while nothing on the page is coloured (both readers)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شارة «مفتاح الألوان» ما دام لا شيء ملوّنًا في الصفحة (في وضعَي القراءة)"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«رنگوں کی کلید» کا لیبل، جب صفحے پر کچھ بھی رنگین نہ ہو (دونوں موڈز میں)"
