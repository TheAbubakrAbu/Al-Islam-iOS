                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "صُلّيت الصلوات كلها، اثنتان منها متأخرتان."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "صُلّيت الصلوات كلها، %lld منها متأخرة."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "صُلّيت الصلوات كلها، %lld منها متأخرة."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "صُلّيت الصلوات كلها، %lld منها متأخرة."
                }
              }
            }
          }
        },
        "ur" : {
          "variations" : {
