    "Default tashkeel is the small set of marks you can supply WITHOUT knowing the word, because the letters themselves force them. It is the first thing a reader leans on in unmarked text." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التشكيل الافتراضي هو القدر اليسير من الحركات الذي تستطيع وضعه دون أن تعرف الكلمة، لأن الحروف نفسها تفرضه. وهو أول ما يعتمد عليه القارئ في النص غير المشكول."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طے شدہ اعراب علامات کا وہ چھوٹا سا مجموعہ ہے جو آپ لفظ کو جانے بغیر لگا سکتے ہیں، کیونکہ حروف خود انہیں لازم کرتے ہیں۔ بغیر اعراب کے متن میں قاری سب سے پہلے انہی کا سہارا لیتا ہے۔"
          }
        }
      }
    },
