    "‎ن and ر from neighbouring points on the same gum, the ر a little further in and heavy here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النون والراء من موضعين متجاورين على اللثة نفسها، والراء أدخل قليلا ومفخمة هنا."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ن اور ر ایک ہی مسوڑھے کے دو پڑوسی مقامات سے، ر ذرا اندر کی طرف اور یہاں مفخم۔"
          }
        }
      }
    },
    "‎ن and م" : {
