    },
    "Cause: a sukoon or shaddah that is part of the word, not one you created by stopping." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السبب: سكون أو شدّة من بنية الكلمة، لا سكونٌ أحدثته بوقفك."
          }
        }
      }
    },
    "Cause: a sukoon that exists only because you stopped." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السبب: سكونٌ لا وجود له إلّا لأنّك وقفت."
          }
        }
      }
    },
    "Celebration marking the end of Ramadan; fasting is prohibited on this day; encouraged to fast 6 days in Shawwal." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احتفال بنهاية رمضان؛ يحرم الصيام في هذا اليوم؛ ويُستحب صيام ستة أيام من شوال."
          }
        }
      },
      "extractionState" : "stale"
    },
    "Celebration of ending the fast" : {
      "localizations" : {
        "ar" : {
