    "Now across the exits, which is where the mix-ups live: deepest, then middle. Keep a hand on your throat." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "والآن بين المخرجين، وهناك يقع الالتباس: الأقصى ثم الأوسط. وأبقِ يدك على حلقك."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اب دونوں مخرجوں کے آر پار، اور التباس یہیں ہوتا ہے: پہلے اقصیٰ، پھر وسط۔ گلے پر ہاتھ رکھے رکھیں۔"
          }
        }
      }
    },
    "Now playing" : {
