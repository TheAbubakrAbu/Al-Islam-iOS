        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قریب ترین نتائج پہلے: ابواب کے عنوانات اور مکمل الفاظ اوپر آتے ہیں، اور ہجے کی غلطی نظر انداز کی جاتی ہے"
          }
        }
      }
    },
    "Closest matches first: whole words rank higher, and spelling is forgiven" : {
