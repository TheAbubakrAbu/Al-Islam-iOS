        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الباء والميم تنطبق لهما الشفتان والواو تستدير لا غير"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ب اور م بند ہوتے ہیں، و صرف گول ہوتی ہے"
