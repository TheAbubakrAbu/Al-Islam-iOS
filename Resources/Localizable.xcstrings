    "This cannot be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسے واپس نہیں کیا جا سکتا۔"
          }
        }
      }
    },
    "This category is fixed and not flexible like optional madd forms, so it should be given its full required length whenever encountered. Its consistency is one of the easiest ways to stabilize rhythm and accuracy in longer passages." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا النوع ثابت لا يقبل المرونة كأنواع المد الجائزة، فينبغي إعطاؤه مقداره الواجب كاملًا حيثما ورد. وثباته من أيسر الطرق لضبط الإيقاع والدقة في المقاطع الطويلة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ قسم مقررہ ہے اور جائز مد کی صورتوں کی طرح لچک دار نہیں، اس لیے جہاں بھی آئے اسے اس کی پوری لازمی مقدار دی جائے۔ اس کی یکسانیت لمبے حصوں میں آہنگ اور درستی کو مستحکم رکھنے کے آسان ترین طریقوں میں سے ایک ہے۔"
          }
        }
      }
    },
