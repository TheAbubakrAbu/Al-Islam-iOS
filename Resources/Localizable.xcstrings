        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے گھر کا شہر %@ ہے۔ آپ نیچے «سفر کی ترتیبات» پر ٹیپ کر کے اسے بدل سکتے ہیں۔"
          }
        }
      }
    },
    "Your home city, favorite locations and the prayer times computed from them are never backed up: your location goes no further than it has to. A restored device finds its own." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُنسخ مدينة إقامتك ومواقعك المفضّلة ومواقيت الصلاة المحسوبة منها احتياطيًا أبدًا: فموقعك لا يذهب أبعد مما يلزم. ويحدّد الجهاز المستعاد موقعه بنفسه."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا رہائشی شہر، پسندیدہ مقامات اور ان سے حساب کیے گئے نماز کے اوقات کا کبھی بیک اپ نہیں لیا جاتا: آپ کا مقام ضرورت سے آگے نہیں جاتا۔ بحال شدہ ڈیوائس اپنا مقام خود معلوم کرتی ہے۔"
          }
        }
      }
    },
    "Your iCloud storage is full." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سعة تخزين iCloud ممتلئة."
