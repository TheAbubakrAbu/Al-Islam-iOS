    },
    "Surahs will be shown as a mushaf, one page at a time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُعرض السور كمصحف، صفحةً تلو صفحة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سورتیں مصحف کی صورت میں، ایک وقت میں ایک صفحہ، دکھائی جائیں گی۔"
          }
        }
      }
    },
    "Surahs will be shown as a scrolling list of ayahs." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُعرض السور كقائمة آيات قابلة للتمرير."
          }
        },
        "ur" : {
