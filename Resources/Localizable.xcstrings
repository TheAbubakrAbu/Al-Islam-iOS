            "state" : "translated",
            "value" : "%@ شكلُ %@ (%@) في وسط الكلمة."
          }
        }
      }
    },
    "%@ is %@, joined." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ هي %@ موصولةً."
          }
