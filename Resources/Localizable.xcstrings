    "Prayer calculation switched to %@ for %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحوّل حساب مواقيت الصلاة إلى %@ في %@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ کے لیے نماز کا حساب %1$@ پر بدل دیا گیا۔"
          }
        }
      }
    },
    "Prayer notifications are marked Time Sensitive. Allow Time Sensitive notifications for %@ in a Focus such as Sleep or Do Not Disturb and they still come through." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إشعارات الصلاة معلَّمة بأنها حساسة للوقت. اسمح بالإشعارات الحساسة للوقت لتطبيق %@ في وضع تركيز مثل «النوم» أو «عدم الإزعاج»، فتصلك رغم ذلك."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نماز کی اطلاعات «وقت کے لحاظ سے حساس» کے طور پر نشان زد ہیں۔ نیند یا «ڈسٹرب نہ کریں» جیسے فوکس میں %@ ایپ کے لیے وقت کے لحاظ سے حساس اطلاعات کی اجازت دیں، تو وہ پھر بھی موصول ہوتی رہیں گی۔"
          }
        }
      }
    },
    "Prayer notifications are marked Time Sensitive. Allow Time Sensitive notifications for %@ in your Focus and they come through Sleep and Do Not Disturb." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إشعارات الصلاة مصنّفة «حساسة للوقت». اسمح بالإشعارات الحساسة للوقت من تطبيق %@ في وضع التركيز لتصلك أثناء «النوم» و«عدم الإزعاج»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نماز کی اطلاعات «وقت کے لحاظ سے حساس» کے طور پر نشان زد ہیں۔ اپنے فوکس میں %@ ایپ کے لیے وقت کے لحاظ سے حساس اطلاعات کی اجازت دیں تو یہ «نیند» اور «ڈسٹرب نہ کریں» کے دوران بھی آپ تک پہنچیں گی۔"
          }
        }
      }
    },
