        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہی احکام ترتیب سے، سبق بہ سبق، سننے کے لیے آیات اور ہر سبق میں ایک کوئز کے ساتھ"
          }
        }
      }
    },
    "The same shape one letter over. بَلْ must still be audible after the cut." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
