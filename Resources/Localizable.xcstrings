    "%@ will be removed from your bookmarks, and its note will be deleted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستتم إزالة %@ من علاماتك، وحذف الملاحظة المرفقة."
