    },
    "Your best yet. The clock only counts right answers, so slow down for the hard ones." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أفضل نتيجة لك حتى الآن. الساعة تحسب الإجابات الصحيحة فقط، فتمهّل في الأسئلة الصعبة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اب تک کا آپ کا بہترین نتیجہ۔ گھڑی صرف درست جوابات گنتی ہے، اس لیے مشکل سوالوں پر رفتار دھیمی کر لیں۔"
          }
        }
      }
    },
    "Your bookmarks, prayer tracker, khatm, tasbih counts, journal and settings, kept in your own iCloud so a new %@ can pick up where this one left off. Optional, and off until you turn it on. Your location is never included." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "علاماتك ومتتبّع الصلاة والختمة وعدّاد التسبيح ويومياتك وإعداداتك، محفوظة في حسابك على iCloud ليتابع أي %@ جديد من حيث توقف هذا. اختياري ومتوقف حتى تشغّله. لا يُضمَّن موقعك أبدًا."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے بک مارکس، نماز ٹریکر، ختمِ قرآن، تسبیح کی گنتی، ڈائری اور ترتیبات، آپ کے اپنے iCloud میں محفوظ، تاکہ نیا %@ وہیں سے شروع کر سکے جہاں یہ چھوڑ رہا ہے۔ اختیاری، اور جب تک آپ آن نہ کریں آف رہتا ہے۔ آپ کا مقام کبھی شامل نہیں کیا جاتا۔"
          }
        }
      }
    },
    "Your breath runs out in the middle of a phrase. Where do you begin again?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع نفَسك في وسط العبارة. فمن أين تبتدئ؟"
