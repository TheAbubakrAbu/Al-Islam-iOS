    },
    "Twelve letters, a few millimetres apart, at the tip of the tongue." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اثنا عشر حرفًا من طرف اللسان، لا يفصل بين مخارجها إلا بضعة ملّيمترات."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زبان کی نوک پر بارہ حروف، جن کے درمیان چند ملی میٹر کا فاصلہ ہے۔"
          }
        }
      }
    },
    "Twenty Juz'" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
