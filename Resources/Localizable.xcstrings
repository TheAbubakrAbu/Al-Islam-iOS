    "Ego is what stops a reciter from hearing a correction, and the fine points are where good recitation becomes excellent." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الكِبر هو ما يمنع القارئ من سماع التصحيح، وفي الدقائق تنتقل التلاوة من الجودة إلى الإتقان."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انا ہی قاری کو اصلاح سننے سے روکتی ہے، اور باریکیوں ہی میں اچھی تلاوت بہترین بنتی ہے۔"
          }
        }
      }
    },
    "Egypt" : {
