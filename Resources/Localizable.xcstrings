            "value" : "في انتظار موقعك…"
          }
        }
      }
    },
    "Waiting to be in a perfect state, and so going days without reading." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتظار الحال الكاملة، فتمضي الأيام بلا قراءة."
          }
