    "Qalun and Warsh" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قالون وورش"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قالون اور ورش"
          }
        }
      }
    },
    "Qalun was Nafi's stepson and read on him for some twenty years. The name Qalun was given to him by Nafi himself and is said to be a Byzantine word for 'good', a comment on the quality of his recitation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كان قالون ربيبَ نافع، وقرأ عليه نحو عشرين سنة. ونافع نفسه هو الذي لقّبه بقالون، ويقال إنها كلمة رومية معناها «جيّد»، إشارةً إلى جودة قراءته."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قالون نافع کے سوتیلے بیٹے تھے اور تقریباً بیس برس ان سے قراءت پڑھتے رہے۔ قالون کا لقب خود نافع نے انہیں دیا، اور کہا جاتا ہے کہ یہ رومی (بازنطینی) زبان کا لفظ ہے جس کا معنی “عمدہ” ہے، جو ان کی تلاوت کی عمدگی کی طرف اشارہ ہے۔"
          }
        }
      }
    },
