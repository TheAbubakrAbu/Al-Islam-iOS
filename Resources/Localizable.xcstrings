    "Hams (فحثه شخص سكت) lets the breath run; jahr blocks it. Test with a hand at the mouth." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الهمس (فحثه شخص سكت) يجري معه النفس، والجهر يحبسه. واختبره بكفك أمام فمك."
          }
        },
