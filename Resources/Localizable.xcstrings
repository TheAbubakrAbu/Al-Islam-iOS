            "state" : "translated",
            "value" : "أي حركة قبل الاسم ترقق اللام؟"
          }
        }
      }
    },
    "Which vowel does the hamza of the definite article take when you begin on it?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بأيّ حركة تُبتدأ همزة لام التعريف؟"
          }
        }
      }
    },
    "Which vowel when you start" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بأيّ حركة تبتدئ"
          }
        }
      }
    },
    "Which way of handling the basmalah between two surahs is not read?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
