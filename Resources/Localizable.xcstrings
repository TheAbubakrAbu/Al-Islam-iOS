    "Tiny Madd Marks" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "علامات المد الصغيرة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مد کی چھوٹی علامات"
          }
        }
      }
    },
    "Tiny madd marks such as small alif, small waw, and small ya indicate a natural two-count vowel sound written as miniature tashkeel." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "علامات المد الصغيرة، كالألف الصغيرة والواو الصغيرة والياء الصغيرة، تدل على مد طبيعي بحركتين يُكتب تشكيلًا صغيرًا."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مد کی چھوٹی علامات، جیسے چھوٹا الف، چھوٹا واؤ اور چھوٹی یاء، دو حرکات کے مدِ طبعی کو ظاہر کرتی ہیں جو چھوٹے اعراب کی صورت میں لکھا جاتا ہے۔"
          }
        }
      }
    },
    "Tiny natural elongation marks" : {
      "localizations" : {
