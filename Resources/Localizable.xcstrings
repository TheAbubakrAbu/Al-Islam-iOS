    "Sun: the doubled letter is held as any shadda is held. Moon: no hold at all." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشمسية: يُمسك الحرف المشدّد كما تُمسك كل شدة. والقمرية: لا إمساك فيها."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شمسیہ: مشدّد حرف کو اتنا ہی روکیں جتنا ہر تشدید کو روکا جاتا ہے۔ قمریہ: کوئی ٹھہراؤ نہیں۔"
          }
        }
