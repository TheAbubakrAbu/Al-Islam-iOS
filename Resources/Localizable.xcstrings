    "Does God Exist?" : {},
    "Does the back of the tongue rise toward the roof of the mouth?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل يرتفع أقصى اللسان نحو الحنك الأعلى؟"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیا زبان کی جڑ تالو کی طرف اٹھتی ہے؟"
          }
        }
      }
    },
    "Does the breath keep flowing while the letter is said?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل يجري النفَس عند النطق بالحرف؟"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیا حرف ادا کرتے وقت سانس جاری رہتی ہے؟"
