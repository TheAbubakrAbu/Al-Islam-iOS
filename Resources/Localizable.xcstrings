    "the hyphen marks the article; before a sun letter the laam is silent and the letter doubles" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشَّرطة تُعلِّم أداة التعريف؛ وقبل الحرف الشمسي لا تُنطق اللام ويتضاعف الحرف"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہائفن حرفِ تعریف کو ظاہر کرتا ہے؛ شمسی حرف سے پہلے لام خاموش رہتا ہے اور حرف دوہرا ہو جاتا ہے"
          }
        }
      }
    },
    "the inline page and juz dividers" : {
      "extractionState" : "manual",
