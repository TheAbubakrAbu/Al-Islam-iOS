    },
    "A break turns a connected reading into an unintended stop." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القطع يحول الوصل إلى وقف غير مقصود."
