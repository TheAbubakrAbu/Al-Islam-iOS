    "Hanafi Asr: " : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عصر الحنفية: "
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حنفی عصر: "
          }
        }
      }
    },
    "Hanafi Calculation for Asr" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحساب الحنفي للعصر"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عصر کے لیے حنفی حساب"
          }
        }
      }
    },
    "Hanafi Madhab (Asr Time)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المذهب الحنفي (وقت العصر)"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حنفی مسلک (عصر کا وقت)"
          }
        }
      }
    },
    "Hand flat on the front of the neck. The ه leaves the throat relaxed; the ح squeezes it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع كفك على مقدم العنق. الهاء تترك الحلق مسترخيا، والحاء تضيّقه."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہتھیلی گلے کے اگلے حصے پر رکھیں۔ ه حلق کو ڈھیلا چھوڑتا ہے، ح اسے دباتا ہے۔"
          }
        }
      }
    },
    "Haptic Feedback" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاستجابة اللمسية"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لمسی ردِعمل"
          }
        }
      }
    },
    "Haqq is what the letter is on its own: where it is made, and the attributes that never leave it. The other three exist only because of a neighbouring letter, which makes them mustahaqq." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحق ما يكون عليه الحرف في نفسه: موضع خروجه، والصفات التي لا تفارقه. والثلاثة الأخرى لا توجد إلا بسبب حرف مجاور، فهي مستحق."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حق وہ ہے جو حرف بذاتِ خود ہے: اس کا مخرج، اور وہ صفات جو اس سے کبھی جدا نہیں ہوتیں۔ باقی تینوں صرف پڑوسی حرف کی وجہ سے وجود میں آتی ہیں، اسی لیے وہ مستحق ہیں۔"
          }
        }
      }
    },
    "Harfi mukhaffaf" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرفيّ مخفّف"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرفی مخفّف"
          }
        }
      }
    },
    "Harfi mukhaffaf on its own: قَافْ, six counts, then the pause mark." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرفي مخفّف منفردًا: قَافْ، ستّ حركات، ثمّ علامة الوقف."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اکیلا حرفی مخفّف: قَافْ، چھ حرکات، پھر وقف کی علامت۔"
          }
        }
      }
    },
    "Harfi muthaqqal" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرفيّ مثقّل"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرفی مثقّل"
          }
        }
      }
    },
    "Harfi muthaqqal on the لَامْ and harfi mukhaffaf on the مِيمْ" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرفي مثقّل في لَامْ وحرفي مخفّف في مِيمْ"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لَامْ میں حرفی مثقّل اور مِيمْ میں حرفی مخفّف"
          }
        }
      }
    },
    "Harun" : {},
    "Has a sukun, or" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساكنًا، أو"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساکن ہو، یا"
          }
        }
      }
    },
    "Hasan" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حسن"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حسن"
          }
        }
      }
    },
    "Have Madd" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وفيها مدّ"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جن میں مد ہے"
          }
        }
      }
    },
    "Have you prayed %@ yet? It began %lldm ago in %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل صلّيت %@؟ دخل وقتها قبل %lld د في %@"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیا آپ نے %1$@ پڑھ لی؟ %3$@ میں اس کا وقت %2$lld منٹ پہلے شروع ہوا"
          }
        }
      }
    },
    "Haze" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضباب خفيف"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دھندلاہٹ"
          }
        }
      }
    },
    "He and Ibn Dhakwan are the two narrators through whom the reading of Sham survived, at a distance of roughly a century from the imam himself." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هو وابن ذكوان الراويان اللذان بقيت بهما قراءة أهل الشام، وبينهما وبين الإمام نفسه نحو قرن من الزمان."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ اور ابن ذکوان وہ دو راوی ہیں جن کے ذریعے شام کی قراءت باقی رہی، جبکہ ان کے اور خود امام کے درمیان تقریباً ایک صدی کا فاصلہ ہے۔"
          }
        }
      }
    },
    "He and Ruways are the pair through whom the ninth reading is preserved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هو ورويس الراويان اللذان حُفظت بهما القراءة التاسعة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ اور رویس وہ دو راوی ہیں جن کے ذریعے نویں قراءت محفوظ ہے۔"
          }
        }
      }
    },
    "He became the imam of recitation in Egypt, and from there his narration spread west across North Africa, where it is still the dominant recitation and the one the printed Maghribi mushafs are set in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صار إمام الإقراء في مصر، ومنها انتشرت روايته غربًا في شمال أفريقيا، وما زالت هناك الرواية الغالبة، وعليها تُطبع المصاحف المغربية."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ مصر میں قراءت کے امام بنے، اور وہاں سے ان کی روایت مغرب کی طرف شمالی افریقہ میں پھیلی، جہاں یہ آج بھی غالب تلاوت ہے اور اہلِ مغرب کے مطبوعہ مصاحف اسی روایت پر چھپتے ہیں۔"
          }
        }
      }
    },
    "He died a generation before most of the other narrators of the twenty, which is consistent with Abu Ja'far being among the earliest of the ten imams." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُوفّي قبل أكثر الرواة العشرين الآخرين بجيل، وهذا موافق لكون أبي جعفر من أقدم الأئمة العشرة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ان کی وفات بیس راویوں میں سے اکثر دوسرے راویوں سے ایک نسل پہلے ہوئی، جو اس بات سے مطابقت رکھتا ہے کہ ابو جعفر دس ائمہ میں سب سے قدیم ائمہ میں سے تھے۔"
          }
        }
      }
    },
    "He died in 292 AH, the latest death date among the twenty narrators, which makes him the closing link of the whole canonical chain." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُوفّي سنة ٢٩٢ هـ، فهو آخر الرواة العشرين وفاةً، وبذلك كان الحلقة الأخيرة في سلسلة الرواة المعتمدين كلها."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ان کی وفات 292ھ میں ہوئی، جو بیس راویوں میں سب سے آخری تاریخِ وفات ہے، اور یوں وہ پورے معتمد سلسلے کی آخری کڑی ہیں۔"
          }
        }
      }
    },
    "He is Allah, none is worthy of worship except Him. Knower of the seen and unseen, the Most Compassionate, the Most Merciful." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "﴿هُوَ اللَّهُ الَّذِي لَا إِلَٰهَ إِلَّا هُوَ عَالِمُ الْغَيْبِ وَالشَّهَادَةِ هُوَ الرَّحْمَٰنُ الرَّحِيمُ﴾"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہی اللہ ہے جس کے سوا کوئی عبادت کے لائق نہیں۔ ظاہر اور غیب کا جاننے والا، نہایت مہربان، بے حد رحم کرنے والا۔"
          }
        }
      }
    },
    "He is Allah, the Creator, the Originator, the Fashioner. To Him belong the Most Beautiful Names; all in the heavens and earth glorify Him." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "﴿هُوَ اللَّهُ الْخَالِقُ الْبَارِئُ الْمُصَوِّرُ لَهُ الْأَسْمَاءُ الْحُسْنَىٰ يُسَبِّحُ لَهُ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ الْعَزِيزُ الْحَكِيمُ﴾"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہی اللہ ہے، پیدا کرنے والا، وجود بخشنے والا، صورت گری کرنے والا۔ سب سے اچھے نام اسی کے ہیں؛ آسمانوں اور زمین میں جو کچھ ہے سب اس کی تسبیح کرتے ہیں۔"
          }
        }
      }
    },
    "He is Allah: the King, the Most Holy, the Source of Peace, the Granter of Security, the Guardian, the Almighty, the Compeller, the Supreme. Exalted is He above all partners." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "﴿هُوَ اللَّهُ الَّذِي لَا إِلَٰهَ إِلَّا هُوَ الْمَلِكُ الْقُدُّوسُ السَّلَامُ الْمُؤْمِنُ الْمُهَيْمِنُ الْعَزِيزُ الْجَبَّارُ الْمُتَكَبِّرُ سُبْحَانَ اللَّهِ عَمَّا يُشْرِكُونَ﴾"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہی اللہ ہے: بادشاہ، نہایت پاک، سلامتی کا سرچشمہ، امن دینے والا، نگہبان، غالب، زبردست، بڑائی والا۔ وہ ہر شریک سے پاک اور بلند ہے۔"
          }
        }
      }
    },
    "He is also credited with being among the first to gather the variant readings systematically and travel in search of them, which makes him a foundational figure for the science itself and not only a link in one chain." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ويُذكر أيضًا أنه من أوائل من جمع القراءات جمعًا منهجيًّا ورحل في طلبها، فهو من أعلام تأسيس هذا العلم نفسه، لا مجرد حلقة في سند واحد."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انہیں ان اولین لوگوں میں بھی شمار کیا جاتا ہے جنہوں نے قراءات کو باقاعدہ طور پر جمع کیا اور ان کی تلاش میں سفر کیے، اس لیے وہ صرف ایک سند کی کڑی ہی نہیں بلکہ خود اس علم کی بنیاد رکھنے والی شخصیات میں سے ہیں۔"
          }
        }
      }
    },
    "He is reported to have gone deaf in later life and yet to have continued correcting students by watching their lips, a story the biographers tell to convey how completely he had internalised the reading." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رُوي أنه أصابه الصمم في آخر عمره، فكان مع ذلك يردّ على تلاميذه خطأهم بالنظر إلى شفاههم، وهي قصة يرويها أصحاب التراجم دلالةً على تمام إتقانه للقراءة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "روایت ہے کہ آخری عمر میں ان کی سماعت جاتی رہی، پھر بھی وہ شاگردوں کے ہونٹ دیکھ کر ان کی غلطیاں درست کرتے رہے؛ سوانح نگار یہ واقعہ یہ بتانے کے لیے بیان کرتے ہیں کہ قراءت ان کے اندر کس قدر رچ بس گئی تھی۔"
          }
        }
      }
    },
    "He is stopping on the ت" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هو يقف على التاء"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ ت پر وقف کر رہا ہے"
          }
        }
      }
    },
    "He is the first of the two narrators of the tenth reading." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وهو أول راويَي القراءة العاشرة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ دسویں قراءت کے دو راویوں میں سے پہلے ہیں۔"
          }
        }
      }
    },
    "He is the seventh and last of the imams gathered by Ibn Mujahid into the famous seven." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وهو السابع والأخير من الأئمة الذين جمعهم ابن مجاهد في القراءات السبع المشهورة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ ان ائمہ میں ساتویں اور آخری ہیں جنہیں ابن مجاہد نے مشہور سات قراءات میں جمع کیا۔"
          }
        }
      }
    },
    "He is the teacher of Nafi al-Madani, which places him a generation above most of the ten: the Madinan reading that later spread through Qalun and Warsh was shaped by what Abu Ja'far taught. His own reading was added to the canonical ten by Ibn al-Jazari alongside Ya'qub and Khalaf." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وهو شيخ نافع المدني، وهذا يجعله فوق أكثر العشرة بجيل: فالقراءة المدنية التي انتشرت فيما بعد عن طريق قالون وورش تشكّلت مما أقرأه أبو جعفر. وقد ضمّ ابن الجزري قراءته، مع قراءتي يعقوب وخلف، إلى القراءات العشر المعتمدة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ نافع مدنی کے استاد ہیں، جس سے وہ دس میں سے اکثر ائمہ سے ایک نسل اوپر ٹھہرتے ہیں: وہ مدنی قراءت جو بعد میں قالون اور ورش کے ذریعے پھیلی، ابو جعفر کی تعلیم ہی سے تشکیل پائی۔ ابن الجزری نے ان کی اپنی قراءت کو یعقوب اور خلف کے ساتھ معتمد دس قراءات میں شامل کیا۔"
          }
        }
      }
    },
    "He learned from Abu ad-Darda and from al-Mughirah ibn Abi Shihab al-Makhzumi, who read on Uthman ibn Affan (may Allah be pleased with them). His is the reading of Sham, and it remained the recitation of Damascus for centuries." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخذ عن أبي الدرداء، وعن المغيرة بن أبي شهاب المخزومي الذي قرأ على عثمان بن عفان رضي الله عنهم. وقراءته قراءة أهل الشام، وبقيت قراءة دمشق قرونًا."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انہوں نے ابو الدرداء سے اور مغیرہ بن ابی شہاب المخزومی سے علم حاصل کیا، جنہوں نے عثمان بن عفان سے پڑھا تھا (رضی اللہ عنہم)۔ ان کی قراءت اہلِ شام کی قراءت ہے، اور یہ صدیوں تک دمشق کی تلاوت رہی۔"
          }
        }
      }
    },
    "He led the Kufan school of Arabic grammar and was appointed tutor to the sons of the Abbasid caliph, which carried his reading into the centre of scholarly life in Baghdad. His well-known grammatical debate with Sibawayh, the great Basran, marks the high point of the rivalry between the two schools." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تزعّم مدرسة الكوفة في النحو، واختير مؤدِّبًا لأبناء الخليفة العباسي، فحمل ذلك قراءته إلى قلب الحياة العلمية في بغداد. ومناظرته النحوية المشهورة مع سيبويه، عالم البصرة الكبير، تمثّل ذروة التنافس بين المدرستين."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ عربی نحو کے کوفی مکتب کے سربراہ تھے اور عباسی خلیفہ کے بیٹوں کے اتالیق مقرر ہوئے، جس سے ان کی قراءت بغداد کی علمی زندگی کے مرکز تک پہنچی۔ عظیم بصری عالم سیبویہ کے ساتھ ان کا مشہور نحوی مناظرہ دونوں مکاتب کی رقابت کا نقطۂ عروج ہے۔"
          }
        }
      }
    },
    "He lived to a great age and continued teaching almost to the end, which is part of why his narration is so widely attested." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عُمِّر طويلًا وظلّ يُقرئ إلى قرب وفاته، وذلك من أسباب كثرة طرق روايته."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انہوں نے بہت لمبی عمر پائی اور تقریباً آخر دم تک پڑھاتے رہے، اور یہ بھی ایک وجہ ہے کہ ان کی روایت اتنے وسیع پیمانے پر منقول ہے۔"
          }
        }
      }
    },
    "He loves: yaa on Haa" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«يحب»: الياء فوق الحاء"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«وہ محبت کرتا ہے»: حا کے اوپر یا"
          }
        }
      }
    },
    "He said: the alif is bare, so it is the long \"aa\"" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قال: الألف خالية من العلامات، فهي ألف المد «ـَا»"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس نے کہا: الف پر کوئی علامت نہیں، اس لیے یہ لمبی آواز «آ» ہے"
          }
        }
      }
    },
    "He says: a bare waaw after a damma, the long \"oo\"" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقول: واو خالية من العلامات بعد ضمة، فهي واو المد «ـُو»"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ کہتا ہے: پیش کے بعد بغیر علامت کا واؤ، لمبی آواز «اُو»"
          }
        }
      }
    },
    "He was a scholar of Baghdad known for his precision and his asceticism, and his selection was recognised as canonical because it met the same three conditions as the rest: the Uthmanic rasm, sound Arabic, and authentic mass transmission." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كان عالمًا من علماء بغداد، معروفًا بالضبط والزهد، وعُدّ اختياره من القراءات المعتمدة لأنه استوفى الشروط الثلاثة نفسها التي استوفتها سائر القراءات: موافقة الرسم العثماني، وموافقة العربية، وصحة النقل بالتواتر."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ بغداد کے ایک عالم تھے جو ضبط اور زہد کے لیے مشہور تھے، اور ان کا اختیار اس لیے معتمد تسلیم کیا گیا کہ وہ انہی تین شرائط پر پورا اترتا ہے جن پر باقی قراءات: رسمِ عثمانی کی موافقت، درست عربی، اور تواتر کے ساتھ مستند نقل۔"
          }
        }
      }
    },
    "He was asked which of his teachers he followed and answered that he took what at least two of them agreed upon, a method that gives his reading its particular authority, since it represents the settled practice of Madinah rather than one chain." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سُئل عمّن يتبع من شيوخه، فأجاب بأنه يأخذ بما اجتمع عليه اثنان منهم على الأقل، وهو منهج يمنح قراءته مكانتها الخاصة، لأنها تمثّل ما استقرّ عليه العمل في المدينة لا سندًا واحدًا."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ان سے پوچھا گیا کہ وہ اپنے کس استاد کی پیروی کرتے ہیں، تو انہوں نے جواب دیا کہ جس پر ان میں سے کم از کم دو متفق ہوں وہ اسے اختیار کرتے ہیں؛ یہ وہ طریقہ ہے جو ان کی قراءت کو خاص مقام دیتا ہے، کیونکہ یہ کسی ایک سند کے بجائے مدینہ منورہ کے طے شدہ عمل کی نمائندگی کرتی ہے۔"
          }
        }
      }
    },
    "He was described as the most beautiful reciter of his time, and as exacting to the point that he would not pass a student on until the recitation was exactly as he had received it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وُصف بأنه أحسن الناس صوتًا بالقرآن في زمانه، وبأنه شديد التدقيق، حتى إنه لا يجيز تلميذه حتى تكون قراءته كما تلقّاها هو تمامًا."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انہیں اپنے زمانے کا سب سے خوش آواز قاری کہا گیا، اور اتنا باریک بین کہ وہ کسی شاگرد کو اس وقت تک آگے نہ بڑھاتے جب تک اس کی تلاوت بالکل ویسی نہ ہو جاتی جیسی انہوں نے خود حاصل کی تھی۔"
          }
        }
      }
    },
    "He was famous for the breadth of his study: his notebooks are reported to have filled a house to the ceiling before he turned to worship and burned them, and he travelled widely to read on the Successors. His students Yahya al-Yazidi and then ad-Duri and as-Susi carried the reading forward." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اشتهر بسعة علمه: فقد رُوي أن دفاتره ملأت بيتًا إلى السقف، ثم أقبل على العبادة فأحرقها، ورحل كثيرًا ليقرأ على التابعين. وحمل قراءته من بعده تلميذه يحيى اليزيدي، ثم الدوري والسوسي."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ اپنے علم کی وسعت کے لیے مشہور تھے: روایت ہے کہ ان کی کاپیوں سے ایک گھر چھت تک بھر گیا تھا، پھر وہ عبادت کی طرف متوجہ ہوئے اور انہیں جلا دیا، اور انہوں نے تابعین سے پڑھنے کے لیے دور دور کے سفر کیے۔ ان کے شاگرد یحییٰ یزیدی اور پھر دوری اور سوسی نے اس قراءت کو آگے پہنچایا۔"
          }
        }
      }
    },
    "He was known for his piety as much as his recitation, and the reports about him dwell on how carefully he held to what he had been taught rather than on any innovation of his own." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عُرف بورعه كما عُرف بقراءته، والأخبار عنه تطيل الحديث عن شدة تمسّكه بما تلقّاه، لا عن شيء أحدثه من عنده."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ اپنی تلاوت کی طرح اپنے تقویٰ کے لیے بھی مشہور تھے، اور ان کے بارے میں روایات اس پر زور دیتی ہیں کہ جو کچھ انہیں سکھایا گیا تھا اس پر وہ کس قدر احتیاط سے قائم رہے، نہ کہ اپنی طرف سے کسی نئی بات پر۔"
          }
        }
      }
    },
    "He was known for long night prayer and for an exacting devotion to tajwid. His reading asks more of the reciter than most: the elongations are the longest of the ten, and the treatment of the hamzah when pausing is a subject studied on its own." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عُرف بطول قيام الليل وبعناية دقيقة بالتجويد. وقراءته تتطلب من القارئ أكثر مما تتطلبه أغلب القراءات: فمدوده أطول المدود في القراءات العشر، ومذهبه في الهمز عند الوقف بابٌ يُدرس وحده."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ طویل قیام اللیل اور تجوید سے گہری لگن کے لیے مشہور تھے۔ ان کی قراءت قاری سے اکثر قراءات کی نسبت زیادہ محنت مانگتی ہے: اس کے مد دس قراءات میں سب سے لمبے ہیں، اور وقف کی حالت میں ہمزہ کا طریقہ ایک الگ موضوع کے طور پر پڑھا جاتا ہے۔"
          }
        }
      }
    },
    "He was so cautious about transmitting that he is said to have wished he had never narrated at all rather than risk a single error, a scrupulousness that is itself part of why his narration is trusted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كان شديد التحرّي في النقل، حتى قيل إنه تمنّى لو أنه لم يروِ شيئًا أصلًا، خشية أن يقع في خطأ واحد، وهذا الورع نفسه من أسباب الثقة بروايته."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ روایت میں اس قدر محتاط تھے کہ کہا جاتا ہے کہ انہوں نے تمنا کی کہ کاش انہوں نے کچھ روایت ہی نہ کیا ہوتا، بجائے اس کے کہ ایک غلطی کا بھی خطرہ ہو؛ یہی احتیاط خود اس بات کی ایک وجہ ہے کہ ان کی روایت پر اعتماد کیا جاتا ہے۔"
          }
        }
      }
    },
    "He was the undisputed imam of recitation in Makkah in his generation, and people travelled to read on him. He is not to be confused with the much later Ibn Kathir the mufassir, who is a different scholar entirely." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كان إمام الإقراء في مكة في عصره بلا منازع، ورحل إليه الناس ليقرؤوا عليه. ولا ينبغي أن يُخلط بينه وبين ابن كثير المفسّر المتأخر عنه كثيرًا، فذاك عالم آخر تمامًا."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ اپنے زمانے میں مکہ مکرمہ میں قراءت کے بلا اختلاف امام تھے، اور لوگ ان سے پڑھنے کے لیے سفر کر کے آتے تھے۔ انہیں بہت بعد کے مفسر ابن کثیر نہ سمجھیں، وہ بالکل الگ عالم ہیں۔"
          }
        }
      }
    },
    "Head-to-Head" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقارنة ثنائية"
          }
        }
      },
      "extractionState" : "stale"
    },
    "Headers that do things" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عناوين تؤدي مهامّ"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کام کرنے والی سرخیاں"
          }
        }
      }
    },
    "Healing through the Quran" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشفاء بالقرآن"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قرآن کے ذریعے شفا"
          }
        }
      }
    },
    "Hear %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع إلى %@"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ کو سنیں"
          }
        }
      }
    },
    "Hear It" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنیں"
          }
        }
      }
    },
    "Hear a letter's name, choose the letter" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع إلى اسم الحرف واختره"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرف کا نام سنیں، اور حرف منتخب کریں"
          }
        }
      }
    },
    "Hear every letter" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع إلى كل حرف"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر حرف سنیں"
          }
        }
      }
    },
    "Hear every letter's name" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع إلى أسماء الحروف كلها"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر حرف کا نام سنیں"
          }
        }
      }
    },
    "Hear it" : {
      "localizations" : {
