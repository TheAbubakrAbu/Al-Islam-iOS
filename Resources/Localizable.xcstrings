    "Kasra before → yaa again, even though it looks identical" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبلها كسرة ← ياء أيضًا، وإن بدت مطابقة في الشكل"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پہلے زیر ← پھر بھی یا، اگرچہ شکل بالکل ایک جیسی ہے"
          }
        }
      }
    },
    "Kasra-tanween into ل in a short, easily-repeated ayah." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنوين كسر في اللام في آية قصيرة يسهل ترديدها."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایک چھوٹی اور آسانی سے دہرائی جانے والی آیت میں تنوینِ کسرہ (دو زیر) کا ل میں ادغام۔"
          }
        }
      }
    },
    "Kasrah" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كسرة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زیر"
          }
        }
      }
    },
    "Kasrah, fatha, damma. The vowel before the name is the whole rule: light, heavy, heavy." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كسرة، ففتحة، فضمة. والحركة التي قبل الاسم هي الحكم كله: ترقيق، تفخيم، تفخيم."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زیر، پھر زبر، پھر پیش۔ اسم سے پہلے کی حرکت ہی سارا حکم ہے: ترقیق، تفخیم، تفخیم۔"
          }
        }
      }
    },
    "Kasratayn: dropped" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنوين الكسر: يسقط"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دو زیر: ساقط"
