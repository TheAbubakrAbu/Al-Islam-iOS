    },
    "Suggested by Yaqeen Institute (“The Physical Miracles of Prophet Muhammad”), islammessage.org and mysalahmat.com, with their permission. The verses and narrations are quoted from the Quran and hadith collections bundled in this app." : {},
    "Suggested by islamreligion.com, Yaqeen Institute (Sh. Mohammad Elshinawy, “The Prophecies of Prophet Muhammad”) and Proving Islam, with their permission. The narrations themselves are quoted from the collections bundled in this app." : {},
    "Sughra" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صغرى"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صغریٰ"
          }
        }
      }
    },
    "Sughra then kubra. The second is more than twice the first." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صغرى ثمّ كبرى. والثانية أكثر من ضِعف الأولى."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پہلے صغریٰ، پھر کبریٰ۔ دوسرا پہلے سے دگنے سے بھی زیادہ ہے۔"
          }
        }
      }
    },
    "Sughra vs kubra" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصغرى والكبرى"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صغریٰ اور کبریٰ"
          }
        }
      }
    },
    "Sughra: 2 counts. Kubra, before a hamzat qat': 4 or 5, like munfasil." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصغرى: حركتان. والكبرى قبل همزة القطع: أربع أو خمس كالمنفصل."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صغریٰ: 2 حرکات۔ کبریٰ، ہمزۃ القطع سے پہلے: 4 یا 5، مدِ منفصل کی طرح۔"
          }
        }
      }
    },
    "Sughra: the sukoon is written. Kubra: the sukoon came from stopping." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصغرى سكونها مكتوب. والكبرى سكونها من الوقف."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صغریٰ: سکون لکھا ہوا ہے۔ کبریٰ: سکون وقف سے آیا ہے۔"
          }
        }
      }
    },
    "Sughra: the د is sakin inside the phrase and you read straight on into وَلَمۡ." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صغرى: الدال ساكنة داخل التركيب وتمضي منها إلى وَلَمۡ."
          }
        },
