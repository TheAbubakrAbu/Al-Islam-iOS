            "state" : "translated",
            "value" : "چھپایا جانے والا حرف نون یا تنوین تھا، یا پہلے ہی میم تھا"
          }
        }
      }
    },
    "Whether the letter carries a shaddah" : {
      "extractionState" : "manual",
      "localizations" : {
