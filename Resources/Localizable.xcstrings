      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرأ العلامة المرسومة على الكلمة التي بين يديك لا ذكرى الآية التي قبلها."
          }
        }
      }
    },
    "Read the mushaf" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرأ المصحف"
          }
        }
      }
    },
    "Read the noon clearly. Do not double the ي or و." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرأ النون مظهرة. ولا تُشدد الياء ولا الواو."
          }
        }
      }
    },
    "Read the page's rules once more, then come back for another round." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرأ قواعد الصفحة مرة أخرى، ثم عُد لجولة أخرى."
          }
        }
