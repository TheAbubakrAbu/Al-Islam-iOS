    "It always carries a shaddah" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنّه يحمل شدّة دائمًا"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس پر ہمیشہ تشدید ہوتی ہے"
