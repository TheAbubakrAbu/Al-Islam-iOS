          "stringUnit" : {
            "state" : "translated",
            "value" : "الإخوة لأم هم أولاد الأم وحدها. ولا يرثون إلا إذا لم يكن للميت فرع وارث ولا أب."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اخیافی بہن بھائی وہ ہیں جو صرف والدہ کی طرف سے شریک ہوں۔ یہ صرف اسی وقت وارث ہوتے ہیں جب نہ اولاد ہو اور نہ والد۔"
          }
        }
      }
    },
    "Maududi" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المودودي"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مودودی"
          }
        }
      }
    },
    "May Allah ﷻ reward you, protect you, and keep us all firm upon the truth." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جزاك الله ﷻ خيرًا وحفظك، وثبّتنا جميعًا على الحق."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اللہ ﷻ آپ کو جزائے خیر دے، آپ کی حفاظت فرمائے، اور ہم سب کو حق پر ثابت قدم رکھے۔"
          }
        }
      }
    },
    "Meaning" : {
