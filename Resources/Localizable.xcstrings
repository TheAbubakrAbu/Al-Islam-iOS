    "‎ب: full lip closure" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ب: انطباق الشفتين تمامًا"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
