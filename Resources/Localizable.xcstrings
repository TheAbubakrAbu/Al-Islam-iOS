        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الف کو حلق میں ہلکے سے جھٹکے کے ساتھ شروع کرنا، گویا اس کے ساتھ کوئی ہمزہ لگا ہوا ہو۔"
