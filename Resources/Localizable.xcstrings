    "Article not found" : {
      "extractionState" : "manual"
    },
    "Articles from miracles-of-quran.com, whose authors waive copyright on their own writing; quoted passages from other publishers are shortened to short attributed excerpts that link to the original. Brought to the app from Tilawa, by Jamil Hammoudeh, with permission." : {},
    "Articulation Exits" : {
