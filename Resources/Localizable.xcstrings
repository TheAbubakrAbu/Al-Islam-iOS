            "value" : "تعديل الملاحظة"
          }
        }
      }
    },
    "Edit surahs, ayahs, letters, khatm" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعديل السور والآيات والحروف والختمة"
          }
        }
      }
    },
    "Edition" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الطبعة"
          }
        }
      }
    },
    "Editorial" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحريري"
          }
        }
      }
    },
    "Ego is what stops a reciter from hearing a correction, and the fine points are where good recitation becomes excellent." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
