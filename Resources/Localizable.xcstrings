    },
    "At the lips" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من الشفتين"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہونٹوں سے"
          }
        }
      }
    },
    "At the roots of the upper front teeth: ط د ت (the nit'iyyah letters, النِّطعِيَّة). Just above the lower front teeth, whistling: ص س ز (the asaliyyah letters, الأَسَلِيَّة). Touching the edges of the upper front teeth: ظ ذ ث (the lithawiyyah letters, اللِّثَوِيَّة)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند أصول الثنايا العليا: ط د ت (وهي الحروف النِّطعِيَّة). وفوق الثنايا السفلى، مع الصفير: ص س ز (وهي الحروف الأَسَلِيَّة). وعند أطراف الثنايا العليا: ظ ذ ث (وهي الحروف اللِّثَوِيَّة)."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اوپر کے سامنے والے دانتوں کی جڑوں سے: ط د ت (یہ حروفِ نطعیہ ہیں، النِّطعِيَّة)۔ نیچے کے سامنے والے دانتوں کے ذرا اوپر سے، صفیر کے ساتھ: ص س ز (یہ حروفِ اسلیہ ہیں، الأَسَلِيَّة)۔ اوپر کے سامنے والے دانتوں کے کناروں کو چھوتے ہوئے: ظ ذ ث (یہ حروفِ لثویہ ہیں، اللِّثَوِيَّة)۔"
          }
        }
      }
    },
    "At the same moment as the letter" : {
      "extractionState" : "manual",
      "localizations" : {
