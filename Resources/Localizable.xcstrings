            "value" : "بعد الاستبدال يحمل هذا الـ %@ عمود النسخة الاحتياطية، بما في ذلك الإعدادات."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدیل کرنے کے بعد اس %@ میں بیک اپ والا کالم ہوتا ہے، ترتیبات سمیت۔"
          }
