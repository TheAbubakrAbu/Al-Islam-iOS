    },
    "Why is the lam of بَلۡ pronounced in 83:14 when it merges in 4:158?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لِمَ نُطقت لام بَلۡ في المطففين وأُدغمت في النساء؟"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بَلۡ کی لام 83:14 میں کیوں پڑھی جاتی ہے جبکہ 4:158 میں مدغم ہو جاتی ہے؟"
          }
        }
      }
    },
    "Why is the noon in دُنْيَا not merged into the ي?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لِمَ لا تُدغم النون في دُنْيَا في الياء؟"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دُنْيَا میں نون کا ادغام ي میں کیوں نہیں ہوتا؟"
          }
        }
      }
    },
    "Why is the ي in قُرَيۡشٍ not a madd letter?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم لم تكن الياء في قُرَيۡشٍ حرف مد؟"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قُرَيۡشٍ میں ي حرفِ مد کیوں نہیں؟"
          }
        }
      }
    },
    "Why is the ي of قُرَيۡشٍ not a madd letter?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لماذا لا تكون ياء قُرَيۡشٍ حرف مدّ؟"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قُرَيۡشٍ کی ي حرفِ مد کیوں نہیں؟"
          }
        }
      }
    },
    "Why is there a sakta at 75:27?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لِمَ كانت السكتة في ٧٥:٢٧؟"
