    },
    "Fifteen ۩ marks in this mushaf; the madhhabs count eleven, fourteen or fifteen of them." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في هذا المصحف خمس عشرة علامة ۩، والمذاهب تعدّ منها أحد عشر أو أربعة عشر أو خمسة عشر."
          }
        }
      }
    },
    "Fifteen: everything left after 6 idh-har, 6 idgham, and 1 iqlab" : {
      "extractionState" : "manual",
      "localizations" : {
