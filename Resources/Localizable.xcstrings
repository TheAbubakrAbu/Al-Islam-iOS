          }
        }
      }
    },
    "Transliteration, translations, and all English text apply only to default Hafs an Asim. For other riwayat, only the Arabic text is shown." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقتصر الكتابة اللاتينية والترجمات وكل النصوص الإنجليزية على رواية حفص عن عاصم الافتراضية. أما الروايات الأخرى فيُعرض نصها العربي فقط."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رومن تلفظ، تراجم اور تمام انگریزی متن صرف ڈیفالٹ حفص عن عاصم پر لاگو ہوتے ہیں۔ دوسری روایات میں صرف عربی متن دکھایا جاتا ہے۔"
          }
        }
      }
    },
    "Transmits Khalaf's own ikhtiyar, not Hamzah's reading." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينقل اختيار خلف نفسه، لا قراءة حمزة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خلف کا اپنا اختیار نقل کرتے ہیں، حمزہ کی قراءت نہیں۔"
          }
        }
      },
      "extractionState" : "stale"
    },
    "Transmits Khalaf's own ikhtiyar, not Hamzah's reading: the hamzah in full at a stop, no sakt, four counts on the madd." : {},
    "Transmitted from Umar ibn al-Khattab, Uthman ibn Affan, Ali ibn Abi Talib, Abdullah ibn Mas'ud, Abu Musa al-Ash'ari, Abdullah ibn Abbas, Ubayy ibn Ka'b, Zayd ibn Thabit, and Abu Hurayrah (may Allah be pleased with them)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نُقلت هذه القراءة عن عمر بن الخطاب، وعثمان بن عفان، وعلي بن أبي طالب، وعبد الله بن مسعود، وأبي موسى الأشعري، وعبد الله بن عباس، وأُبيّ بن كعب، وزيد بن ثابت، وأبي هريرة رضي الله عنهم."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ قراءت عمر بن خطاب، عثمان بن عفان، علی بن ابی طالب، عبداللہ بن مسعود، ابو موسیٰ اشعری، عبداللہ بن عباس، ابی بن کعب، زید بن ثابت اور ابو ہریرہ رضی اللہ عنہم سے منقول ہے۔"
          }
        }
      }
    },
    "Transmitted from Umar ibn al-Khattab, Uthman ibn Affan, Ali ibn Abi Talib, Ubayy ibn Ka'b, Zayd ibn Thabit, Abdullah ibn Mas'ud, Abdullah ibn Abbas, Abu Hurayrah, and Husayn ibn Ali (may Allah be pleased with them)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نُقلت هذه القراءة عن عمر بن الخطاب، وعثمان بن عفان، وعلي بن أبي طالب، وأُبيّ بن كعب، وزيد بن ثابت، وعبد الله بن مسعود، وعبد الله بن عباس، وأبي هريرة، والحسين بن علي رضي الله عنهم."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ قراءت عمر بن خطاب، عثمان بن عفان، علی بن ابی طالب، ابی بن کعب، زید بن ثابت، عبداللہ بن مسعود، عبداللہ بن عباس، ابو ہریرہ اور حسین بن علی رضی اللہ عنہم سے منقول ہے۔"
          }
        }
      }
    },
    "Transmitted from Umar ibn al-Khattab, Uthman ibn Affan, Ali ibn Abi Talib, Ubayy ibn Ka'b, Zayd ibn Thabit, Abdullah ibn Mas'ud, Abu Musa al-Ash'ari, Abdullah ibn Abbas, and Abu Hurayrah (may Allah be pleased with them)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نُقلت هذه القراءة عن عمر بن الخطاب، وعثمان بن عفان، وعلي بن أبي طالب، وأُبيّ بن كعب، وزيد بن ثابت، وعبد الله بن مسعود، وأبي موسى الأشعري، وعبد الله بن عباس، وأبي هريرة رضي الله عنهم."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ قراءت عمر بن خطاب، عثمان بن عفان، علی بن ابی طالب، ابی بن کعب، زید بن ثابت، عبداللہ بن مسعود، ابو موسیٰ اشعری، عبداللہ بن عباس اور ابو ہریرہ رضی اللہ عنہم سے منقول ہے۔"
          }
        }
      }
    },
