    "Back up to لَا تَقۡرَبُواْ so the prohibition is part of what you say." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارجع إلى لَا تَقۡرَبُواْ حتى يدخل النهي فيما تنطق به."
          }
        }
      }
    },
    "Back up. This direction is what teaches the ear the bottom two rungs." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
