        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نون کو بالکل چھوڑ دیں اور سیدھے مشدّد حرف سے شروع کریں۔"
          }
        }
      }
    },
    "Skipping the hum and going straight from noon to ب." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترك الغنة والانتقال من النون إلى الباء مباشرة."
