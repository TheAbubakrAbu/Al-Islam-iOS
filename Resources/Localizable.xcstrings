          "stringUnit" : {
            "state" : "translated",
            "value" : "أبو بكر شعبة بن عيّاش بن سالم الكوفي"
          }
        }
      }
    },
    "Abu Imarah Hamzah ibn Habib az-Zayyat at-Taymi" : {
