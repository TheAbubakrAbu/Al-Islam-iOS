      }
    },
    "The selected hadiths will be removed from your bookmarks, and their notes will be deleted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُزال الأحاديث المحددة من علاماتك، وستُحذف ملاحظاتها."
