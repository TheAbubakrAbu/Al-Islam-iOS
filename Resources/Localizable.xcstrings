    "Producing heaviness by lowering the voice into the chest." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحصيل الثقل بخفض الصوت إلى الصدر."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آواز کو سینے میں اتار کر بھاری پن پیدا کرنا۔"
          }
        }
      }
    },
    "Producing tafkheem by pushing the voice down into the chest." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحصيل التفخيم بخفض الصوت إلى الصدر."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آواز کو سینے میں دبا کر تفخیم پیدا کرنا۔"
          }
        }
      }
    },
    "Producing the ghunnah in the mouth: a nasal-sounding vowel rather than a nasal hum." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إخراج الغنة من الفم: حركة ذات رنين أنفي لا رنينا أنفيا."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غنّہ کو منہ سے نکالنا: ناک کی گونج کے بجائے ناک جیسی سنائی دینے والی حرکت۔"
          }
        }
      }
    },
    "Producing the hum in the throat, so it comes out as a growl instead of a nasal ring." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إخراج الغنّة من الحلق، فتخرج زمجرةً بدل الرنين الأنفيّ."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غنّہ کو حلق سے نکالنا، جس سے ناک کی گونج کے بجائے گرج جیسی آواز نکلتی ہے۔"
          }
        }
      }
    },
    "Profile" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملف الشخصي"
