    },
    "Concepts from the Quranic Arabic Corpus ontology (Kais Dukes), via the Quranic Universal Library." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفاهيم من أنطولوجيا مدوّنة القرآن العربية (كايس دوكس)، عبر المكتبة القرآنية الشاملة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قرآنی عربی کارپس کی آنٹولوجی (کائس ڈیوکس) سے تصورات، قرآنی یونیورسل لائبریری کے ذریعے۔"
          }
        }
      }
    },
