    },
    "The next prayer and its time, with today's Hijri date and your city" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصلاة التالية ووقتها، مع التاريخ الهجري لليوم ومدينتك"
