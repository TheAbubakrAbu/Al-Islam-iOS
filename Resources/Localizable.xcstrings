    "Pilgrimage, ihram, and sacred places" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النسك والإحرام والمشاعر المقدسة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حج، احرام اور مقدس مقامات"
          }
        }
      }
    },
    "Pilgrims begin the rites of Hajj, heading to Mina to start the sacred journey." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ الحجاج مناسك الحج بالتوجّه إلى منى إيذانًا ببدء الرحلة المباركة."
          }
        }
      },
      "extractionState" : "stale"
    },
    "Pilgrims set out for Mina" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
