            "state" : "translated",
            "value" : "آپ نے مشدّد حرف پر وقف کیا"
          }
        }
      }
    },
    "You stopped on a word printed with لا. What do you do?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقفت على كلمة مرسوم فوقها لا. فماذا تصنع؟"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ ایسے کلمے پر ٹھہر گئے جس پر لا لکھی ہے۔ اب کیا کریں؟"
          }
        }
      }
    },
    "You stopped on the letter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوقف على الحرف"
