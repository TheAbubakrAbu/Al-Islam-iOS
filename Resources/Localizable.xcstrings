      }
    },
    "Join the basmalah to the surah you just finished, then stop" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصل البسملة بالسورة التي فرغت منها، ثم الوقف"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بسملہ کو اُس سورت کے ساتھ ملا دیں جو ختم ہوئی، پھر ٹھہر جائیں"
          }
        }
      }
    },
    "Join the last ayah, the basmalah and the next surah in one breath" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصل آخر آية والبسملة وأول السورة التالية في نفس واحد"
          }
        },
