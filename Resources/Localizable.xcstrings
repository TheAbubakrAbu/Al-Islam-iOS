        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نہ اشتہارات، نہ فیس، نہ سبسکرپشن۔ صدقۂ جاریہ کے طور پر پیش ہے۔"
          }
        }
      }
    },
    "No articles match \"%@\". Try a different word, or browse the subjects." : {},
