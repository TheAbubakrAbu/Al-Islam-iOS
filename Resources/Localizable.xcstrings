    "Fall back to the letter after the tanween, which decides the rule in every printing." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ارجع إلى الحرف الذي بعد التنوين، فهو الذي يقرّر الحكم في كلّ مطبوع."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنوین کے بعد والے حرف پر لوٹ آئیے، ہر مطبوعہ نسخے میں حکم وہی طے کرتا ہے۔"
          }
        }
      }
    },
