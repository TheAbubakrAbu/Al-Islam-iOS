    "Shorten and combine while away" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القصر والجمع في السفر"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سفر میں قصر اور جمع"
          }
        }
      }
    },
    "Shorten it to two as you pick up speed" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقصره إلى حركتين كلما أسرعت"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفتار بڑھنے کے ساتھ اسے دو حرکات کر دیں"
          }
        }
      }
    },
    "Shortening a lazim that falls at the end of an ayah, where a stop is expected." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قصر مدٍّ لازم يقع في رأس الآية حيث يُتوقّع الوقف."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایسے مدِ لازم کو کم کرنا جو آیت کے آخر میں آئے، جہاں وقف کی توقع ہوتی ہے۔"
          }
        }
      }
    },
    "Shortening the hum on نّ or مّ when the line is moving quickly." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقص الغنة في نّ أو مّ عند الإسراع في السطر."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سطر تیزی سے پڑھتے ہوئے نّ یا مّ کی غنّہ کم کر دینا۔"
          }
        }
      }
    },
    "Shortening the madd when the line is long or the pace picks up." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقص المد إذا طال السطر أو أسرعت الوتيرة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سطر لمبی ہو یا رفتار تیز ہو جائے تو مد کو گھٹا دینا۔"
          }
        }
      }
    },
    "Shortens and combines the prayers while you are away from home." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقصر الصلوات ويجمعها ما دمت بعيدًا عن بلدك."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گھر سے دور ہونے کے دوران نمازوں کو قصر اور جمع کرتا ہے۔"
          }
        }
      }
    },
    "Shortens and combines the prayers while you are away from home. Turns on and off by itself; you can also set it here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقصر الصلوات ويجمعها ما دمت بعيدًا عن بلدك. يعمل ويتوقف من تلقاء نفسه، ويمكنك أيضًا ضبطه هنا."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گھر سے دور ہونے کے دوران نمازوں کو قصر اور جمع کرتا ہے۔ یہ خود بخود آن اور آف ہوتا ہے؛ آپ اسے یہاں بھی مقرر کر سکتے ہیں۔"
          }
        }
      }
    },
    "Shorter madd than Warsh, and a lighter touch overall." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدّ أقصر من مدّ ورش، وأداء أخفّ عمومًا."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ورش سے چھوٹا مد، اور مجموعی طور پر ہلکا انداز۔"
          }
        }
      },
      "extractionState" : "stale"
