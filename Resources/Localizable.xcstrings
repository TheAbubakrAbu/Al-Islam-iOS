    },
    "Hadr is defined as fast recitation with the rules intact, so a hadr that loses them has simply left the definition." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحدر معرَّف بأنه القراءة السريعة مع بقاء الأحكام، فالحدر الذي تضيع فيه قد خرج عن حدّه."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدر کی تعریف ہی یہ ہے کہ تیز تلاوت ہو اور احکام سلامت رہیں، تو جس حدر میں یہ ضائع ہو جائیں وہ اپنی حد سے نکل گیا۔"
          }
        }
      }
    },
    "Hafs" : {
      "localizations" : {
