    },
    "Where the letter is made, then the qualities it is said with. Tap a line to meet the rest of its family." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مخرج الحرف، ثم الصفات التي يُنطق بها. اضغط على سطر لتتعرّف على بقية عائلته."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حرف کا مخرج، پھر وہ صفات جن کے ساتھ وہ ادا ہوتا ہے۔ اس کے خاندان کے باقی حروف دیکھنے کے لیے کسی سطر پر ٹیپ کریں۔"
