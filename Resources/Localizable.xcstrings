    "Ask AI needs Apple Intelligence" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ميزة «اسأل الذكاء الاصطناعي» تتطلب Apple Intelligence"
          }
        }
      }
    },
    "Ask AI runs entirely on your device with Apple Intelligence, which needs iOS 26 on a supported iPhone with Apple Intelligence turned on in Settings." : {},
    "Ask AI runs with Apple Intelligence, which needs iOS 26 on a supported iPhone with Apple Intelligence turned on in Settings." : {
      "localizations" : {
