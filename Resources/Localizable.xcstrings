    "Small shifts in tongue position matter" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدنى تغيّر في موضع اللسان يغيّر الحرف"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زبان کی جگہ کا معمولی سا فرق بھی حرف بدل دیتا ہے"
          }
        }
      }
    },
    "Small shifts in tongue position matter. Aim for accuracy, not strength." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "والفروق اليسيرة في موضع اللسان مؤثّرة. فاطلب الدقة لا القوة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زبان کی جگہ میں معمولی تبدیلی بھی فرق ڈالتی ہے۔ زور نہیں، درستی کو مقصد بنائیں۔"
