    "Haa is a clear squeeze from the middle of the throat. Khaa is a rasp from the top of the throat, and heavy." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحاء ضغطٌ صافٍ من وسط الحلق. والخاء صوت خشن يخرج من أدنى الحلق، وهي مفخّمة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حا وسطِ حلق سے صاف دب کر نکلتا ہے۔ خا حلق کے اوپری حصے سے کھردری آواز کے ساتھ نکلتا ہے، اور پُر ہے۔"
          }
        }
      }
    },
