    },
    "Remembrance and dua after the obligatory prayers." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الذكر والدعاء بعد الصلوات المفروضة."
