    },
    "Sakin, they trap both the voice and the breath, so nothing would be heard" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لأنها إذا سكنت حبست الصوت والنفَس جميعًا فلا يُسمع منها شيء"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساکن ہوں تو آواز اور سانس دونوں روک لیتے ہیں، اس لیے کچھ سنائی نہ دیتا"
          }
        }
      }
    },
