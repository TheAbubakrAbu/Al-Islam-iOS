    "Ten Thousand Remembrances" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عشرة آلاف ذكر"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دس ہزار بار ذکر"
          }
