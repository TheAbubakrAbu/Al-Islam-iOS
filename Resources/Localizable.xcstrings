        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غنّہ، غنّہ، بند، بند۔ آخری دو ہی وہ ہیں جہاں قدم پھسلتا ہے۔"
          }
        }
      }
    },
