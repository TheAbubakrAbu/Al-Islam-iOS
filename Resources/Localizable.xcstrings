            }
          }
        },
        "ur" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "ایک وقت میں ایک موضوع روشن کیا جا سکتا ہے، اپنے مضمون کے رنگ میں، فہرست موڈ اور مصحف موڈ دونوں میں۔ اسے یہاں، «موضوع کے لحاظ سے دیکھیں» کے اوپر، یا «موضوعات کی ہائی لائٹ» میں بجھائیں، جہاں یہ بھی بتایا گیا ہے کہ ہر رنگ کا کیا مطلب ہے۔"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "ایک وقت میں زیادہ سے زیادہ %lld موضوعات روشن کیے جا سکتے ہیں، ہر ایک اپنے مضمون کے رنگ میں، فہرست موڈ اور مصحف موڈ دونوں میں۔ انہیں یہاں، «موضوع کے لحاظ سے دیکھیں» کے اوپر، یا «موضوعات کی ہائی لائٹ» میں بجھائیں، جہاں یہ بھی بتایا گیا ہے کہ ہر رنگ کا کیا مطلب ہے۔"
                }
