    "Hum, hum, close, close. The last two are the ones that slip." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غنّة، غنّة، إطباق، إطباق. والأخيران هما موضع الزلل."
