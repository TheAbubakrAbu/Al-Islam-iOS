    "Listening to skilled reciters" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاستماع إلى القرّاء المتقنين"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماہر قراء کو سننا"
          }
        }
      }
    },
    "Listening to skilled reciters is one of the most powerful ways to improve pronunciation and rhythm. Many students benefit from listening to classical Egyptian reciters such as Sheikh Muhammad Siddiq Al-Minshawi and Sheikh Mahmoud Khalil Al-Hussary." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الاستماع إلى القرّاء المتقنين من أقوى ما يحسّن به النطق والإيقاع. وينتفع كثير من الطلبة بالاستماع إلى قرّاء مصر الأوائل، كالشيخ محمد صدّيق المنشاوي والشيخ محمود خليل الحصري."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماہر قرّاء کو سننا ادائیگی اور آہنگ سنوارنے کے سب سے مؤثر ذریعوں میں سے ہے۔ بہت سے طالب علم مصر کے قدیم قرّاء، جیسے شیخ محمد صدیق المنشاوی اور شیخ محمود خلیل الحصری، کو سن کر فائدہ اٹھاتے ہیں۔"
          }
        }
      }
    },
