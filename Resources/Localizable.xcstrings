    "Stop the recitation" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاف التلاوة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تلاوت روکیں"
          }
        }
      }
    },
    "Stop where the meaning closes and where your breath needs it, and let صلى and ج pass most of the time." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قِف حيث يتمّ المعنى وحيث يحتاج نفَسك، ودع صلى والجيم تمرّان في أكثر الأحوال."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہاں ٹھہریں جہاں معنیٰ پورا ہو اور جہاں آپ کی سانس کو ضرورت ہو، اور صلى اور ج کو اکثر اوقات گزر جانے دیں۔"
          }
        }
      }
    },
    "Stop-based madd, including aarid and leen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مد سببه الوقف، ومنه العارض للسكون واللين."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقف کی بنا پر مد، بشمول مدِ عارض اور مدِ لین۔"
          }
        }
      }
    },
    "Stopped backing up to “%@” from this %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف النسخ الاحتياطي إلى «%@» من هذا الـ %@"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اس %2$@ سے “%1$@” میں بیک اپ لینا بند کر دیا"
          }
        }
      }
    },
    "Stopped on" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مع الوقف"
          }
