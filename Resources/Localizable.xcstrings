    },
    "Isha: %lld min after Maghrib" : {
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "العشاء: بعد المغرب بدقيقة واحدة"
                }
              },
              "two" : {
