    "Humming everything is the flattening habit the ranks lesson exists to break, and it usually starts here." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعميم الغنّة هو العادة التي تُسوّي الأداء وتذهب بتفاوته، وهي التي وُضع لها درس المراتب، وغالبًا ما تبدأ من هنا."
          }
        }
      }
    },
    "Humming identically before every one of the fifteen letters." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إجراء غنة واحدة قبل كل حرف من الأحرف الخمسة عشر."
          }
        }
      }
    },
    "Humming on every doubled letter, so رَبِّ comes out nasal." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التغنين في كل حرف مشدد، فتخرج رَبِّ بغنة."
          }
        }
      }
    },
    "Humming the familiar words like إِنَّ and ثُمَّ but missing the shaddah inside a long one such as لَتُسۡـَٔلُنَّ." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أن تُغِنَّ الكلمات المألوفة مثل إِنَّ وثُمَّ وتغفل عن الشدّة داخل كلمة طويلة مثل لَتُسۡـَٔلُنَّ."
          }
        }
      }
    },
