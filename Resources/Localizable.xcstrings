        }
      }
    },
    "Looks like an article and is not one. A verb, with a hamzat qat' and a clear lam." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشبه لام التعريف وليست منها. فعل بهمزة قطع ولام مظهرة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لامِ تعریف جیسی دکھتی ہے مگر ہے نہیں۔ یہ فعل ہے، ہمزۃ القطع کے ساتھ اور لام اظہار کے ساتھ۔"
          }
        }
      }
    },
