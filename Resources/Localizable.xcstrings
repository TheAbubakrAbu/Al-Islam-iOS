    },
    "Not Arabic letters: other languages added them to the Arabic script for sounds Arabic does not have. پ, چ, گ and ژ come from Persian, Urdu, Kurdish and Pashto (p, ch, g, zh); ڤ from Kurdish and Arabic dialect writing (v); ڭ from Uyghur, Kazakh and Ottoman Turkish (ng). Open a letter for where it is used." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليست حروفًا عربية: أضافتها لغات أخرى إلى الخط العربي لأصوات ليست في العربية. فـپ وچ وگ وژ من الفارسية والأردية والكردية والبشتوية (p وch وg وzh)؛ وڤ من الكردية ومن كتابة اللهجات العربية (v)؛ وڭ من الأويغورية والكازاخية والتركية العثمانية (ng). افتح الحرف لتعرف أين يُستعمل."
          }
        }
      }
    },
    "Not Lengthened" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُمدّ"
          }
        }
      }
    },
