      }
    },
    "Traveling mode automatically turned off at %@, near %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُوقف وضع السفر تلقائيًا في %@، قرب %@"
          }
