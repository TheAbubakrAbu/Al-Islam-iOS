        }
      }
    },
    "Two-lip contact gives a sound halfway between ف and p, which is not a letter of the language." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التقاء الشفتين يُخرج صوتا بين الفاء وصوت p الأعجمي، وليس هو حرفا من حروف اللغة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دونوں ہونٹ ملانے سے ف اور پ کے بیچ کی آواز نکلتی ہے، جو عربی کا کوئی حرف ہی نہیں۔"
          }
        }
      }
    },
    "Type" : {
      "extractionState" : "manual",
      "localizations" : {
