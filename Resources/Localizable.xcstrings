    "Is the back of the tongue raised?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أيستعلي أقصى اللسان؟"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیا اقصائے لسان بلند ہوتا ہے؟"
          }
        }
      }
    },
    "Is the laam of ٱلۡ read before this letter, or merged into it?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تُنطق لام ٱلۡ قبل هذا الحرف، أم تُدغم فيه؟"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیا ٱلۡ کا لام اس حرف سے پہلے پڑھا جاتا ہے، یا اس میں مدغم ہو جاتا ہے؟"
          }
        }
      }
    },
    "Is the letter made at the quick tip of the tongue or the lips?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل يخرج الحرف من طرف اللسان أو من الشفتين فيخفّ نطقه؟"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیا یہ حرف زبان کی پھرتیلی نوک یا ہونٹوں سے ادا ہوتا ہے؟"
          }
        }
      }
    },
    "Is the letter read full and heavy, or thin and light?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل يُقرأ الحرف مفخّمًا ممتلئًا، أم مرقّقًا نحيفًا؟"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیا حرف بھرا ہوا اور پُر پڑھا جاتا ہے، یا پتلا اور باریک؟"
          }
        }
      }
    },
    "Is the tinted letter alif maqSoorah or yaa?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل الحرف الملوّن ألف مقصورة أم ياء؟"
