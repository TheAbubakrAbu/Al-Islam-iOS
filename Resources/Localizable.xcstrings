    },
    "To find any exit: sukoon the letter after a vowelled hamza (أَقْ) and hear where the sound stops." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لتعرف أي مخرج: سكّن الحرف بعد همزة محركة (أَقْ) واسمع أين ينقطع الصوت."
          }
        }
      }
    },
    "To make a thing good, to bring it to its best form" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحسين الشيء وبلوغه أحسن صوره"
          }
