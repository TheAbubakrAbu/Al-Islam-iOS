    },
    "Nag Tone & Louder Last Call" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نغمة التذكير المتكرر والتذكير الأخير الأعلى صوتًا"
