    "All of today's prayer times as a compact list" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جميع مواقيت صلاة اليوم في قائمة مختصرة"
          }
        }
      }
    },
    "All of today's prayer times in a grid; the large size adds the current and next prayer" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جميع مواقيت صلاة اليوم في شبكة؛ ويضيف الحجم الكبير الصلاة الحالية والتالية"
          }
        }
      }
    },
    "All of today's prayer times, as a compact list over the current prayer's sky gradient" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جميع مواقيت صلاة اليوم في قائمة مختصرة على تدرّج سماء الصلاة الحالية"
          }
        }
      }
    },
    "All of today's prayer times, over the current prayer's sky gradient." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جميع مواقيت صلاة اليوم، على تدرّج سماء الصلاة الحالية."
          }
        }
      }
    },
    "All of today's prayers in one row, with the current one highlighted" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جميع صلوات اليوم في صف واحد، مع تمييز الصلاة الحالية"
          }
        }
      }
    },
