    "Mim Sakin & Ghunnah" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الميم الساكنة والغنّة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "میم ساکن اور غنّہ"
          }
        }
      }
    },
    "Mim sakin before ب. The lips touch and stay light while the nose carries two counts." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ميم ساكنة قبل الباء. تتلامس الشفتان وتبقيان خفيفتين بينما يحمل الخيشوم مقدار حركتين."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ب سے پہلے میم ساکن۔ ہونٹ چھو کر ہلکے رہتے ہیں اور ناک دو حرکات تک آواز اٹھائے رکھتی ہے۔"
          }
        }
      }
    },
    "Mim sakin before ن. Both letters are nasal, but nothing merges: idgham shafawi joins a mim only to a mim." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ميم ساكنة قبل النون. والحرفان كلاهما أغنّ، ومع ذلك لا إدغام: فالإدغام الشفوي لا يضمّ الميم إلا إلى ميم."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ن سے پہلے میم ساکن۔ دونوں حرف غنّہ والے ہیں، پھر بھی کچھ ادغام نہیں ہوتا: ادغامِ شفوی میم کو صرف میم سے ملاتا ہے۔"
          }
        }
      }
    },
    "Mina, the middle day of Tashriq\n12 Dhul-Hijjah 10 AH, March 632 CE" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "منى، أوسط أيام التشريق\n١٢ ذي الحجة ١٠ هـ، مارس ٦٣٢ م"
