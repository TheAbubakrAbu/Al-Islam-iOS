        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نون ساکن جو حلقی حرف سے پہلے ہو"
          }
        }
      }
    },
    "A noon sakin merged into the next word" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نون ساكنة أُدغمت في أول الكلمة التالية"
