    "Profiles, restore, what's included, backup file" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملفات الشخصية، الاستعادة، ما الذي يتضمّنه، ملف النسخة الاحتياطية"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پروفائلز، بحالی، کیا شامل ہے، بیک اپ فائل"
          }
        }
      }
    },
    "Progress comes from khatm marking: ayahs are marked as you read in the app, and you can review or reset them in Khatm mode on the Quran tab." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يأتي التقدّم من تعليم الختمة: تُعلَّم الآيات أثناء قراءتك في التطبيق، ويمكنك مراجعتها أو إعادة تعيينها في وضع الختمة في تبويب القرآن."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش رفت ختمِ قرآن کے نشانات سے آتی ہے: ایپ میں پڑھتے ہوئے آیات پر نشان لگتا جاتا ہے، اور آپ القرآن ٹیب پر ختمِ قرآن موڈ میں انہیں دیکھ یا ری سیٹ کر سکتے ہیں۔"
          }
        }
      }
    },
