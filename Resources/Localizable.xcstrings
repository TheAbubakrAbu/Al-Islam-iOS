    },
    "Majority position" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قول الجمهور"
          }
        }
      }
    },
    "Make Sujood" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "موضع السجدة"
          }
        }
      }
    },
    "Make dhikr a daily rhythm: morning, evening, after salah, before sleep, and during ordinary moments. A heart that remembers Allah does not stay empty." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اجعل الذكر وِردًا يوميًا: في الصباح والمساء، وبعد الصلاة، وقبل النوم، وفي لحظاتك العادية. فالقلب الذي يذكر الله لا يبقى فارغًا."
          }
        }
      }
    },
    "Make the ك lighter" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أن ترقق الكاف"
          }
        }
      }
    },
    "Makhaarij" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المخارج"
          }
        }
      }
    },
    "Makhaarij (Articulation)" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
