    "Stop answering" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إيقاف الإجابة"
          }
        }
      }
    },
    "Stop at One" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
