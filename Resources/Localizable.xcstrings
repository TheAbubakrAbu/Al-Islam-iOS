    "Roughly %@ to buy." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تكلفة شرائه نحو %@."
          }
        }
      }
    },
    "Round and push forward, never closing" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستديران وتُدفعان إلى الأمام من غير انطباق"
          }
        }
      }
    },
    "Round the lips but keep it short, nearer the vowel in 'put' than the one in 'boot'." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استدر بالشفتين واقصر المقدار، فهي إلى الضمة القصيرة أقرب منها إلى الواو الممدودة."
          }
        }
      }
    },
    "Round the lips on the doubled noon with no sound added, or sound about two thirds of the dropped damma." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضمّ شفتيك على النون المشدّدة من غير أن تزيد صوتًا، أو انطق ثلث الضمّة المحذوفة."
          }
        }
      }
    },
    "Round the lips, push them forward, and leave them open." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استدر بالشفتين وانضمهما إلى الأمام ودعهما منفرجتين."
          }
        }
      }
    },
    "Rounded zero one ayah later: this alif is never sounded, stopping or joining." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصفر المستدير بعدها بآية واحدة: هذه الألف لا تُنطق أبدًا، لا وقفًا ولا وصلًا."
          }
        }
      }
    },
    "Rounded zero: never sounded. Upright zero: sounded only when you stop." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصفر المستدير: لا يُنطق أبدًا. والصفر القائم: لا يُنطق إلا في الوقف."
          }
        }
      }
    },
    "Rounding the lips on a heavy letter that carries a kasrah, so قِيلَ leans toward a damma." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضم الشفتين مع الحرف المفخم المكسور، فتميل قِيلَ نحو الضمة."
          }
        }
      }
    },
