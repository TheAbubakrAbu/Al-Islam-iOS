            "value" : "تیس سورتیں"
          }
        }
      }
    },
    "Thirty ayahs that intercede for their reader until he is forgiven: Tabarak alladhi biyadihil-mulk." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثلاثون آية شفعت لصاحبها حتى غُفر له: تبارك الذي بيده الملك."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تیس آیات جو اپنے پڑھنے والے کی سفارش کرتی ہیں یہاں تک کہ اس کی مغفرت ہو جائے: «تبارك الذي بيده الملك»۔"
          }
        }
