    },
    "Add a Verse to the Last Call" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إضافة آية إلى التذكير الأخير"
          }
        }
      }
    },
    "Add a puff of air after the ق" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أن تزيد نَفَسا بعد القاف"
          }
        }
      }
    },
    "Add a reminder" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
