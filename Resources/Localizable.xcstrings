    },
    "You can re-enable Last Listened Surah later in Quran Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك إعادة تفعيل «آخر سورة استمعت إليها» لاحقًا من إعدادات القرآن."
          }
