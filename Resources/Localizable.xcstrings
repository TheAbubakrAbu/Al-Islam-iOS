          "stringUnit" : {
            "state" : "translated",
            "value" : "کیونکہ یہ آیت کے شروع میں ہے"
          }
        }
      }
    },
    "Because it is followed by a tanween" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لأنّ بعدها تنوينًا"
          }
