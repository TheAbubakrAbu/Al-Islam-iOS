        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وہ روایت جس کا مطبوعہ مصحف مغربی رسم الخط میں ہے۔"
          }
        }
      },
      "extractionState" : "stale"
    },
    "The narration, its narrator line and its Arabic" : {
      "localizations" : {
        "ar" : {
