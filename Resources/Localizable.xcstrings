    "6 letters -> idh-har, 6 -> idgham, 1 -> iqlab, 15 -> ikhfa. That is all 28." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستة أحرف للإظهار، وستة للإدغام، وواحد للإقلاب، وخمسة عشر للإخفاء. وهي الثمانية والعشرون كلها."
          }
        },
        "ur" : {
