    "Tiny Madd Marks" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "علامات المد الصغيرة"
          }
        }
      }
    },
    "Tiny madd marks such as small alif, small waw, and small ya indicate a natural two-count vowel sound written as miniature tashkeel." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "علامات المد الصغيرة، كالألف الصغيرة والواو الصغيرة والياء الصغيرة، تدل على مد طبيعي بحركتين يُكتب تشكيلًا صغيرًا."
          }
        }
      }
    },
    "Tiny natural elongation marks" : {
