        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جب نون کی آواز (ن یا تنوین) باریک حروف سے پہلے آئے: ت، ث، ج، د، ذ، ز، س، ش، ف، ك"
          }
