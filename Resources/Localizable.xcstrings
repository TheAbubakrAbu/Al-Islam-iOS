    },
    "Sakin after a fatha, as in خَوۡف and قُرَيۡش" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساكنة بعد فتحة كما في خَوۡف و قُرَيۡش"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زبر کے بعد ساکن، جیسے خَوۡف اور قُرَيۡش"
          }
        }
      }
    },
    "Sakin letters are rare, so they are worth singling out" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لأن الحروف الساكنة قليلة فاستحقت الإفراد بالذكر"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساکن حروف کم ہوتے ہیں، اس لیے انہیں الگ سے بیان کرنا مناسب ہے"
          }
        }
      }
    },
    "Sakin letters only ever occur at the end of a word" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لأن الحروف الساكنة لا تقع إلا في آخر الكلمة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساکن حروف صرف کلمے کے آخر میں آتے ہیں"
          }
        }
      }
    },
    "Sakin muzhar, clear" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الساكن المظهر"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساکن مظہر، ظاہر"
          }
        }
      }
    },
    "Sakin ra after an original kasrah, with nothing after it to pull it back. Light." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راء ساكنة بعد كسرة أصلية وليس بعدها ما يردها. ترقيق."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اصلی زیر کے بعد راء ساکن، اور بعد میں ایسا کچھ نہیں جو اسے واپس کھینچے۔ ترقیق۔"
          }
        }
      }
    },
    "Sakin ra with a damma on the ق before it. Heavy, and the ق is heavy on its own account too." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راء ساكنة وقبلها قاف مضمومة. تفخيم، والقاف مفخمة لذاتها أيضًا."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راء ساکن ہے اور اس سے پہلے ق پر پیش ہے۔ تفخیم، اور ق خود بھی مفخم ہے۔"
          }
        }
      }
    },
    "Sakin ra with a fatha on the م before it. Heavy." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راء ساكنة وقبلها ميم مفتوحة. تفخيم."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راء ساکن ہے اور اس سے پہلے م پر زبر ہے۔ تفخیم۔"
          }
        }
      }
    },
    "Sakin ra. Now the vowel before it decides instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راء ساكنة. فالحركة التي قبلها هي الفيصل الآن."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راء ساکن۔ اب فیصلہ اس سے پہلے والی حرکت کرتی ہے۔"
          }
        }
