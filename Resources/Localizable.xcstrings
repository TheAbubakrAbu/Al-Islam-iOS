            "value" : "سادہ قاعدہ: حرف لکھا ہوا ہے، مگر پڑھا کبھی نہیں جاتا۔"
          }
        }
      }
    },
    "Simple rule: Third letter ḍammah → start with 'u'; otherwise start with 'i'." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قاعدة مختصرة: الحرف الثالث مضموم ← ابدأ بالضمّ، وما سوى ذلك ← ابدأ بالكسر."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سادہ قاعدہ: تیسرے حرف پر پیش ہو ← پیش سے ابتدا کریں، ورنہ ← زیر سے ابتدا کریں۔"
          }
        }
      }
    },
    "Simple until you ask for more" : {
