    },
    "Ayahs Will Use Minshawi (Murattal)" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُشغَّل الآيات بصوت المنشاوي (مرتّل)"
