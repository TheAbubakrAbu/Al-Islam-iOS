    "Damma" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضمّة"
          }
        }
      }
    },
    "Damma into a small waw, kasra into a small ya. Two counts each." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضمّة إلى واو صغيرة، وكسرة إلى ياء صغيرة. حركتان في كلٍّ منهما."
          }
        }
      }
    },
    "Damma on the ل and the ه: wa rasuluhu. Kasras there attach the disavowal to the Messenger himself." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضم اللام والهاء: ورسولُهُ. والكسر فيهما يعلّق البراءة بالرسول نفسه."
          }
        }
      }
    },
    "Damma, kasra, kasra. Count to the third letter each time." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضمّ ثم كسر ثم كسر. عُدّ إلى الحرف الثالث في كل مرة."
          }
        }
      }
    },
    "Damma, then kasra, then fatha, on the very same three letters." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضمة ثم كسرة ثم فتحة، على الأحرف الثلاثة نفسها."
          }
        }
      }
    },
    "Damma- and kasra-tanween go silent; fatha-tanween becomes a 2-count alif." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنوين الضمّ وتنوين الكسر يسقطان، وتنوين الفتح يصير ألفًا بمقدار حركتين."
          }
        }
      }
    },
    "Damma-tanween before ء. The hidden noon of the tanween stays fully audible." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنوين ضم قبل الهمزة. ونون التنوين المقدرة تبقى مسموعة تامة."
          }
        }
      }
    },
    "Damma-tanween before ب, in a three-word ayah you can repeat easily." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنوين ضم قبل الباء في آية من ثلاث كلمات يسهل ترديدها."
          }
        }
      }
    },
    "Damma-tanween only" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنوين الضمّ وحده"
