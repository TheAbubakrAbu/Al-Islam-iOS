      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العربية تفرّق بين الكلمات بمقادير المد. وحرف المد إذا أُعطي حركة واحدة لم يبق حرف مد."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عربی میں کلمات کا فرق مد کی مقدار سے ہوتا ہے۔ جس حرفِ مد کو ایک حرکت دی جائے وہ حرفِ مد نہیں رہا۔"
