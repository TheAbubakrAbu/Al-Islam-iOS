    "Like the n in “noon”." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كصوت n في “noon”."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جیسے “noon” میں n کی آواز۔"
          }
        }
      }
    },
    "Like the previous rule, this one only operates across two words. And like the previous rule, the mushaf tells you it is happening: no sukoon on the noon, a shadda on the ل or ر." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وهذا الحكم كسابقه لا يجري إلا بين كلمتين. وهو كسابقه أيضًا مبيَّن في المصحف: لا سكون على النون، وشدة على اللام أو الراء."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پچھلے حکم کی طرح یہ حکم بھی صرف دو کلموں کے درمیان جاری ہوتا ہے۔ اور پچھلے حکم ہی کی طرح مصحف آپ کو بتا دیتا ہے کہ یہ ہو رہا ہے: نون پر سکون نہیں، اور ل یا ر پر تشدید ہے۔"
          }
        }
      }
    },
    "Like the s in “sun”." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كصوت s في “sun”."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جیسے “sun” میں s کی آواز۔"
          }
        }
