          }
        }
      }
    },
    "Selectable text for Ibn Amir, Hamzah, al-Kisai, Abu Jafar, Yaqub and Khalaf al-Ashir. Their printed mushafs are exact and always available in page mode; only this machine-extracted text is beta." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نص قابل للتحديد لقراءات ابن عامر وحمزة والكسائي وأبي جعفر ويعقوب وخلف العاشر. مصاحفها المطبوعة دقيقة ومتاحة دائمًا في وضع المصحف؛ وهذا النص المستخرج آليًا وحده تجريبي."
          }
        }
      }
    },
    "Selected Reciter" : {
