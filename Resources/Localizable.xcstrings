            "value" : "كبير: الباء قبل الياء، فافترض كسرة: «بِي»"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بڑا: با کے بعد یا ہے، اس لیے زیر فرض کریں: «بِی»"
          }
        }
      }
    },
    "Blind Following" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
