    "Safir four times over. Every ز whistles through the same narrow channel, with the voice on." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صفير أربع مرات. كل زاي منها تصفر في المجرى الضيق نفسه مع الجهر."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صفیر چار بار۔ ہر ز اسی ایک تنگ مجریٰ سے جہر کے ساتھ سیٹی کی سی آواز میں نکلتا ہے۔"
          }
        }
      }
    },
    "Safir: the whistle" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصفير: صوت حاد يشبه الصفير"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صفیر: سیٹی کی سی آواز"
          }
        }
      }
    },
    "Safir: ص س ز whistle through a narrow channel at the front teeth." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الصفير: الصاد والسين والزاي تصفر في مجرى ضيق عند الثنايا."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صفیر: ص س ز سامنے کے دانتوں کے پاس ایک تنگ مجریٰ سے سیٹی کی سی آواز کے ساتھ نکلتے ہیں۔"
          }
        }
      }
    },
