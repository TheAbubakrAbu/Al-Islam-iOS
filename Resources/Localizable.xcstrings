        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر نماز سے پہلے، اور پھر نماز پڑھ لینے تک ہر 15 منٹ بعد یاد دہانی کے لیے نماز کی اطلاعات یا بار بار یاد دہانی کا موڈ آن کریں۔"
          }
        }
      }
    },
    "Turn on tajweed colors in Quran Settings to see the rules on each word." : {
