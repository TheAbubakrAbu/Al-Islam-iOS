    "Smart Ayah Matching" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المطابقة الذكية للآيات"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آیات کی اسمارٹ مطابقت"
          }
        }
      }
    },
    "Smart Ayah Matching: these words sit at ayah %lld in this riwayah (ayah numbering differs between riwayat), so that ayah is shared." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المطابقة الذكية للآيات: تقع هذه الكلمات في الآية %lld في هذه الرواية (يختلف ترقيم الآيات بين الروايات)، لذا تُشارَك تلك الآية."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آیات کی ذہین مماثلت: اس روایت میں یہ الفاظ آیت %lld میں ہیں (روایات میں آیات کی گنتی مختلف ہے)، اس لیے وہی آیت شیئر کی جاتی ہے۔"
          }
        }
      }
    },
    "Smart Comparison" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المقارنة الذكية"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمارٹ موازنہ"
          }
        }
      }
    },
    "Smart Comparison is off: each row shows that riwayah's ayah under this exact NUMBER, with no word alignment. Where numbering differs, rows may show different words. Turn it on to align every row to the same words." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المقارنة الذكية متوقفة: يعرض كل صف آية تلك الرواية تحت هذا الرقم بعينه، دون محاذاة للكلمات. وحيث يختلف الترقيم، قد تعرض الصفوف كلمات مختلفة. شغّلها لمحاذاة كل الصفوف على الكلمات نفسها."
          }
        }
      },
      "extractionState" : "stale"
    },
    "Smart Comparison is off: each row shows that riwayah's ayah under this exact number, so rows may show different words where the numbering differs." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المقارنة الذكية متوقفة: يعرض كل صف آية تلك الرواية تحت هذا الرقم بعينه، فقد تعرض الصفوف كلمات مختلفة حيث يختلف الترقيم."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمارٹ موازنہ آف ہے: ہر قطار اسی نمبر کے تحت اس روایت کی آیت دکھاتی ہے، اس لیے جہاں شمار مختلف ہو وہاں قطاروں میں مختلف الفاظ آ سکتے ہیں۔"
          }
        }
      }
    },
