      }
    },
    "Business stock is valued at what you would sell it for today, not what you paid." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُقوَّم عروض التجارة بسعر بيعها اليوم، لا بسعر شرائها."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تجارتی مال کی قیمت آج کی قیمتِ فروخت پر لگائی جاتی ہے، نہ کہ قیمتِ خرید پر۔"
          }
        }
      }
    },
    "Buying, selling, honesty, and rights" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البيع والشراء والصدق والحقوق"
          }
        },
