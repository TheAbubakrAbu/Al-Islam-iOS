            "state" : "translated",
            "value" : "لا، لأنّ مَا حرفان فقط"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نہیں، کیونکہ مَا صرف دو حروف کا ہے"
          }
        }
      }
    },
    "No, not (2:2): the shape on its own" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
