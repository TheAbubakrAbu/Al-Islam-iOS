            "value" : "مد اللين"
          }
        }
      }
    },
    "Madd arid is 2, 4 or 6 counts. Pick one and stay with it." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المدّ العارض للسكون حركتان أو أربع أو ستّ. فاختر واحدًا والزمه."
          }
        }
      }
    },
    "Madd at word end before next hamzah." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مد في آخر الكلمة قبل همزة في أول الكلمة التالية."
          }
        }
      }
    },
    "Madd is 2 counts" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المد حركتان"
          }
        }
      }
    },
    "Madd is 2 or 6 counts" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المد ٢ أو ٦ حركات"
          }
        }
      }
    },
    "Madd is 2, 4, or 6 counts" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المد ٢ أو ٤ أو ٦ حركات"
          }
        }
