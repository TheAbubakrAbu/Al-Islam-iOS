    "%@ Hidden now on the %@ tab." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ هذه الأسئلة مخفية الآن في تبويب %@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ یہ سوالات اب %@ ٹیب پر چھپے ہوئے ہیں۔"
          }
        }
      }
    },
    "%@ Hidden now on the %@ tabs." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ هذه الأسئلة مخفية الآن في تبويبات %@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ یہ سوالات اب %@ ٹیبز پر چھپے ہوئے ہیں۔"
          }
        }
      }
    },
    "%@ It can feel like a lot at first. Browse the Tips & Tricks whenever you like, or start with Simple Mode and bring the extras in when you want them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ قد يبدو ذلك كثيرًا في البداية. تصفّح «النصائح والحيل» متى شئت، أو ابدأ بالوضع المبسّط وأضف الإضافات حين تريدها."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ شروع میں یہ بہت زیادہ لگ سکتا ہے۔ جب چاہیں “تجاویز اور ترکیبیں” دیکھیں، یا سادہ موڈ سے شروع کریں اور اضافی چیزیں تب لائیں جب آپ چاہیں۔"
          }
        }
      }
    },
    "%@ On the Quran tab, holding it opens the Quran Planner. A single tap still opens the whole menu." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ وفي تبويب القرآن، يفتح الضغط المطوّل عليها مخطِّط القرآن. ولا تزال الضغطة الواحدة تفتح القائمة كاملة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ قرآن ٹیب پر اسے دبائے رکھنے سے قرآن پلانر کھلتا ہے۔ ایک بار ٹیپ کرنے سے اب بھی پورا مینو کھلتا ہے۔"
          }
        }
      }
    },
