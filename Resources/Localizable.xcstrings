    },
    "%@ does things no other app does, like %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقدّم تطبيق %@ ما لا يقدّمه أي تطبيق آخر، مثل %@."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ایپ وہ کام کرتی ہے جو کوئی اور ایپ نہیں کرتی، جیسے %@۔"
          }
        }
      }
    },
    "%@ does things no other app does." : {
