          "stringUnit" : {
            "state" : "translated",
            "value" : "ب مجہور ہے، اس لیے سانس رک جاتی ہے۔ آخری ت مہموس ہے، اس لیے اس کے ساتھ ہوا کی ایک پھونک نکلتی ہے۔"
          }
        }
