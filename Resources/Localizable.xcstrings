          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نون غنّہ کے پیچھے چھپا ہوا ہے۔ اسے ظاہر کر کے پڑھنے سے ہر حرف سلامت رہتا ہے، پھر بھی ایک حق رہ جاتا ہے۔"
