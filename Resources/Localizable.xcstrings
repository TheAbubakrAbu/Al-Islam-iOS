    "About %lld ayahs (~%lld pages) a day to finish by %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نحو %lld آية يوميًا (قرابة %lld صفحة) لتختم بحلول %@."
