          "stringUnit" : {
            "state" : "translated",
            "value" : "من الأيام البيض: صيام الثالث عشر والرابع عشر والخامس عشر من الشهر سنة (سنن الترمذي ٧٦١، حسن صحيح عند الألباني)."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ایامِ بیض کا دن: مہینے کی 13، 14 اور 15 تاریخ کا روزہ سنت ہے (سنن ترمذی 761، البانی کے نزدیک حسن صحیح)۔"
          }
        }
      }
    },
    "A Year Recorded" : {
      "localizations" : {
