    "Ten Quran words or phrases a round, in the mushaf's hand." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عشر كلمات أو عبارات قرآنية في كل جولة، بخط المصحف."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہر راؤنڈ میں قرآن مجید کے دس الفاظ یا عبارتیں، مصحف کے خط میں۔"
          }
        }
