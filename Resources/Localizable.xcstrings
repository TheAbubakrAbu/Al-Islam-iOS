    "Share Hadith" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشاركة الحديث"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدیث شیئر کریں"
          }
        }
      }
    },
    "Share Hadith builds an image or plain text, and lets you choose which of the reference, the Arabic, and the English go in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينشئ «مشاركة الحديث» صورة أو نصًا عاديًا، ويتيح لك اختيار ما يُضمَّن من المرجع والعربية والإنجليزية."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«حدیث شیئر کریں» ایک تصویر یا سادہ متن بناتا ہے، اور آپ چن سکتے ہیں کہ حوالہ، عربی متن اور انگریزی ترجمہ میں سے کیا کیا شامل ہو۔"
          }
        }
      }
    },
