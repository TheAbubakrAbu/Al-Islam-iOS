    "Trigger: a shaddah on نّ or مّ. Nothing else is required or checked." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السبب: شدّة على نون أو ميم. ولا يُشترط سواه ولا يُنظر في غيره."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سبب: نّ یا مّ پر تشدید۔ اس کے سوا نہ کچھ شرط ہے نہ کچھ دیکھا جاتا ہے۔"
          }
        }
      }
    },
    "Trigger: madd letter ending a word, hamzat qat' beginning the next." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السبب: حرف مدٍّ في نهاية الكلمة، وهمزة قطع في أوّل التي بعدها."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سبب: کلمے کے آخر میں حرفِ مد، اور اگلے کلمے کے شروع میں ہمزۃ القطع۔"
          }
        }
      }
    },
    "Trigger: madd letter then hamzah, inside a single word." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السبب: حرف مدٍّ ثمّ همزة في كلمة واحدة."
