          }
        }
      }
    },
    "Up to %lld profiles. Each device backs up to its own; restoring another profile's things onto this %@ never changes that profile. Tap a profile for its options; every restore shows what changes first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حتى %lld من الملفات الشخصية. ينسخ كل جهاز إلى ملفه الخاص؛ واستعادة محتوى ملف شخصي آخر إلى هذا الـ %@ لا تغيّر ذلك الملف أبدًا. اضغط على ملف شخصي لعرض خياراته؛ وتعرض كل استعادة ما سيتغيّر قبل تنفيذها."
          }
        }
      }
    },
    "Up to %lld reminders a day, none for a prayer once you mark it." : {
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تذكير واحد يوميًا على الأكثر، ولا تذكير لصلاة بعد تسجيلها."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "تذكيران يوميًا على الأكثر، ولا تذكير لصلاة بعد تسجيلها."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "ما يصل إلى %lld تذكيرات يوميًا، ولا تذكير لصلاة بعد تسجيلها."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "ما يصل إلى %lld تذكيرًا يوميًا، ولا تذكير لصلاة بعد تسجيلها."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "ما يصل إلى %lld تذكير يوميًا، ولا تذكير لصلاة بعد تسجيلها."
                }
              }
            }
          }
        }
      }
    },
    "Up to %lld themes can be lit at once, each in its own color, in the list and page readers. Put them out here or at the top of Browse by Theme." : {},
    "Up to %lld themes can be lit at once, each in the color of what it speaks about, in the list and page readers. Put them out here, at the top of Browse by Theme, or under Highlight Themes, which also says what every color means." : {
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "يمكن إضاءة موضوع واحد في كل مرة، بلون ما يتحدث عنه، في وضع القائمة ووضع المصحف. أطفئه من هنا، أو من أعلى «تصفّح حسب الموضوع»، أو من «تمييز الموضوعات» الذي يبيّن أيضًا معنى كل لون."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "يمكن إضاءة موضوعين معًا، كلٌّ بلون ما يتحدث عنه، في وضع القائمة ووضع المصحف. أطفئهما من هنا، أو من أعلى «تصفّح حسب الموضوع»، أو من «تمييز الموضوعات» الذي يبيّن أيضًا معنى كل لون."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "يمكن إضاءة ما يصل إلى %lld مواضيع معًا، كلٌّ بلون ما يتحدث عنه، في وضع القائمة ووضع المصحف. أطفئها من هنا، أو من أعلى «تصفّح حسب الموضوع»، أو من «تمييز الموضوعات» الذي يبيّن أيضًا معنى كل لون."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "يمكن إضاءة ما يصل إلى %lld موضوعًا معًا، كلٌّ بلون ما يتحدث عنه، في وضع القائمة ووضع المصحف. أطفئها من هنا، أو من أعلى «تصفّح حسب الموضوع»، أو من «تمييز الموضوعات» الذي يبيّن أيضًا معنى كل لون."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "يمكن إضاءة ما يصل إلى %lld موضوع معًا، كلٌّ بلون ما يتحدث عنه، في وضع القائمة ووضع المصحف. أطفئها من هنا، أو من أعلى «تصفّح حسب الموضوع»، أو من «تمييز الموضوعات» الذي يبيّن أيضًا معنى كل لون."
                }
              }
            }
