            "state" : "translated",
            "value" : "من أين جاء اسم البدل؟"
          }
        }
      }
    },
    "Where each is made" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مخرج كل منهما"
          }
        }
      }
    },
    "Where each letter comes from and what it does once it leaves." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من أين يخرج كل حرف، وما الذي يعرض له بعد خروجه."
          }
        }
      }
    },
    "Where each letter is made" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مخرج كل حرف"
          }
        }
      }
    },
    "Where each letter is made: the throat, the tongue, the lips" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مخرج كل حرف: الحلق، واللسان، والشفتان"
          }
        }
      }
    },
    "Where in the mouth or throat is the letter made?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من أين يخرج الحرف في الفم أو الحلق؟"
          }
        }
      }
    },
    "Where is ghunnah produced?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "من أين تخرج الغنّة؟"
          }
        }
      }
    },
    "Where is the vowel heard in بِ?" : {
      "extractionState" : "manual",
      "localizations" : {
