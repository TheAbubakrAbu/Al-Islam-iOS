    "Son's sons and son's daughters inherit only when there is no surviving son." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يرث أبناء الابن وبنات الابن إلا إذا لم يكن ثمة ابن حي."
          }
        }
