        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ سے کہا گیا کہ آپ کا ع ہمزہ سنائی دیتا ہے۔ خرابی کہاں ہے؟"
          }
        }
      }
    },
    "You are traveling, so prayers are shortened and combined." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
