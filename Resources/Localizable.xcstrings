          }
        }
      }
    },
    "What happens to a noon sakinah or tanween when this letter follows it?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما حكم النون الساكنة أو التنوين إذا جاء بعدهما هذا الحرف؟"
