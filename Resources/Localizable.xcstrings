    },
    "You take the separated madd at four counts on the first line of a page. What now?" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مددت المنفصل أربع حركات في أول سطر من الصفحة. فماذا بعد؟"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ نے صفحے کی پہلی سطر میں مدِ منفصل کو چار حرکات کھینچا۔ اب کیا؟"
          }
        }
      }
    },
    "You went through all %lld of %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أتممت أدعية «%2$@» كلها، وعددها %1$lld."
