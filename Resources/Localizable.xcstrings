            "value" : "عربی اور انگریزی، یا ان میں سے ایک"
          }
        }
      }
    },
    "Arabic and English, reading view" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "العربية والإنجليزية، عرض القراءة"
          }
        },
        "ur" : {
          "stringUnit" : {
