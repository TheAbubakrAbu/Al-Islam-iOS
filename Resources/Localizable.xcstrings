        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ط کا مخرج مدغم ہوتا ہے، اس کا اطباق نہیں۔ ان چار کلموں میں تشدید کا نہ ہونا رسم کی طرف سے یہ یاد دہانی ہے کہ ط کا کچھ حصہ باقی ہے۔"
          }
