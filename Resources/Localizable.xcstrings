    "Raf' (marfuu'): damma, the subject. \"The man came.\"" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرفع (مرفوع): الضمة، للفاعل. «جاء الرجلُ»."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفع (مرفوع): پیش، فاعل کے لیے۔ «آدمی آیا»۔"
