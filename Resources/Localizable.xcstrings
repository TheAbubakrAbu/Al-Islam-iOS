    },
    "Traveling mode automatically turned on at %@, away from %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شُغّل وضع السفر تلقائيًا في %@، بعيدًا عن %@"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سفر موڈ %@ میں خودکار طور پر آن ہو گیا، %@ سے دور"
          }
        }
      }
    },
    "Traveling mode is on. If you are traveling more than 48 mi from home, you can pray Qasr, where you shorten and combine prayers. %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضع السفر مفعّل. إذا كنت مسافرًا أكثر من ٤٨ ميلًا عن بيتك، فيمكنك أن تقصر الصلوات وتجمعها. %@"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سفر موڈ آن ہے۔ اگر آپ گھر سے 48 میل سے زیادہ دور سفر میں ہیں تو آپ قصر کر سکتے ہیں، یعنی نمازیں مختصر کر کے جمع کر سکتے ہیں۔ %@"
          }
        }
      }
    },
    "Traveling mode is set in the iPhone app." : {
