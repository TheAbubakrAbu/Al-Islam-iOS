    },
    "Usually counted as 17, though scholars divide them differently" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُعدّ في الغالب سبع عشرة، وإن اختلف العلماء في تقسيمها"
