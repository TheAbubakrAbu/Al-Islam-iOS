    "Damma" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضمّة"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش"
          }
        }
      }
    },
    "Damma into a small waw, kasra into a small ya. Two counts each." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضمّة إلى واو صغيرة، وكسرة إلى ياء صغيرة. حركتان في كلٍّ منهما."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش سے چھوٹی واو، زیر سے چھوٹی یاء۔ دونوں میں دو حرکات۔"
          }
        }
      }
    },
    "Damma on the ل and the ه: wa rasuluhu. Kasras there attach the disavowal to the Messenger himself." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضم اللام والهاء: ورسولُهُ. والكسر فيهما يعلّق البراءة بالرسول نفسه."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ل اور ه پر پیش: وَرَسُولُهُۥ۔ وہاں زیر پڑھنے سے براءت خود رسول سے جا لگتی ہے۔"
          }
        }
      }
    },
    "Damma, kasra, kasra. Count to the third letter each time." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضمّ ثم كسر ثم كسر. عُدّ إلى الحرف الثالث في كل مرة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیش، زیر، زیر۔ ہر بار تیسرے حرف تک گنیں۔"
          }
        }
      }
    },
    "Damma, then kasra, then fatha, on the very same three letters." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضمة ثم كسرة ثم فتحة، على الأحرف الثلاثة نفسها."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضمہ، پھر کسرہ، پھر فتحہ، انہی تین حروف پر۔"
          }
        }
      }
    },
    "Damma- and kasra-tanween go silent; fatha-tanween becomes a 2-count alif." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنوين الضمّ وتنوين الكسر يسقطان، وتنوين الفتح يصير ألفًا بمقدار حركتين."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنوینِ ضمہ اور تنوینِ کسرہ گر جاتی ہیں، اور تنوینِ فتحہ 2 حرکات کی الف بن جاتی ہے۔"
          }
        }
      }
    },
    "Damma-tanween before ء. The hidden noon of the tanween stays fully audible." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنوين ضم قبل الهمزة. ونون التنوين المقدرة تبقى مسموعة تامة."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ء سے پہلے تنوینِ ضمہ (دو پیش)۔ تنوین کا پوشیدہ نون پوری طرح سنائی دیتا رہے۔"
          }
        }
      }
    },
    "Damma-tanween before ب, in a three-word ayah you can repeat easily." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنوين ضم قبل الباء في آية من ثلاث كلمات يسهل ترديدها."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ب سے پہلے تنوینِ ضمہ (دو پیش)، ایسی آیت میں جو تین کلموں کی ہے اور آسانی سے دہرائی جا سکتی ہے۔"
          }
        }
      }
    },
    "Damma-tanween only" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنوين الضمّ وحده"
