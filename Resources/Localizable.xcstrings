        }
      }
    },
    "Read on, then stop on the same word. The first is a glide, the second is a held glide." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صِل ثمّ قِف على الكلمة نفسها. فالأولى انزلاق، والثانية انزلاق ممدود."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پہلے ملا کر پڑھیں، پھر اسی کلمے پر وقف کریں۔ پہلی بار آواز پھسل جاتی ہے، دوسری بار وہی پھسلتی آواز کھینچی جاتی ہے۔"
          }
        }
      }
    },
    "Read only the Arabic, or only the English." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اقرأ العربية وحدها، أو الإنجليزية وحدها."
