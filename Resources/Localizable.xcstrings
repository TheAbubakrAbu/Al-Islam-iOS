    "%lld quotations do not match any source the AI was given and are marked “wording not verified”: treat them as paraphrases at best." : {
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld اقتباس لا تطابق أي مصدر أُعطي للذكاء الاصطناعي، ووُسمت بـ«لم يُتحقق من اللفظ»: عاملها في أحسن الأحوال على أنها نقل بالمعنى."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "اقتباس واحد لا يطابق أي مصدر أُعطي للذكاء الاصطناعي، ووُسم بـ«لم يُتحقق من اللفظ»: عامله في أحسن الأحوال على أنه نقل بالمعنى."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "اقتباسان لا يطابقان أي مصدر أُعطي للذكاء الاصطناعي، ووُسما بـ«لم يُتحقق من اللفظ»: عاملهما في أحسن الأحوال على أنهما نقل بالمعنى."
                }
              },
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld اقتباسات لا تطابق أي مصدر أُعطي للذكاء الاصطناعي، ووُسمت بـ«لم يُتحقق من اللفظ»: عاملها في أحسن الأحوال على أنها نقل بالمعنى."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld اقتباسًا لا تطابق أي مصدر أُعطي للذكاء الاصطناعي، ووُسمت بـ«لم يُتحقق من اللفظ»: عاملها في أحسن الأحوال على أنها نقل بالمعنى."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld اقتباس لا تطابق أي مصدر أُعطي للذكاء الاصطناعي، ووُسمت بـ«لم يُتحقق من اللفظ»: عاملها في أحسن الأحوال على أنها نقل بالمعنى."
                }
              }
            }
          }
        },
        "ur" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "ایک اقتباس اے آئی کو دیے گئے کسی ماخذ سے مطابقت نہیں رکھتا اور اس پر “الفاظ کی تصدیق نہیں ہوئی” کا نشان لگایا گیا ہے: اسے زیادہ سے زیادہ مفہوم کا بیان سمجھیں۔"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld اقتباسات اے آئی کو دیے گئے کسی ماخذ سے مطابقت نہیں رکھتے اور ان پر “الفاظ کی تصدیق نہیں ہوئی” کا نشان لگایا گیا ہے: انہیں زیادہ سے زیادہ مفہوم کا بیان سمجھیں۔"
                }
              }
            }
          }
        }
      }
    },
