    "Islamic art and calligraphy for your phone. Press and hold any wallpaper to copy it or save it to Photos." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فن إسلامي وخط عربي لهاتفك. المس أي خلفية مطولًا لنسخها أو حفظها في الصور."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کے فون کے لیے اسلامی فن اور خطاطی۔ کسی بھی وال پیپر کو کاپی کرنے یا تصاویر میں محفوظ کرنے کے لیے اسے دبا کر رکھیں۔"
          }
        }
      }
    },
    "Islamic events are calculated using the Umm al-Qura Hijri method selected in app settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحسب المناسبات الإسلامية بطريقة أم القرى للتقويم الهجري المحددة في إعدادات التطبيق."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسلامی مواقع ایپ کی ترتیبات میں منتخب ہجری طریقے، ام القریٰ، کے مطابق شمار کیے جاتے ہیں۔"
          }
        }
      }
    },
